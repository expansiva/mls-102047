        {
          "value": "cartao",
          "title": "Cartão"
        },
        {
          "value": "pix",
          "title": "Pix"
        },
        {
          "value": "transferencia",
          "title": "Transferência"
        },
        {
          "value": "boleto",
          "title": "Boleto"
        }
      ],
      "description": "Forma utilizada pelo aluno para realizar o pagamento."
    }
