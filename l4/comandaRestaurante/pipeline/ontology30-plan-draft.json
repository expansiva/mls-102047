{
  "moduleName": "comandaRestaurante",
  "businessDomain": "Restaurant table tabs, menu item launches, and settlement payments.",
  "entities": [
    {
      "entityId": "Table",
      "title": "Restaurant table",
      "description": "A restaurant table that can be selected for a tab and whose availability reflects its current tab.",
      "kind": "mdm",
      "party": "none",
      "mdmSubtype": "AssetEquipment",
      "displayField": "name",
      "storage": {
        "target": "mdm",
        "scope": "organization",
        "idField": "id",
        "mdmType": "comandaRestaurante.Table"
      }
    },
    {
      "entityId": "MenuItem",
      "title": "Menu item",
      "description": "A menu offering available to be launched on a restaurant tab, including its module-specific current price.",
      "kind": "mdm",
      "party": "none",
      "mdmSubtype": "Product",
      "displayField": "name",
      "writer": "crud",
      "storage": {
        "target": "mdm",
        "scope": "organization",
        "idField": "id",
        "mdmType": "comandaRestaurante.MenuItem"
      }
    },
    {
      "entityId": "OrderTab",
      "title": "Table tab",
      "description": "The open-to-settled restaurant tab associated with one table.",
      "kind": "core",
      "party": "none",
      "displayField": "id",
      "storage": {
        "target": "moduleDatabase",
        "scope": "module",
        "idField": "id",
        "mdmType": "comandaRestaurante.OrderTab"
      }
    },
    {
      "entityId": "TabItem",
      "title": "Launched tab item",
      "description": "A menu item launched on a table tab with its quantity and optional preparation note.",
      "kind": "event",
      "party": "none",
      "displayField": "id",
      "storage": {
        "target": "moduleDatabase",
        "scope": "module",
        "idField": "id",
        "mdmType": "comandaRestaurante.TabItem"
      }
    },
    {
      "entityId": "Payment",
      "title": "Tab payment",
      "description": "The payment recorded to settle a restaurant table tab.",
      "kind": "event",
      "party": "none",
      "displayField": "id",
      "mutability": "appendOnly",
      "storage": {
        "target": "moduleDatabase",
        "scope": "module",
        "idField": "id",
        "mdmType": "comandaRestaurante.Payment"
      }
    }
  ],
  "relationships": [
    {
      "relationshipId": "tabUsesTable",
      "fromEntity": "OrderTab",
      "toEntity": "Table",
      "type": "manyToOne",
      "required": true,
      "description": "Each table tab is opened for one restaurant table.",
      "persistence": {
        "mode": "crossStoreReference"
      }
    },
    {
      "relationshipId": "tabHasItems",
      "fromEntity": "OrderTab",
      "toEntity": "TabItem",
      "type": "oneToMany",
      "required": false,
      "description": "A table tab contains the items launched on it.",
      "persistence": {
        "mode": "moduleReference"
      }
    },
    {
      "relationshipId": "itemUsesMenuItem",
      "fromEntity": "TabItem",
      "toEntity": "MenuItem",
      "type": "manyToOne",
      "required": true,
      "description": "Each launched tab item refers to one menu item.",
      "persistence": {
        "mode": "crossStoreReference"
      }
    },
    {
      "relationshipId": "tabHasPayment",
      "fromEntity": "OrderTab",
      "toEntity": "Payment",
      "type": "oneToOne",
      "required": false,
      "description": "A settled table tab has its recorded payment.",
      "persistence": {
        "mode": "moduleReference"
      }
    }
  ]
}
