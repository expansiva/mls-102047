      "class": "event",
      "storage": {
        "target": "moduleDatabase",
        "table": "compras_goodsreceipt",
        "kind": "relational"
      }
    },
    {
      "entityId": "PurchaseIndicators",
      "kind": "entity",
      "family": "ddm",
      "title": "Indicadores de compras",
