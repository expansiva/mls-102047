{
  "moduleName": "compras",
  "businessDomain": "Compras e recebimento de mercadorias",
  "entities": [
    {
      "entityId": "Supplier",
      "kind": "role",
      "family": "mdm",
      "title": "Fornecedor",
      "description": "Empresa fornecedora cadastrada ou vinculada ao cadastro mestre, identificada pelo CNPJ e utilizada nos pedidos de compra.",
      "displayField": "details.identification.name",
      "subtype": "Company",
      "roleTag": "compras.Supplier",
      "source": "/_102034_/l4/ontology/mdm.defs.ts"
    },
    {
      "entityId": "SupplierContact",
      "kind": "role",
      "family": "mdm",
      "title": "Contato do fornecedor",
      "description": "Canal de contato mestre vinculado ao fornecedor para a comunicação comercial.",
      "displayField": "details.contactChannel.value",
      "subtype": "ContactChannel",
      "roleTag": "compras.SupplierContact",
      "source": "/_102034_/l4/ontology/mdm.defs.ts"
    },
    {
      "entityId": "Buyer",
      "kind": "role",
      "family": "mdm",
      "title": "Comprador",
      "description": "Pessoa responsável pela criação dos pedidos de compra, usada para aplicar o escopo pessoal aos pedidos que abriu.",
      "displayField": "details.identification.name",
      "writer": "crud",
      "subtype": "Person",
      "roleTag": "compras.Buyer",
      "source": "/_102034_/l4/ontology/mdm.defs.ts"
    },
    {
      "entityId": "Product",
      "kind": "role",
      "family": "mdm",
      "title": "Produto",
      "description": "Produto mestre localizado para compor o catálogo de fornecedores, os pedidos de compra e os recebimentos.",
      "displayField": "details.identification.name",
      "writer": "crud",
      "subtype": "Product",
      "roleTag": "compras.Product",
      "source": "/_102034_/l4/ontology/mdm.defs.ts"
    },
    {
      "entityId": "SupplierProduct",
      "kind": "entity",
      "family": "tdm",
      "title": "Produto do fornecedor",
      "description": "Item do catálogo comercial de um fornecedor, com o preço combinado para um produto mestre.",
      "displayField": "details.description",
      "class": "supporting",
      "storage": {
        "target": "moduleDatabase",
        "table": "compras_supplierproduct",
        "kind": "relational"
      }
    },
    {
      "entityId": "PurchaseOrder",
      "kind": "entity",
      "family": "tdm",
      "title": "Pedido de compra",
