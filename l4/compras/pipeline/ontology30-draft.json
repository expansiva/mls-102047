        "toEntity": "ItemRecebimentoCompra",
        "type": "oneToMany",
        "required": true,
        "description": "O recebimento de compra registra as quantidades recebidas em seus itens.",
        "persistence": {
          "mode": "moduleReference"
        }
      },
      {
        "relationshipId": "itemPedidoPossuiRecebimentos",
