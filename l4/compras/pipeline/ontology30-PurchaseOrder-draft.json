{
  "entityId": "PurchaseOrder",
  "fields": [
    {
      "fieldId": "id",
      "title": "Identificador",
      "type": "uuid",
      "required": true,
      "description": "Identificador único do pedido de compra."
    },
    {
      "fieldId": "orderNumber",
      "title": "Número do pedido",
      "type": "string",
      "required": true,
      "unique": true,
      "description": "Número sequencial que identifica o pedido de compra."
    },
    {
      "fieldId": "supplierId",
      "title": "Fornecedor",
      "type": "uuid",
      "required": true,
      "description": "Referência ao fornecedor para o qual o pedido foi emitido."
    },
    {
      "fieldId": "expectedDeliveryDate",
      "title": "Data prevista de entrega",
      "type": "date",
      "required": true,
      "description": "Data prevista para a entrega dos itens do pedido."
    },
    {
      "fieldId": "status",
      "title": "Situação",
      "type": "string",
      "required": true,
      "enum": [
        {
          "value": "draft",
          "title": "Rascunho"
        },
        {
          "value": "sent",
          "title": "Enviado"
        },
        {
          "value": "pendingApproval",
          "title": "Aguardando aprovação"
        },
        {
          "value": "approved",
          "title": "Aprovado"
        },
        {
          "value": "rejected",
          "title": "Rejeitado"
        },
        {
          "value": "partiallyReceived",
          "title": "Recebido parcialmente"
        },
        {
          "value": "received",
          "title": "Recebido"
        }
      ],
      "description": "Situação atual do pedido no fluxo de envio, aprovação e recebimento."
    }
  ],
  "details": {
    "totalAmount": {
      "type": "money",
      "description": "Valor total calculado pela soma das quantidades e preços dos itens do pedido."
    },
    "receivedAmount": {
      "type": "money",
      "description": "Valor total calculado dos itens já recebidos no pedido."
    },
    "outstandingAmount": {
      "type": "money",
      "description": "Valor calculado dos itens ainda pendentes de recebimento."
    },
    "isOverdue": {
      "type": "boolean",
      "description": "Indica se o pedido permanece pendente após a data prevista de entrega."
    }
  },
  "lifecycleStates": [
    {
      "state": "draft",
      "reachedBy": "actor"
    },
    {
      "state": "sent",
      "reachedBy": "actor"
    },
    {
      "state": "pendingApproval",
      "reachedBy": "command"
    },
    {
      "state": "approved",
      "reachedBy": "actor"
    },
    {
      "state": "rejected",
      "reachedBy": "actor"
    },
    {
      "state": "partiallyReceived",
      "reachedBy": "actor"
    },
    {
      "state": "received",
      "reachedBy": "actor"
    }
  ],
  "transitions": [
    {
      "transitionId": "sendPurchaseOrder",
      "from": [
        "draft"
      ],
      "to": "sent",
      "by": [
        "comprador"
      ],
      "description": "Envia o pedido de compra ao fornecedor quando não requer aprovação gerencial."
    },
    {
      "transitionId": "routeForApproval",
      "from": [
        "draft"
      ],
      "to": "pendingApproval",
      "by": "system",
      "description": "Encaminha o pedido para aprovação gerencial quando seu valor exige decisão."
    },
    {
      "transitionId": "approvePurchaseOrder",
      "from": [
        "pendingApproval"
      ],
      "to": "approved",
      "by": [
        "gerenteCompras"
      ],
      "description": "Aprova o pedido encaminhado para decisão gerencial."
    },
    {
      "transitionId": "rejectPurchaseOrder",
      "from": [
        "pendingApproval"
      ],
      "to": "rejected",
      "by": [
        "gerenteCompras"
      ],
      "description": "Rejeita o pedido encaminhado para decisão gerencial."
    },
    {
      "transitionId": "registerPartialReceipt",
      "from": [
        "sent",
        "approved"
      ],
      "to": "partiallyReceived",
      "by": [
        "almoxarife"
      ],
      "description": "Registra o primeiro recebimento parcial dos itens do pedido."
    },
    {
      "transitionId": "completeReceipt",
      "from": [
        "sent",
        "approved",
        "partiallyReceived"
      ],
      "to": "received",
      "by": [
        "almoxarife"
      ],
      "description": "Registra o recebimento que completa todas as quantidades pedidas."
    }
  ]
}
