  "relationships": [
    {
      "relationshipId": "vehicleAssignmentVehicle",
      "from": "VehicleAssignment",
      "to": "Vehicle",
      "type": "manyToOne",
      "required": true,
      "mode": "fk",
      "description": "Cada atribuição vincula obrigatoriamente um veículo da frota.",
