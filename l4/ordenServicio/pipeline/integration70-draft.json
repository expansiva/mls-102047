{
  "schemaVersion": "2026-09-12-ns5-integration-v2",
  "moduleName": "ordenServicio",
  "inbound": [],
  "outbound": [
    {
      "id": "presupuestoEmitido",
      "kind": "event",
      "to": "any",
      "event": "presupuestoEmitido",
      "on": "OrdenServicio.emitirPresupuesto",
      "description": "Publica la orden cuando se emite el presupuesto para que otros módulos puedan reaccionar a su disponibilidad para el cliente.",
      "entityRefs": [
        "OrdenServicio"
      ]
    },
    {
      "id": "presupuestoResuelto",
      "kind": "event",
      "to": "any",
      "event": "presupuestoResuelto",
      "on": "OrdenServicio.resolverPresupuesto",
      "description": "Publica la decisión del cliente sobre el presupuesto, tanto si lo aprueba como si lo rechaza.",
      "entityRefs": [
        "OrdenServicio"
      ]
    },
    {
      "id": "reparacionListaParaEntrega",
      "kind": "event",
      "to": "any",
      "event": "reparacionListaParaEntrega",
      "on": "OrdenServicio.marcarListaParaEntrega",
      "description": "Publica que la reparación está terminada y el aparato está listo para su entrega.",
      "entityRefs": [
        "OrdenServicio"
      ]
    },
    {
      "id": "entregaFinalizada",
      "kind": "event",
      "to": "any",
      "event": "entregaFinalizada",
      "on": "OrdenServicio.finalizarEntrega",
      "description": "Publica que el aparato fue entregado al cliente y la orden fue finalizada.",
      "entityRefs": [
        "OrdenServicio"
      ]
    }
  ],
  "plugins": []
}
