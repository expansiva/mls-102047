              "value": "available",
              "title": "Disponível"
            },
            {
              "value": "rented",
              "title": "Locado"
            },
            {
              "value": "maintenance",
              "title": "Em manutenção"
            }
          ],
          "description": "Situação operacional atual do equipamento para locação ou manutenção."
