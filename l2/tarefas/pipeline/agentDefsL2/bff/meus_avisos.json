{
  "types": [
    {
      "name": "AvisoResumoDetails",
      "description": "Detalhes de um aviso diário: momentos de geração e finalização, motivo de falha e totais de tarefas.",
      "fields": [
        {
          "name": "geradoEm",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.details.geradoEm"
            ]
          }
        },
        {
          "name": "finalizadoEm",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.details.finalizadoEm"
            ]
          }
        },
        {
          "name": "motivoFalha",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.details.motivoFalha"
            ]
          }
        },
        {
          "name": "quantidadeTarefas",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.details.quantidadeTarefas"
            ]
          }
        },
        {
          "name": "quantidadeAtrasadas",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.details.quantidadeAtrasadas"
            ]
          }
        }
      ]
    },
    {
      "name": "AvisoResumo",
      "description": "Aviso diário de vencimentos de um responsável, com data de referência, situação do envio, totais e registro de geração e finalização.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.id"
            ]
          }
        },
        {
          "name": "dataReferencia",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.dataReferencia"
            ]
          }
        },
        {
          "name": "status",
          "type": "'pending' | 'completed' | 'failed'",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.status"
            ]
          }
        },
        {
          "name": "details",
          "type": "AvisoResumoDetails"
        }
      ]
    },
    {
      "name": "TarefaAvisoDetails",
      "description": "Indicadores atuais de prazo de uma tarefa aberta.",
      "fields": [
        {
          "name": "venceHoje",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Tarefa.details.venceHoje"
            ]
          }
        },
        {
          "name": "atrasada",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Tarefa.details.atrasada"
            ]
          }
        }
      ]
    },
    {
      "name": "TarefaAviso",
      "description": "Tarefa referenciada por um aviso, com título, situação e prazo atuais.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Tarefa.id"
            ]
          }
        },
        {
          "name": "titulo",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Tarefa.titulo"
            ]
          }
        },
        {
          "name": "status",
          "type": "'aFazer' | 'emAndamento' | 'emRevisao' | 'concluida' | 'cancelada'",
          "origin": {
            "kind": "field",
            "paths": [
              "Tarefa.status"
            ]
          }
        },
        {
          "name": "prazo",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Tarefa.prazo"
            ]
          }
        },
        {
          "name": "details",
          "type": "TarefaAvisoDetails"
        }
      ]
    },
    {
      "name": "AvisoLinhaTarefa",
      "description": "Linha de um aviso diário: tarefa incluída, prazo no momento da geração e situação do prazo naquele dia.",
      "fields": [
        {
          "name": "tarefaId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.details.tarefas.tarefaId"
            ]
          }
        },
        {
          "name": "prazo",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.details.tarefas.prazo"
            ]
          }
        },
        {
          "name": "situacaoPrazo",
          "type": "'dueToday' | 'overdue'",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.details.tarefas.situacaoPrazo"
            ]
          }
        },
        {
          "name": "tarefa",
          "type": "TarefaAviso"
        }
      ]
    },
    {
      "name": "AvisoDetalheDetails",
      "description": "Detalhes de um aviso diário com totais e linhas de tarefas.",
      "fields": [
        {
          "name": "quantidadeTarefas",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.details.quantidadeTarefas"
            ]
          }
        },
        {
          "name": "quantidadeAtrasadas",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.details.quantidadeAtrasadas"
            ]
          }
        },
        {
          "name": "tarefas",
          "type": "AvisoLinhaTarefa[]"
        }
      ]
    },
    {
      "name": "AvisoDetalhe",
      "description": "Aviso diário de vencimentos com seus totais e as tarefas que trouxe.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.id"
            ]
          }
        },
        {
          "name": "dataReferencia",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.dataReferencia"
            ]
          }
        },
        {
          "name": "status",
          "type": "'pending' | 'completed' | 'failed'",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.status"
            ]
          }
        },
        {
          "name": "details",
          "type": "AvisoDetalheDetails"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "qryPaginaMeusAvisos",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "avisos",
          "type": "AvisoResumo[]",
          "paginated": true
        },
        {
          "name": "avisoAtual",
          "type": "AvisoDetalhe",
          "optional": true
        }
      ],
      "rules": [
        "avisoUnicoPorResponsavelEDia",
        "avisoSomenteTarefasAbertasVencendo"
      ],
      "jsdoc": {
        "purpose": "Carrega a abertura da página de avisos: a primeira página dos avisos diários da pessoa logada e o aviso mais recente já completo com suas tarefas.",
        "input": "pageSize: tamanho da página de avisos (opcional, padrão do servidor). A pessoa logada não é enviada: o servidor a usa como responsável.",
        "processing": "Filtra AvisoVencimento pelo responsável da sessão, ordenado por dataReferencia decrescente, página 1 (no máximo um aviso por dia, avisoUnicoPorResponsavelEDia). quantidadeTarefas e quantidadeAtrasadas são calculadas a partir das linhas do aviso (total e linhas com situacaoPrazo overdue), nunca gravadas. Para o aviso mais recente compõe as linhas (tarefaId, prazo e situacaoPrazo do momento da geração, conforme avisoSomenteTarefasAbertasVencendo) com a Tarefa atual (titulo, status, prazo) e calcula venceHoje e atrasada da tarefa em relação à data de hoje.",
        "output": "avisos: página { items, page, pageSize, hasMore } de avisos com data, situação do envio, totais, geradoEm, finalizadoEm e motivoFalha. avisoAtual: o aviso mais recente com totais e linhas de tarefas; ausente se a pessoa ainda não recebeu aviso."
      }
    },
    {
      "id": "qryListarMeusAvisos",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "dataInicio",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.dataReferencia"
            ]
          }
        },
        {
          "name": "dataFim",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.dataReferencia"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "avisos",
          "type": "AvisoResumo[]",
          "paginated": true
        }
      ],
      "rules": [
        "avisoUnicoPorResponsavelEDia"
      ],
      "jsdoc": {
        "purpose": "Lista os avisos diários da pessoa logada num período, página a página.",
        "input": "dataInicio e dataFim: limites inclusivos da data de referência (opcionais); page e pageSize: página pedida e tamanho.",
        "processing": "Filtra AvisoVencimento pelo responsável da sessão e por dataReferencia entre dataInicio e dataFim, ordenado por dataReferencia decrescente (um aviso por dia, avisoUnicoPorResponsavelEDia). Calcula quantidadeTarefas e quantidadeAtrasadas a partir das linhas de cada aviso.",
        "output": "Página { items, page, pageSize, hasMore } de avisos com data, situação do envio, totais, geradoEm, finalizadoEm e motivoFalha."
      }
    },
    {
      "id": "qryAvisoPorId",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "AvisoVencimento.id"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "aviso",
          "type": "AvisoDetalhe"
        }
      ],
      "rules": [
        "avisoSomenteTarefasAbertasVencendo"
      ],
      "jsdoc": {
        "purpose": "Abre um aviso diário escolhido com seus totais e as tarefas que ele trouxe.",
        "input": "id: id do aviso escolhido.",
        "processing": "Lê o AvisoVencimento pelo id e recusa se o responsável não for a pessoa logada. Compõe cada linha (tarefaId, prazo e situacaoPrazo do momento da geração, que conforme avisoSomenteTarefasAbertasVencendo traz só tarefas abertas vencendo no dia ou atrasadas) com a Tarefa atual (titulo, status, prazo). Calcula quantidadeTarefas, quantidadeAtrasadas e, para cada tarefa, venceHoje e atrasada em relação a hoje; nada disso é gravado.",
        "output": "O aviso com data de referência, situação, totais e as linhas de tarefas com os dados atuais de cada tarefa."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "listaAvisos",
        "reads": "qryPaginaMeusAvisos.avisos"
      },
      {
        "organism": "avisoDoDia",
        "reads": "qryPaginaMeusAvisos.avisoAtual"
      },
      {
        "organism": "historicoAvisos",
        "reads": "qryPaginaMeusAvisos.avisos"
      }
    ],
    "commands": [],
    "selections": [
      {
        "organism": "listaAvisos",
        "via": {
          "query": "qryAvisoPorId"
        }
      }
    ],
    "journeys": [
      {
        "step": "avisoDiarioVencimentos/abrirAviso",
        "organisms": [
          "listaAvisos",
          "avisoDoDia"
        ],
        "endpoints": [
          "qryPaginaMeusAvisos",
          "qryAvisoPorId"
        ]
      },
      {
        "step": "avisoDiarioVencimentos/verVencendo",
        "organisms": [
          "avisoDoDia"
        ],
        "endpoints": [
          "qryAvisoPorId"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "qryListarMeusAvisos",
        "state": "qryPaginaMeusAvisos.avisos",
        "mode": "replace"
      },
      {
        "endpoint": "qryAvisoPorId",
        "state": "qryPaginaMeusAvisos.avisoAtual",
        "mode": "replace"
      }
    ]
  }
}
