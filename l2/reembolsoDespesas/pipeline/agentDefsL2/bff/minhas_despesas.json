{
  "types": [
    {
      "name": "DespesaResumoDetalhes",
      "description": "Dados da despesa mostrados em cada linha da lista.",
      "fields": [
        {
          "name": "details.dataDespesa",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.dataDespesa"
            ]
          }
        },
        {
          "name": "details.categoria",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.categoria"
            ]
          }
        },
        {
          "name": "details.valor",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.valor"
            ]
          }
        }
      ]
    },
    {
      "name": "DespesaResumo",
      "description": "Linha da lista de despesas do colaborador.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.id"
            ]
          }
        },
        {
          "name": "status",
          "type": "'draft' | 'awaitingApproval' | 'rejected' | 'approved' | 'paid'",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.status"
            ]
          }
        },
        {
          "name": "details",
          "type": "DespesaResumoDetalhes"
        }
      ]
    },
    {
      "name": "DespesaDetalheDetalhes",
      "description": "Dados completos da despesa aberta.",
      "fields": [
        {
          "name": "details.dataDespesa",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.dataDespesa"
            ]
          }
        },
        {
          "name": "details.categoria",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.categoria"
            ]
          }
        },
        {
          "name": "details.valor",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.valor"
            ]
          }
        },
        {
          "name": "details.descricao",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.descricao"
            ]
          }
        },
        {
          "name": "details.motivoRejeicao",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.motivoRejeicao"
            ]
          }
        },
        {
          "name": "details.reenvioRealizado",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.reenvioRealizado"
            ]
          }
        },
        {
          "name": "details.dataPagamento",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.dataPagamento"
            ]
          }
        }
      ]
    },
    {
      "name": "DespesaDetalhe",
      "description": "Despesa completa, usada no detalhe, no formulário de correção e nas ações de envio.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.version"
            ]
          }
        },
        {
          "name": "status",
          "type": "'draft' | 'awaitingApproval' | 'rejected' | 'approved' | 'paid'",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.status"
            ]
          }
        },
        {
          "name": "details",
          "type": "DespesaDetalheDetalhes"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "listarMinhasDespesas",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "status",
          "type": "'draft' | 'awaitingApproval' | 'rejected' | 'approved' | 'paid'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.status"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "despesas",
          "type": "DespesaResumo[]",
          "paginated": true
        }
      ],
      "rules": [
        "expenseOwnerOnly"
      ],
      "jsdoc": {
        "purpose": "Carrega, ao abrir a página, as despesas registradas pelo colaborador logado para que ele acompanhe a situação de cada uma e escolha qual abrir.",
        "input": "status: filtro opcional pela situação (por exemplo 'rejected' para localizar as despesas a corrigir); page e pageSize: página solicitada e tamanho da página.",
        "processing": "Filtra pelo colaboradorId da sessão (expenseOwnerOnly: o colaborador só vê despesas que registrou), aplica o filtro opcional de situação usando a coluna indexada e ordena pela data da despesa mais recente. Pagina o resultado.",
        "output": "Página { items, page, pageSize, hasMore } de despesas com id, situação, data, categoria e valor, exatamente o que a lista mostra."
      }
    },
    {
      "id": "obterDespesa",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.id"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "despesa",
          "type": "DespesaDetalhe"
        }
      ],
      "rules": [
        "expenseOwnerOnly"
      ],
      "jsdoc": {
        "purpose": "Abre a despesa escolhida na lista com todos os dados que o detalhe, o formulário de correção e as ações de envio precisam.",
        "input": "id: identificador da despesa selecionada na lista.",
        "processing": "Lê a despesa pelo id e recusa se o colaboradorId não for o do colaborador logado (expenseOwnerOnly). Inclui a referência do comprovante anexado quando houver.",
        "output": "A despesa com id, versão, situação, data, categoria, valor, descrição, motivo da rejeição, indicador de reenvio e data de pagamento; a versão é usada nos comandos seguintes."
      }
    },
    {
      "id": "registrarDespesa",
      "kind": "cmd",
      "when": "registrarDespesa",
      "writes": "Despesa.create",
      "input": [
        {
          "name": "colaboradorId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.colaboradorId"
            ]
          }
        },
        {
          "name": "details.dataDespesa",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.dataDespesa"
            ]
          }
        },
        {
          "name": "details.categoria",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.categoria"
            ]
          }
        },
        {
          "name": "details.valor",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.valor"
            ]
          }
        },
        {
          "name": "details.descricao",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.descricao"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "despesa",
          "type": "DespesaDetalhe"
        },
        {
          "name": "item",
          "type": "DespesaResumo"
        }
      ],
      "rules": [
        "validExpenseData"
      ],
      "jsdoc": {
        "purpose": "Registra uma nova despesa do colaborador em rascunho.",
        "input": "colaboradorId: colaborador logado, vindo da sessão; dataDespesa, categoria, valor e descricao: dados preenchidos no formulário.",
        "processing": "Valida que data, categoria, valor e descrição estão preenchidos (validExpenseData). Cria a despesa com situação 'draft' e reenvioRealizado falso, vinculada ao colaboradorId da sessão. O comprovante é anexado pela capacidade de anexo de documento.",
        "output": "A despesa criada completa, para abrir no detalhe com a ação de envio, e a linha resumida, para inserir na lista sem nova consulta."
      }
    },
    {
      "id": "salvarCorrecao",
      "kind": "cmd",
      "when": "salvarCorrecao",
      "writes": "Despesa.update",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.version"
            ]
          }
        },
        {
          "name": "details.dataDespesa",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.dataDespesa"
            ]
          }
        },
        {
          "name": "details.categoria",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.categoria"
            ]
          }
        },
        {
          "name": "details.valor",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.valor"
            ]
          }
        },
        {
          "name": "details.descricao",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.details.descricao"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "despesa",
          "type": "DespesaDetalhe"
        },
        {
          "name": "item",
          "type": "DespesaResumo"
        }
      ],
      "rules": [
        "expenseOwnerOnly",
        "validExpenseData",
        "singleResubmission"
      ],
      "jsdoc": {
        "purpose": "Salva a correção dos dados de uma despesa rejeitada antes do reenvio.",
        "input": "id e version: despesa corrigida e versão lida, para controle de concorrência; dataDespesa, categoria, valor e descricao: dados corrigidos.",
        "processing": "Recusa se a despesa não for do colaborador logado (expenseOwnerOnly), se não estiver 'rejected' ou se reenvioRealizado já for verdadeiro (singleResubmission: só se corrige e reenvia uma vez), ou se a versão divergir. Valida os dados obrigatórios (validExpenseData) e atualiza sem alterar o colaboradorId nem a situação.",
        "output": "A despesa atualizada completa, para redesenhar detalhe e formulário, e a linha resumida, para atualizar a lista no lugar."
      }
    },
    {
      "id": "enviarParaAprovacao",
      "kind": "cmd",
      "when": "enviarParaAprovacao",
      "writes": "Despesa.enviarParaAprovacao",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "despesa",
          "type": "DespesaDetalhe"
        },
        {
          "name": "item",
          "type": "DespesaResumo"
        }
      ],
      "rules": [
        "expenseOwnerOnly",
        "proofRequiredBeforeSubmission",
        "validExpenseData"
      ],
      "jsdoc": {
        "purpose": "Envia a despesa em rascunho para aprovação do gestor da equipe.",
        "input": "id e version: despesa a enviar e versão lida.",
        "processing": "Recusa se a despesa não for do colaborador logado (expenseOwnerOnly), se não estiver 'draft', se a versão divergir, se não houver comprovante anexado (proofRequiredBeforeSubmission) ou se faltar data, categoria, valor ou descrição (validExpenseData). Move a situação para 'awaitingApproval'.",
        "output": "A despesa com a nova situação, para redesenhar detalhe e ações, e a linha resumida para atualizar a lista."
      }
    },
    {
      "id": "reenviarParaAprovacao",
      "kind": "cmd",
      "when": "reenviarParaAprovacao",
      "writes": "Despesa.reenviarParaAprovacao",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Despesa.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "despesa",
          "type": "DespesaDetalhe"
        },
        {
          "name": "item",
          "type": "DespesaResumo"
        }
      ],
      "rules": [
        "expenseOwnerOnly",
        "singleResubmission",
        "proofRequiredBeforeSubmission",
        "validExpenseData"
      ],
      "jsdoc": {
        "purpose": "Reenvia, uma única vez, a despesa rejeitada e corrigida para nova análise do gestor.",
        "input": "id e version: despesa a reenviar e versão lida.",
        "processing": "Recusa se a despesa não for do colaborador logado (expenseOwnerOnly), se não estiver 'rejected', se reenvioRealizado já for verdadeiro (singleResubmission), se não houver comprovante (proofRequiredBeforeSubmission), se faltar dado obrigatório (validExpenseData) ou se a versão divergir. Move a situação para 'awaitingApproval' e marca reenvioRealizado como verdadeiro.",
        "output": "A despesa com a nova situação e o reenvio marcado, para redesenhar detalhe e ações, e a linha resumida para atualizar a lista."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "listaMinhasDespesas",
        "reads": "listarMinhasDespesas.despesas"
      },
      {
        "organism": "detalheDespesa",
        "reads": "obterDespesa.despesa"
      },
      {
        "organism": "formularioDespesa",
        "reads": "obterDespesa.despesa"
      },
      {
        "organism": "acoesEnvio",
        "reads": "obterDespesa.despesa"
      }
    ],
    "commands": [
      {
        "endpoint": "registrarDespesa",
        "refreshes": []
      },
      {
        "endpoint": "salvarCorrecao",
        "refreshes": []
      },
      {
        "endpoint": "enviarParaAprovacao",
        "refreshes": []
      },
      {
        "endpoint": "reenviarParaAprovacao",
        "refreshes": []
      }
    ],
    "selections": [
      {
        "organism": "listaMinhasDespesas",
        "via": {
          "query": "obterDespesa"
        }
      }
    ],
    "journeys": [
      {
        "step": "consultarMinhasDespesas/localizarMinhasDespesas",
        "organisms": [
          "listaMinhasDespesas"
        ],
        "endpoints": [
          "listarMinhasDespesas"
        ]
      },
      {
        "step": "consultarMinhasDespesas/consultarDespesa",
        "organisms": [
          "detalheDespesa"
        ],
        "endpoints": [
          "obterDespesa"
        ]
      },
      {
        "step": "corrigirReenviarDespesa/localizarDespesaRejeitada",
        "organisms": [
          "listaMinhasDespesas"
        ],
        "endpoints": [
          "listarMinhasDespesas"
        ]
      },
      {
        "step": "corrigirReenviarDespesa/consultarMotivoRejeicao",
        "organisms": [
          "detalheDespesa"
        ],
        "endpoints": [
          "obterDespesa"
        ]
      },
      {
        "step": "corrigirReenviarDespesa/corrigirDespesa",
        "organisms": [
          "formularioDespesa"
        ],
        "endpoints": [
          "salvarCorrecao"
        ]
      },
      {
        "step": "corrigirReenviarDespesa/reenviarDespesa",
        "organisms": [
          "acoesEnvio"
        ],
        "endpoints": [
          "reenviarParaAprovacao"
        ]
      },
      {
        "step": "registrarEnviarDespesa/registrarDespesa",
        "organisms": [
          "formularioDespesa"
        ],
        "endpoints": [
          "registrarDespesa"
        ]
      },
      {
        "step": "registrarEnviarDespesa/enviarParaAprovacao",
        "organisms": [
          "acoesEnvio"
        ],
        "endpoints": [
          "enviarParaAprovacao"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "registrarDespesa",
        "state": "obterDespesa.despesa",
        "mode": "replace"
      },
      {
        "endpoint": "registrarDespesa",
        "state": "listarMinhasDespesas.despesas",
        "mode": "upsert"
      },
      {
        "endpoint": "salvarCorrecao",
        "state": "obterDespesa.despesa",
        "mode": "replace"
      },
      {
        "endpoint": "salvarCorrecao",
        "state": "listarMinhasDespesas.despesas",
        "mode": "upsert"
      },
      {
        "endpoint": "enviarParaAprovacao",
        "state": "obterDespesa.despesa",
        "mode": "replace"
      },
      {
        "endpoint": "enviarParaAprovacao",
        "state": "listarMinhasDespesas.despesas",
        "mode": "upsert"
      },
      {
        "endpoint": "reenviarParaAprovacao",
        "state": "obterDespesa.despesa",
        "mode": "replace"
      },
      {
        "endpoint": "reenviarParaAprovacao",
        "state": "listarMinhasDespesas.despesas",
        "mode": "upsert"
      }
    ]
  }
}
