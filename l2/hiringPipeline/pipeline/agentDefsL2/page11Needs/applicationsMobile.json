{
  "organisms": {
    "applicationList": {
      "reads": [
        "Application.applicationNumber",
        "Application.status",
        "Application.appliedAt",
        "Application.candidateId",
        "Application.jobPositionId",
        "Application.details.isActive",
        "Application.details.daysInPipeline",
        "Candidate.details.identification.name",
        "JobPosition.title"
      ],
      "edits": [],
      "selects": "applicationDetail",
      "submits": []
    },
    "newApplicationForm": {
      "reads": [
        "Candidate.details.identification.name",
        "CandidateEmail.details.contactChannel.value",
        "JobPosition.title",
        "JobPosition.department",
        "JobPosition.status",
        "JobPosition.details.remainingOpenings"
      ],
      "edits": [
        "Application.candidateId",
        "Application.jobPositionId"
      ],
      "selects": "",
      "submits": [
        {
          "intentId": "createApplication",
          "write": "Application.create"
        }
      ]
    },
    "applicationDetail": {
      "reads": [
        "Application.applicationNumber",
        "Application.status",
        "Application.appliedAt",
        "Application.details.daysInPipeline",
        "Application.details.isActive",
        "Application.details.rejection.reason",
        "Candidate.details.identification.name",
        "Candidate.details.hiringPipeline.source",
        "CandidateEmail.details.contactChannel.value",
        "JobPosition.title",
        "JobPosition.department",
        "HiringManager.details.identification.name"
      ],
      "edits": [],
      "selects": "",
      "submits": []
    },
    "applicationActions": {
      "reads": [
        "Application.status",
        "Application.applicationNumber",
        "HiringManager.details.identification.name"
      ],
      "edits": [
        "Application.details.rejection.reason"
      ],
      "selects": "",
      "submits": [
        {
          "intentId": "advanceToInterview",
          "write": "Application.advanceToInterview"
        },
        {
          "intentId": "rejectApplication",
          "write": "Application.reject"
        }
      ]
    },
    "stageTimeline": {
      "reads": [
        "Application.status",
        "Application.appliedAt",
        "Application.details.interviewStartedAt",
        "Application.details.offerExtendedAt",
        "Application.details.hiredAt",
        "Application.details.rejection.rejectedAt",
        "Application.details.rejection.stageAtRejection",
        "Application.details.rejection.reason"
      ],
      "edits": [],
      "selects": "",
      "submits": []
    }
  }
}
