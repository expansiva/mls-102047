        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.id"
            ]
          }
        },
        {
          "name": "title",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.title"
            ]
          }
        },
        {
          "name": "department",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.department"
            ]
          }
        },
        {
          "name": "status",
          "type": "'open' | 'closed'",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.status"
            ]
          }
        },
        {
          "name": "openedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.openedAt"
            ]
          }
        },
        {
          "name": "details",
          "type": "MyPositionRowDetails"
        }
      ]
    },
    {
      "name": "PositionDetailDetails",
      "description": "Description and headcount numbers of the selected position.",
      "fields": [
        {
          "name": "details.description",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.details.description"
            ]
          }
        },
        {
          "name": "details.headcount",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.details.headcount"
            ]
          }
        },
        {
          "name": "details.closedAt",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.details.closedAt"
            ]
          }
        },
        {
          "name": "details.hiresSoFar",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.details.hiresSoFar"
            ]
          }
        },
        {
          "name": "details.remainingOpenings",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.details.remainingOpenings"
            ]
          }
        },
        {
          "name": "details.isFilled",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.details.isFilled"
            ]
          }
        }
      ]
    },
    {
      "name": "HiringManagerIdentification",
      "description": "Identification of the position's hiring manager.",
      "fields": [
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "HiringManager.details.identification.name"
            ]
          }
        }
      ]
    },
    {
      "name": "HiringManagerDetails",
      "description": "Details of the position's hiring manager.",
      "fields": [
        {
          "name": "identification",
          "type": "HiringManagerIdentification"
        }
      ]
    },
    {
      "name": "PositionHiringManager",
      "description": "The hiring manager shown on the position.",
      "fields": [
        {
          "name": "details",
          "type": "HiringManagerDetails"
        }
      ]
    },
    {
      "name": "PositionDetail",
      "description": "The selected position with its numbers and hiring manager name.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.id"
            ]
          }
        },
        {
          "name": "title",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.title"
            ]
          }
        },
        {
          "name": "department",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.department"
            ]
          }
        },
        {
          "name": "status",
          "type": "'open' | 'closed'",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.status"
            ]
          }
        },
        {
          "name": "openedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.openedAt"
            ]
          }
        },
        {
          "name": "details",
          "type": "PositionDetailDetails"
        },
        {
          "name": "hiringManager",
          "type": "PositionHiringManager"
        }
      ]
    },
    {
      "name": "CandidateIdentification",
      "description": "Identification of the candidate behind an application.",
      "fields": [
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.identification.name"
            ]
          }
        }
      ]
    },
    {
      "name": "CandidateDetails",
      "description": "Details of the candidate behind an application.",
      "fields": [
        {
          "name": "identification",
          "type": "CandidateIdentification"
        }
      ]
    },
    {
      "name": "ApplicationCandidate",
      "description": "Candidate of an application, only the name the hiring manager may see.",
      "fields": [
        {
          "name": "details",
          "type": "CandidateDetails"
        }
      ]
    },
    {
      "name": "PipelineApplicationDetails",
      "description": "Server-computed pipeline indicators of an application.",
      "fields": [
        {
          "name": "details.daysInPipeline",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.details.daysInPipeline"
            ]
          }
        },
        {
          "name": "details.isActive",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.details.isActive"
            ]
          }
        }
      ]
    },
    {
      "name": "PipelineApplication",
      "description": "One application of the selected position.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.id"
            ]
          }
        },
        {
          "name": "applicationNumber",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.applicationNumber"
            ]
          }
        },
        {
          "name": "status",
          "type": "'screening' | 'interview' | 'offer' | 'hired' | 'rejected'",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.status"
            ]
          }
        },
        {
          "name": "appliedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.appliedAt"
            ]
          }
        },
        {
          "name": "details",
          "type": "PipelineApplicationDetails"
        },
        {
          "name": "candidate",
          "type": "ApplicationCandidate"
        }
      ]
    },
    {
      "name": "StageGroup",
      "description": "Applications of the position in one stage, with the stage count.",
      "fields": [
        {
          "name": "status",
          "type": "'screening' | 'interview' | 'offer' | 'hired' | 'rejected'",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.status"
            ]
          }
        },
        {
          "name": "count",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "JobPosition.details.applicationsByStage",
              "Application.status"
            ]
          }
        },
        {
          "name": "applications",
          "type": "PipelineApplication[]"
        }
      ]
    },
    {
      "name": "PositionEvent",
      "description": "One event in the position's history: opened, or closed automatically when hires reached the headcount.",
      "fields": [
        {
          "name": "status",
          "type": "'open' | 'closed'",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.status"
            ]
          }
        },
        {
          "name": "occurredAt",
          "type": "string",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "JobPosition.openedAt",
              "JobPosition.details.closedAt"
            ]
          }
        },
        {
          "name": "automatic",
          "type": "boolean",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "JobPosition.details.closedAt",
              "JobPosition.details.hiresSoFar",
              "JobPosition.details.headcount"
            ]
          }
        },
        {
          "name": "details.headcount",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.details.headcount"
            ]
          }
        },
        {
          "name": "details.hiresSoFar",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.details.hiresSoFar"
            ]
          }
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "listMyPositions",
      "kind": "qry",
      "when": "onLoad",
      "input": [],
      "output": [
        {
          "name": "positions",
          "type": "MyPositionRow[]"
        }
      ],
      "rules": [
        "hiringManagerSeesOwnPositions",
        "remainingOpeningsCalculated",
        "positionClosesWhenHeadcountFilled"
      ],
      "jsdoc": {
        "purpose": "Loads every job position the signed-in hiring manager manages, with its headcount numbers, so the page can show which ones still need hires.",
        "input": "No input; the hiring manager is resolved from the session (login).",
        "processing": "Resolves the signed-in hiring manager and lists positions whose hiringManagerId points at them (hiringManagerSeesOwnPositions), ordered by openedAt descending. For each position computes hiresSoFar as the count of its applications in hired and remainingOpenings as headcount minus hiresSoFar, never below zero (remainingOpeningsCalculated), and isFilled when hiresSoFar >= headcount (positionClosesWhenHeadcountFilled). Derived values are computed with batched counts, never stored. Not paged: a hiring manager manages a small number of positions.",
        "output": "The list of positions with title, department, status, opening date and details (headcount, hires so far, remaining openings, filled), ready for the overview list."
      }
    },
    {
      "id": "getPositionPipeline",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "jobPositionId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "position",
          "type": "PositionDetail"
        },
        {
          "name": "stageGroups",
          "type": "StageGroup[]"
        },
        {
          "name": "history",
          "type": "PositionEvent[]"
        }
      ],
      "rules": [
        "hiringManagerSeesOwnPositions",
        "remainingOpeningsCalculated",
        "positionClosesWhenHeadcountFilled",
        "closePositionWhenHeadcountFilled",
        "daysInPipelineCalculated",
        "applicationActiveWhileInPipeline"
      ],
      "jsdoc": {
        "purpose": "Loads the selected position's detail, its applications grouped by stage and its history in one call when the hiring manager picks a position.",
        "input": "jobPositionId: id of the position selected in the list.",
        "processing": "Refuses the position if it is not assigned to the signed-in hiring manager (hiringManagerSeesOwnPositions). Reads the position and the hiring manager name. Computes hiresSoFar, remainingOpenings (remainingOpeningsCalculated) and isFilled (positionClosesWhenHeadcountFilled). Lists the position's applications ordered by appliedAt, hydrating candidate names in one batch, and groups them into the five stages screening, interview, offer, hired, rejected, each with its count (applicationsByStage). For each application computes daysInPipeline from appliedAt to today or to hiredAt/rejectedAt (daysInPipelineCalculated) and isActive while in screening, interview or offer (applicationActiveWhileInPipeline). Builds the history: an 'open' event at openedAt and, if closedAt is set, a 'closed' event marked automatic because hires reached the headcount (closePositionWhenHeadcountFilled). Nothing is stored.",
        "output": "position (detail with numbers and hiring manager name), stageGroups (always five stages, with counts and applications) and history (timeline events), so the detail and timeline render without further calls."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "myPositionsList",
        "reads": "listMyPositions.positions"
      },
      {
        "organism": "positionPipelineDetail",
        "reads": "getPositionPipeline.position"
      },
      {
        "organism": "positionPipelineDetail",
        "reads": "getPositionPipeline.stageGroups"
      },
      {
        "organism": "positionHistoryTimeline",
        "reads": "getPositionPipeline.history"
      }
    ],
    "commands": [],
    "selections": [
      {
        "organism": "myPositionsList",
        "via": {
          "query": "getPositionPipeline"
        }
      }
    ],
    "journeys": [
      {
        "step": "reviewMyPipeline/listMyPositions",
        "organisms": [
          "myPositionsList"
        ],
        "endpoints": [
          "listMyPositions"
        ]
      },
      {
        "step": "reviewMyPipeline/inspectPosition",
        "organisms": [
          "positionPipelineDetail",
          "positionHistoryTimeline"
        ],
        "endpoints": [
          "getPositionPipeline"
        ]
      }
    ],
    "updates": []
  }
}
