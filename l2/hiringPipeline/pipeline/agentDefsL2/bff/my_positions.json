          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.details.headcount"
            ]
          }
        },
        {
          "name": "details.hiresSoFar",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.details.hiresSoFar"
            ]
          }
        },
        {
          "name": "details.remainingOpenings",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.details.remainingOpenings"
            ]
          }
        },
        {
          "name": "details.isFilled",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.details.isFilled"
            ]
          }
        }
      ]
    },
    {
      "name": "MyPositionRow",
      "description": "One position the signed-in hiring manager manages, as a list row.",
