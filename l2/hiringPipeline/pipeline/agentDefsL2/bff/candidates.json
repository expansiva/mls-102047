{
  "types": [
    {
      "name": "CandidateSummary",
      "description": "One row of the candidate search list: the candidate with status, source and e-mail.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.id"
            ]
          }
        },
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.status",
          "type": "'Active' | 'Inactive' | 'Merged' | 'Blocked'",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.identification.status"
            ]
          }
        },
        {
          "name": "details.hiringPipeline.source",
          "type": "'careerSite' | 'jobBoard' | 'linkedIn' | 'referral' | 'agency' | 'event' | 'other'",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.hiringPipeline.source"
            ]
          }
        },
        {
          "name": "candidateEmail.details.contactChannel.value",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "CandidateEmail.details.contactChannel.value"
            ]
          }
        }
      ]
    },
    {
      "name": "ApplicationJobPosition",
      "description": "The job position an application was made to, as shown on the candidate's application line.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.id"
            ]
          }
        },
        {
          "name": "title",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.title"
            ]
          }
        },
        {
          "name": "status",
          "type": "'open' | 'closed'",
          "origin": {
            "kind": "field",
            "paths": [
              "JobPosition.status"
            ]
          }
        }
      ]
    },
    {
      "name": "CandidateApplication",
      "description": "One application of the candidate with its position, stage, dates and computed days in stage.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.id"
            ]
          }
        },
        {
          "name": "code",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.code"
            ]
          }
        },
        {
          "name": "status",
          "type": "'screening' | 'interview' | 'offer' | 'hired' | 'rejected'",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.status"
            ]
          }
        },
        {
          "name": "appliedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.appliedAt"
            ]
          }
        },
        {
          "name": "stageChangedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.stageChangedAt"
            ]
          }
        },
        {
          "name": "daysInStage",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Application.details.daysInStage",
              "Application.stageChangedAt"
            ]
          }
        },
        {
          "name": "isActive",
          "type": "boolean",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Application.details.isActive",
              "Application.status"
            ]
          }
        },
        {
          "name": "jobPosition",
          "type": "ApplicationJobPosition"
        }
      ]
    },
    {
      "name": "CandidateProfile",
      "description": "The candidate's details with e-mail and every application made, ready for the detail panel.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.version"
            ]
          }
        },
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.status",
          "type": "'Active' | 'Inactive' | 'Merged' | 'Blocked'",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.identification.status"
            ]
          }
        },
        {
          "name": "details.identification.createdAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.identification.createdAt"
            ]
          }
        },
        {
          "name": "details.hiringPipeline.resumeLink",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.hiringPipeline.resumeLink"
            ]
          }
        },
        {
          "name": "details.hiringPipeline.source",
          "type": "'careerSite' | 'jobBoard' | 'linkedIn' | 'referral' | 'agency' | 'event' | 'other'",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.hiringPipeline.source"
            ]
          }
        },
        {
          "name": "candidateEmail.details.contactChannel.value",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "CandidateEmail.details.contactChannel.value"
            ]
          }
        },
        {
          "name": "applications",
          "type": "CandidateApplication[]"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "searchCandidates",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "search",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "details.hiringPipeline.source",
          "type": "'careerSite' | 'jobBoard' | 'linkedIn' | 'referral' | 'agency' | 'event' | 'other'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.hiringPipeline.source"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "candidates",
          "type": "CandidateSummary[]",
          "paginated": true
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Lists the organization's candidates for the search list, opening with the first page and re-running when the recruiter types a search or picks a source.",
        "input": "search: optional text matched against the candidate's name, aliases and e-mail address; source: optional source filter; page and pageSize: the page requested.",
        "processing": "Reads candidates tagged hiringPipeline.Candidate in the organization (grant recruiterCandidates), matching search by name (locate.byName) or e-mail (locate.byContact through the HasContact link) and filtering by source when given. Joins the candidate's active e-mail contact. Orders by name.",
        "output": "A paged list { items, page, pageSize, hasMore } of candidate rows with name, record status, source and e-mail, so the recruiter sees each candidate's status at a glance and can pick one."
      }
    },
    {
      "id": "getCandidateProfile",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "candidateId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "profile",
          "type": "CandidateProfile"
        }
      ],
      "rules": [
        "daysInStageCalculation",
        "applicationActiveCalculation"
      ],
      "jsdoc": {
        "purpose": "Loads the chosen candidate with e-mail and all applications so the recruiter sees where the candidate stands before recording a new application.",
        "input": "candidateId: the candidate selected in the search list.",
        "processing": "Reads the candidate by id with its linked e-mail, then lists the candidate's applications (listByForeignKey on candidateId) joined with each job position's title and status, ordered by appliedAt descending. daysInStage is computed per application as days from stageChangedAt to today (daysInStageCalculation); isActive is computed as status in screening, interview or offer (applicationActiveCalculation). Neither is stored.",
        "output": "The candidate profile with name, status, registration date, resume link, source, e-mail and the list of applications with position, stage, dates, days in stage and active flag."
      }
    },
    {
      "id": "registerCandidate",
      "kind": "cmd",
      "when": "registerCandidate",
      "writes": "Candidate.create",
      "input": [
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.identification.name"
            ]
          }
        },
        {
          "name": "candidateEmail.details.contactChannel.value",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "CandidateEmail.details.contactChannel.value"
            ]
          }
        },
        {
          "name": "details.hiringPipeline.resumeLink",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.hiringPipeline.resumeLink"
            ]
          }
        },
        {
          "name": "details.hiringPipeline.source",
          "type": "'careerSite' | 'jobBoard' | 'linkedIn' | 'referral' | 'agency' | 'event' | 'other'",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.hiringPipeline.source"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "profile",
          "type": "CandidateProfile"
        },
        {
          "name": "candidate",
          "type": "CandidateSummary"
        },
        {
          "name": "reused",
          "type": "boolean",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Candidate.id",
              "CandidateEmail.details.contactChannel.value"
            ]
          }
        }
      ],
      "rules": [
        "candidateEmailRequired",
        "candidateReusedNotDuplicated"
      ],
      "jsdoc": {
        "purpose": "Registers a candidate from the registration form, reusing an existing person instead of creating a duplicate.",
        "input": "name: the candidate's full name; email: the candidate's e-mail address; resumeLink: web address of the resume; source: where the candidate came from.",
        "processing": "Refuses the request when name, e-mail, resume link or source is missing (candidateEmailRequired). Looks up an existing candidate owning the same e-mail (locate.byContact) and reuses it (candidateReusedNotDuplicated) via register.createOrAttach: the person is created only when not found, tagged hiringPipeline.Candidate, the resume link and source are written in the hiringPipeline namespace, and the e-mail contact channel is created or attached and linked with HasContact. Status and createdAt are set by the platform, not by the endpoint.",
        "output": "The resulting candidate profile (with any existing applications when reused) for the detail panel, the summary row to upsert into the search list, and reused telling the recruiter an existing candidate was used."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "candidateSearch",
        "reads": "searchCandidates.candidates"
      },
      {
        "organism": "candidateProfile",
        "reads": "getCandidateProfile.profile"
      }
    ],
    "commands": [
      {
        "endpoint": "registerCandidate",
        "refreshes": []
      }
    ],
    "selections": [
      {
        "organism": "candidateSearch",
        "via": {
          "query": "getCandidateProfile"
        }
      }
    ],
    "journeys": [
      {
        "step": "registerCandidateApplication/registerCandidate",
        "organisms": [
          "candidateRegistration"
        ],
        "endpoints": [
          "registerCandidate"
        ]
      },
      {
        "step": "registerCandidateApplication/findPosition",
        "organisms": [],
        "endpoints": [],
        "continuesIn": "applications"
      },
      {
        "step": "registerCandidateApplication/createApplication",
        "organisms": [],
        "endpoints": [],
        "continuesIn": "applications"
      }
    ],
    "updates": [
      {
        "endpoint": "searchCandidates",
        "state": "searchCandidates.candidates",
        "mode": "replace"
      },
      {
        "endpoint": "registerCandidate",
        "state": "searchCandidates.candidates",
        "mode": "upsert"
      },
      {
        "endpoint": "registerCandidate",
        "state": "getCandidateProfile.profile",
        "mode": "replace"
      }
    ]
  }
}
