{
  "types": [
    {
      "name": "DecisionInterview",
      "description": "Interview stage facts of an application waiting for a decision.",
      "fields": [
        {
          "name": "details.interview.movedAt",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Application.details.interview.movedAt"
            ]
          }
        }
      ]
    },
    {
      "name": "DecisionOffer",
      "description": "Offer stage facts of an application waiting for a hire decision.",
      "fields": [
        {
          "name": "details.offer.extendedAt",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Application.details.offer.extendedAt"
            ]
          }
        }
      ]
    },
    {
      "name": "DecisionDetails",
      "description": "Computed and stage details of an application waiting for a decision.",
      "fields": [
        {
          "name": "details.daysInStage",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.details.daysInStage"
            ]
          }
        },
        {
          "name": "details.remainingOpenings",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.details.remainingOpenings"
            ]
          }
        },
        {
          "name": "interview",
          "type": "DecisionInterview",
          "optional": true
        },
        {
          "name": "offer",
          "type": "DecisionOffer",
          "optional": true
        }
      ]
    },
    {
      "name": "DecisionCandidateIdentification",
      "description": "Candidate name as shown in the inbox.",
      "fields": [
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.identification.name"
            ]
          }
        }
      ]
    },
    {
      "name": "DecisionCandidateHiringPipeline",
      "description": "Candidate module fields the hiring manager reviews before deciding.",
      "fields": [
        {
          "name": "details.hiringPipeline.resumeLink",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.hiringPipeline.resumeLink"
            ]
          }
        },
        {
          "name": "details.hiringPipeline.source",
          "type": "'careerSite' | 'jobBoard' | 'linkedIn' | 'referral' | 'agency' | 'event' | 'other'",
          "origin": {
            "kind": "field",
            "paths": [
              "Candidate.details.hiringPipeline.source"
            ]
          }
        }
      ]
    },
    {
      "name": "DecisionCandidateDetails",
      "description": "Candidate details visible to the hiring manager.",
      "fields": [
        {
          "name": "identification",
          "type": "DecisionCandidateIdentification"
        },
        {
          "name": "hiringPipeline",
          "type": "DecisionCandidateHiringPipeline"
        }
      ]
    },
    {
      "name": "DecisionCandidate",
      "description": "The candidate of the application, read from the master record.",
      "fields": [
        {
          "name": "details",
          "type": "DecisionCandidateDetails"
        }
      ]
    },
    {
      "name": "DecisionItem",
      "description": "One application waiting for the hiring manager's decision (interview → offer or send back; offer → hire or send back).",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.version"
            ]
          }
        },
        {
          "name": "code",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.code"
            ]
          }
        },
        {
          "name": "status",
          "type": "'screening' | 'interview' | 'offer' | 'hired' | 'rejected'",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.status"
            ]
          }
        },
        {
          "name": "candidateId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.candidateId"
            ]
          }
        },
        {
          "name": "jobPositionId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.jobPositionId"
            ]
          }
        },
        {
          "name": "appliedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.appliedAt"
            ]
          }
        },
        {
          "name": "stageChangedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.stageChangedAt"
            ]
          }
        },
        {
          "name": "details",
          "type": "DecisionDetails"
        },
        {
          "name": "candidate",
          "type": "DecisionCandidate"
        }
      ]
    },
    {
      "name": "StagePipeline",
      "description": "Active applications of one position in one stage, with how long they have stayed there.",
      "fields": [
        {
          "name": "status",
          "type": "'screening' | 'interview' | 'offer' | 'hired' | 'rejected'",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.status"
            ]
          }
        },
        {
          "name": "activeCount",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Application.id",
              "Application.status",
              "Application.details.isActive"
            ]
          }
        },
        {
          "name": "maxDaysInStage",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Application.details.daysInStage",
              "Application.stageChangedAt"
            ]
          }
        },
        {
          "name": "oldestStageChangedAt",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Application.stageChangedAt"
            ]
          }
        }
      ]
    },
    {
      "name": "PositionPipeline",
      "description": "Pipeline reading of one position the hiring manager manages.",
      "fields": [
        {
          "name": "jobPositionId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.jobPositionId"
            ]
          }
        },
        {
          "name": "details.remainingOpenings",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.details.remainingOpenings"
            ]
          }
        },
        {
          "name": "activeCount",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Application.id",
              "Application.details.isActive"
            ]
          }
        },
        {
          "name": "stages",
          "type": "StagePipeline[]"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "getHiringManagerHome",
      "kind": "qry",
      "when": "onLoad",
      "input": [],
      "output": [
        {
          "name": "decisions",
          "type": "DecisionItem[]"
        },
        {
          "name": "pipeline",
          "type": "PositionPipeline[]"
        }
      ],
      "rules": [
        "applicationActiveCalculation",
        "daysInStageCalculation",
        "remainingOpeningsCalculation",
        "hiresSoFarCalculation"
      ],
      "jsdoc": {
        "purpose": "Loads the hiring manager home in one call: the applications waiting for her decision and the pipeline summary of the positions she manages.",
        "input": "None. The signed-in hiring manager is resolved from the session (login), and every read is scoped to the job positions whose hiring manager she is.",
        "processing": "Decisions: applications of her positions in status interview or offer, ordered by stageChangedAt ascending (longest waiting first), joined with the candidate master record (name, resumeLink, source only, per grant). Pipeline: for each of her positions, active applications (applicationActiveCalculation: screening, interview or offer) grouped by stage with count, max days in stage and oldest stageChangedAt; daysInStage computed as days from stageChangedAt to today (daysInStageCalculation); remainingOpenings computed as headcount minus hires so far, never below zero (hiresSoFarCalculation, remainingOpeningsCalculation). All derived values are computed at read time, never stored.",
        "output": "decisions: the inbox items ready to show with candidate, position, days waiting and remaining openings; pipeline: one row per position with stage counts already computed, so the page sums nothing."
      }
    },
    {
      "id": "extendOffer",
      "kind": "cmd",
      "when": "extendOffer",
      "writes": "Application.extendOffer",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.version"
            ]
          }
        },
        {
          "name": "details.offer.notes",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Application.details.offer.notes"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "decision",
          "type": "DecisionItem"
        },
        {
          "name": "pipeline",
          "type": "PositionPipeline[]"
        }
      ],
      "rules": [
        "onlyPositionManagerDecides",
        "stageSequenceEnforced",
        "finalStagesAreTerminal"
      ],
      "jsdoc": {
        "purpose": "Extends an offer to an interviewed candidate from the inbox.",
        "input": "applicationId: the application to move; version: optimistic concurrency check; offerNotes: what the hiring manager wants recorded about the offer.",
        "processing": "Refuses unless the signed-in user is the hiring manager of the application's position (onlyPositionManagerDecides), the application is in interview (stageSequenceEnforced) and not hired or rejected (finalStagesAreTerminal), and the version matches. Moves interview → offer, records offer notes; the engine records extendedAt, decidedBy and stageChangedAt. Then recomputes the pipeline of her positions.",
        "output": "decision: the updated inbox item, now in offer and waiting for the hire decision; pipeline: refreshed stage counts, so the page needs no second call."
      }
    },
    {
      "id": "hireCandidate",
      "kind": "cmd",
      "when": "hireCandidate",
      "writes": "Application.hire",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "decisions",
          "type": "DecisionItem[]"
        },
        {
          "name": "pipeline",
          "type": "PositionPipeline[]"
        }
      ],
      "rules": [
        "onlyPositionManagerDecides",
        "hireRequiresRemainingHeadcount",
        "closePositionWhenHeadcountFilled",
        "stageSequenceEnforced",
        "finalStagesAreTerminal",
        "remainingOpeningsCalculation"
      ],
      "jsdoc": {
        "purpose": "Hires the candidate of an application in offer, closing the position when its headcount is filled.",
        "input": "applicationId: the application in offer to hire; version: optimistic concurrency check.",
        "processing": "Refuses unless the signed-in user is the position's hiring manager (onlyPositionManagerDecides), the application is in offer (stageSequenceEnforced, finalStagesAreTerminal), the version matches, and the position is open with remaining openings (hireRequiresRemainingHeadcount). In one transaction moves offer → hired (engine records hiredAt, decidedBy, stageChangedAt) and, if hires now reach headcount, closes the job position (closePositionWhenHeadcountFilled). Remaining openings are recomputed (remainingOpeningsCalculation), never stored.",
        "output": "decisions: the whole inbox again, because the hired item leaves it and the remaining openings of other items of the same position change; pipeline: refreshed per-position summary."
      }
    },
    {
      "id": "sendBack",
      "kind": "cmd",
      "when": "sendBack",
      "writes": "Application.reject",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.version"
            ]
          }
        },
        {
          "name": "details.rejection.reason",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.details.rejection.reason"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Application.id"
            ]
          }
        },
        {
          "name": "pipeline",
          "type": "PositionPipeline[]"
        }
      ],
      "rules": [
        "rejectionRequiresReason",
        "finalStagesAreTerminal",
        "stageSequenceEnforced"
      ],
      "jsdoc": {
        "purpose": "Sends back an interviewed or offered application by declining it with a reason.",
        "input": "applicationId: the application to decline; version: optimistic concurrency check; reason: why the application does not move forward (required).",
        "processing": "Refuses without a reason (rejectionRequiresReason) or when the application is already hired or rejected (finalStagesAreTerminal); only screening, interview or offer may be rejected (stageSequenceEnforced); checks the version and that the application belongs to her positions. Moves to rejected, recording the reason; the engine records rejectedAt and stageAtRejection. Recomputes the pipeline.",
        "output": "applicationId: the item to remove from the inbox; pipeline: refreshed per-position summary."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "decisionInbox",
        "reads": "getHiringManagerHome.decisions"
      },
      {
        "organism": "pipelineSummary",
        "reads": "getHiringManagerHome.pipeline"
      }
    ],
    "commands": [
      {
        "endpoint": "extendOffer",
        "refreshes": []
      },
      {
        "endpoint": "hireCandidate",
        "refreshes": []
      },
      {
        "endpoint": "sendBack",
        "refreshes": []
      }
    ],
    "selections": [],
    "journeys": [
      {
        "step": "decideHire/findApplication",
        "organisms": [
          "decisionInbox"
        ],
        "endpoints": [
          "getHiringManagerHome"
        ]
      },
      {
        "step": "decideHire/reviewOffer",
        "organisms": [
          "decisionInbox"
        ],
        "endpoints": [
          "getHiringManagerHome"
        ]
      },
      {
        "step": "decideHire/checkHeadcount",
        "organisms": [
          "decisionInbox",
          "pipelineSummary"
        ],
        "endpoints": [
          "getHiringManagerHome"
        ]
      },
      {
        "step": "decideHire/hire",
        "organisms": [
          "decisionInbox"
        ],
        "endpoints": [
          "hireCandidate"
        ]
      },
      {
        "step": "decideOffer/findApplication",
        "organisms": [
          "decisionInbox"
        ],
        "endpoints": [
          "getHiringManagerHome"
        ]
      },
      {
        "step": "decideOffer/reviewCandidate",
        "organisms": [
          "decisionInbox"
        ],
        "endpoints": [
          "getHiringManagerHome"
        ]
      },
      {
        "step": "decideOffer/extendOffer",
        "organisms": [
          "decisionInbox"
        ],
        "endpoints": [
          "extendOffer"
        ]
      },
      {
        "step": "reviewMyPipeline/findMyPositions",
        "organisms": [
          "pipelineSummary"
        ],
        "endpoints": [
          "getHiringManagerHome"
        ],
        "continuesIn": "my_positions"
      },
      {
        "step": "reviewMyPipeline/inspectPosition",
        "organisms": [
          "pipelineSummary"
        ],
        "endpoints": [
          "getHiringManagerHome"
        ],
        "continuesIn": "my_positions"
      },
      {
        "step": "reviewMyPipeline/inspectApplications",
        "organisms": [
          "pipelineSummary"
        ],
        "endpoints": [
          "getHiringManagerHome"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "extendOffer",
        "state": "getHiringManagerHome.decisions",
        "mode": "upsert"
      },
      {
        "endpoint": "extendOffer",
        "state": "getHiringManagerHome.pipeline",
        "mode": "replace"
      },
      {
        "endpoint": "hireCandidate",
        "state": "getHiringManagerHome.decisions",
        "mode": "replace"
      },
      {
        "endpoint": "hireCandidate",
        "state": "getHiringManagerHome.pipeline",
        "mode": "replace"
      },
      {
        "endpoint": "sendBack",
        "state": "getHiringManagerHome.decisions",
        "mode": "remove"
      },
      {
        "endpoint": "sendBack",
        "state": "getHiringManagerHome.pipeline",
        "mode": "replace"
      }
    ]
  }
}
