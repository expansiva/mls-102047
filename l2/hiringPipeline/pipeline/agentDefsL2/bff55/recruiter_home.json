            "type": "InboxApplication",
            "origin": {
              "kind": "field",
              "paths": [
                "Application.details"
              ]
            }
          }
        ],
        "rules": [
          "recruiterMovesScreeningAndInterview",
          "applicationOnlyToOpenPosition",
          "oneActiveApplicationPerCandidateAndPosition",
          "applicationNumberFromSequence",
          "applicationStartsInScreening"
        ],
        "jsdoc": {
          "purpose": "Records a new application of the chosen candidate to the chosen open position.",
          "input": "candidateId: the candidate who applies. jobPositionId: the open position applied to.",
          "processing": "Only a recruiter may record (recruiterMovesScreeningAndInterview). Refuses when the position is not open (applicationOnlyToOpenPosition) or when the candidate already has an active application for that position (oneActiveApplicationPerCandidateAndPosition). Issues applicationNumber from the sequence hiringPipeline.Application (applicationNumberFromSequence), sets status screening (applicationStartsInScreening) and appliedAt to today. isActive and daysInPipeline are computed on read.",
          "output": "application: the new inbox item with candidate and position, inserted into the inbox without another call."
        }
      },
      {
        "id": "advanceToInterview",
        "kind": "cmd",
        "when": "advanceToInterview",
        "writes": "Application.advanceToInterview",
        "input": [
          {
            "name": "id",
            "type": "string",
            "origin": {
              "kind": "field",
              "paths": [
                "Application.id"
              ]
            }
          },
          {
            "name": "version",
            "type": "number",
            "origin": {
