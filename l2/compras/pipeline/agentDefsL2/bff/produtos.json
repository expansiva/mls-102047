            ]
          }
        },
        {
          "name": "details.product.productType",
          "type": "'Physical' | 'Consumable' | 'Bundle' | 'Digital' | 'Other'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Produto.details.product.productType"
            ]
          }
        },
        {
          "name": "details.product.category",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Produto.details.product.category"
            ]
          }
        },
        {
          "name": "details.product.brand",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Produto.details.product.brand"
            ]
          }
        },
        {
          "name": "details.product.unitOfMeasure",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Produto.details.product.unitOfMeasure"
            ]
          }
        },
        {
          "name": "details.product.isInventoried",
          "type": "boolean",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Produto.details.product.isInventoried"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "produto",
          "type": "Produto"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Salva a correção dos dados do produto escolhido.",
        "input": "id e version do produto carregado (concorrência otimista) e os campos editados: nome, outros nomes, observações, SKU, tipo, categoria, marca, unidade de medida e se controla estoque.",
        "processing": "Usa edit.platformFields/edit.moduleNamespace; recusa se a versão diverge da atual; valida o formato do documento. Versão e data de alteração são atualizadas pelo motor.",
        "output": "O produto atualizado com a nova versão, para redesenhar o formulário sem nova chamada."
      }
