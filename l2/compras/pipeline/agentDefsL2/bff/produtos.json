  "endpoints": [
    {
      "id": "listarProdutos",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "produtos",
          "type": "ProdutoResumo[]",
          "paginated": true
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Carrega o catálogo de produtos comprados pela organização, página a página, e permite buscar pelo nome ou código para evitar cadastro duplicado.",
        "input": "busca: texto opcional digitado pela pessoa, comparado ao nome, aos outros nomes e ao código interno (SKU); page e pageSize: página solicitada e seu tamanho.",
        "processing": "Filtra os produtos com o papel compras.Produto no escopo da organização (capacidade locate.byName); aplica a busca por nome/SKU quando informada; ordena por nome; devolve só os campos da lista. Situação e data de alteração são lidas do cadastro mestre, nunca calculadas aqui.",
        "output": "Página { items, page, pageSize, hasMore } de produtos com id, nome, SKU, categoria, marca, unidade de medida, situação e última alteração, para a lista e a escolha do produto a alterar."
      }
    },
    {
      "id": "obterProduto",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Produto.id"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "produto",
          "type": "Produto"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Carrega o produto escolhido no catálogo para preencher o formulário de alteração.",
        "input": "id: identificador do produto selecionado na lista.",
        "processing": "Lê o produto pelo id (read.byId) dentro do escopo da organização e devolve os campos do formulário, incluindo a versão para controle de concorrência.",
        "output": "Produto com id, versão, nome, situação, outros nomes, observações, SKU, tipo, categoria, marca, unidade de medida e se controla estoque."
      }
    },
    {
      "id": "cadastrarProduto",
      "kind": "cmd",
      "when": "cadastrarProduto",
      "writes": "Produto.create",
      "input": [
        {
