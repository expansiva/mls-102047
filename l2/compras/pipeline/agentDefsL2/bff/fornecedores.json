        },
        {
          "name": "dataPrevistaEntrega",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PedidoCompra.dataPrevistaEntrega"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "pedido",
          "type": "PedidoComItens"
        }
      ],
      "rules": [
        "pedidoExigeItens",
        "valorLimiteAprovacao",
        "fornecedorInativoSemNovoPedido"
      ],
      "jsdoc": {
        "purpose": "Envia o pedido em rascunho; até o valor limite segue liberado ao fornecedor, acima aguarda aprovação do gerente de compras.",
        "input": "id e version do pedido; dataPrevistaEntrega: entrega combinada, payload da transição enviar.",
        "processing": "Executa a transição enviar (rascunho → enviado). Recusa pedido sem ao menos um item com quantidade e preço (pedidoExigeItens) e fornecedor inativo (fornecedorInativoSemNovoPedido); recusa versão desatualizada. Compara o valor total calculado com o valor limite (valorLimiteAprovacao): acima, aguardandoAprovacao fica verdadeiro e o pedido é encaminhado ao gerente; até o limite, fica liberado ao fornecedor. dataEnvio é registrada pelo sistema; aguardandoAprovacao é derivado.",
        "output": "O pedido enviado com situação, valor total e indicação de aguardando aprovação, para a página mostrar o resultado do envio."
      }
    }
