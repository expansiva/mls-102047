  "endpoints": [
    {
      "id": "buscarFornecedores",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "fornecedores",
          "type": "FornecedorResumo[]",
          "paginated": true
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Lista os fornecedores da organização, buscados pelo nome, razão social ou CNPJ, para o usuário conferir se já existe antes de cadastrar e escolher com qual trabalhar.",
        "input": "busca: texto digitado (nome, razão social ou CNPJ), opcional; sem ele retorna os fornecedores em ordem de nome. page e pageSize: página pedida da lista.",
        "processing": "Usa locate.byName e locate.byDocument do Fornecedor (escopo organização para comprador e gerente). CNPJ digitado é comparado sem máscara. Ordena por nome. Lê a situação do cadastro mestre, sem filtrar inativos, para evitar recadastro de um fornecedor existente.",
        "output": "Página { items, page, pageSize, hasMore } de fornecedores com id, nome, CNPJ, razão social e situação, que a lista mostra e de onde o usuário escolhe."
      }
    },
    {
      "id": "abrirFornecedor",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "fornecedorId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "fornecedor",
          "type": "FornecedorDetalhe"
        },
        {
          "name": "produtosFornecidos",
          "type": "ProdutoFornecidoLinha[]"
        },
        {
          "name": "pedidoRascunho",
          "type": "PedidoComItens",
          "optional": true
        }
      ],
      "rules": [
        "precoCombinadoSugerePreco",
        "valorTotalPedidoCalculado"
      ],
      "jsdoc": {
        "purpose": "Carrega de uma vez tudo o que a página mostra para o fornecedor escolhido: cadastro e contatos, produtos fornecidos com preço combinado e o pedido em rascunho em andamento para ele.",
        "input": "fornecedorId: fornecedor escolhido na lista.",
        "processing": "Lê o Fornecedor por read.byId e seus contatos por listLinks (HasContact). Lista os ProdutoFornecido do fornecedor por listByForeignKey (para o comprador, só os do seu escopo próprio; para o gerente, todos da organização), hidratando o nome do Produto em lote por read.mdmRecord; usadoEmPedidos e precoAtualizadoEm são derivados, calculados e não gravados. Busca o pedido de compra mais recente do comprador da sessão para este fornecedor com status rascunho e seus itens; valorTotal e valorTotalItem são calculados como soma de quantidade × preço unitário (valorTotalPedidoCalculado). Os produtos fornecidos ativos servem de sugestão de preço ao incluir item (precoCombinadoSugerePreco).",
        "output": "fornecedor com contatos para o formulário; produtosFornecidos para o detalhe, o formulário de preço e a sugestão do item; pedidoRascunho com itens e total, ausente quando não há rascunho, para as ações de pedido."
      }
    },
    {
      "id": "buscarProdutos",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "produtos",
          "type": "ProdutoResumo[]"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Encontra produtos do catálogo pelo nome para escolher qual associar ao fornecedor como produto fornecido.",
        "input": "busca: parte do nome do produto digitado.",
        "processing": "Usa locate.byName do Produto, retorna apenas produtos com situação Active e limita aos primeiros resultados (lista curta de sugestão, não paginada).",
        "output": "Lista de produtos com id e nome para o seletor do formulário de produto fornecido."
      }
    },
    {
      "id": "salvarFornecedor",
      "kind": "cmd",
      "when": "salvarFornecedor",
      "writes": "Fornecedor.create",
      "input": [
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Fornecedor.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.docType",
          "type": "'CNPJ'",
          "origin": {
            "kind": "field",
            "paths": [
              "Fornecedor.details.identification.docType"
            ]
          }
        },
        {
          "name": "details.identification.docId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Fornecedor.details.identification.docId"
            ]
          }
        },
        {
          "name": "details.identification.countryCode",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Fornecedor.details.identification.countryCode"
            ]
          }
        },
        {
          "name": "details.company.companyKind",
          "type": "'LegalEntity' | 'Branch'",
          "origin": {
            "kind": "field",
            "paths": [
              "Fornecedor.details.company.companyKind"
            ]
          }
        },
        {
          "name": "details.company.legalName",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Fornecedor.details.company.legalName"
            ]
          }
        },
        {
          "name": "details.company.tradeName",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Fornecedor.details.company.tradeName"
            ]
          }
        },
        {
          "name": "details.base.notes",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Fornecedor.details.base.notes"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "fornecedor",
          "type": "FornecedorDetalhe"
        }
      ],
      "rules": [
        "fornecedorCnpjObrigatorio"
      ],
      "jsdoc": {
        "purpose": "Cadastra o fornecedor: cria a empresa pelo CNPJ quando não existe e anexa o papel compras.Fornecedor.",
        "input": "name, docType (CNPJ), docId (número do CNPJ), countryCode (BR), companyKind, legalName (razão social), tradeName (nome fantasia) e notes (observações) editados no formulário.",
        "processing": "Usa register.createOrAttach. Aplica fornecedorCnpjObrigatorio: recusa CNPJ ausente ou inválido e recusa quando já existe fornecedor com o mesmo CNPJ. Situação, id e versão são definidos pela plataforma, não pelo endpoint.",
        "output": "O fornecedor gravado com contatos, para o formulário redesenhar e a lista inserir o novo fornecedor sem nova chamada."
      }
    },
    {
      "id": "incluirProdutoFornecido",
      "kind": "cmd",
      "when": "incluirProdutoFornecido",
      "writes": "ProdutoFornecido.create",
      "input": [
        {
          "name": "fornecedorId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.fornecedorId"
            ]
          }
        },
        {
          "name": "compradorId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.compradorId"
            ]
          }
        },
        {
          "name": "produtoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.produtoId"
            ]
          }
        },
        {
          "name": "details.precoCombinado",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.details.precoCombinado"
            ]
          }
        },
        {
          "name": "details.vigenteDesde",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.details.vigenteDesde"
            ]
          }
        },
        {
          "name": "details.codigoNoFornecedor",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.details.codigoNoFornecedor"
            ]
          }
        },
        {
          "name": "details.observacoes",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.details.observacoes"
            ]
          }
        },
        {
          "name": "ativo",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.ativo"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "produtoFornecido",
          "type": "ProdutoFornecidoLinha"
        }
      ],
      "rules": [
        "produtoFornecidoUnicoPorFornecedor",
        "precoCombinadoPositivo",
        "produtoFornecidoSomenteFornecedorAtivo"
      ],
      "jsdoc": {
        "purpose": "Associa um produto ao fornecedor escolhido com o preço combinado e a vigência.",
        "input": "fornecedorId: fornecedor escolhido; compradorId: comprador responsável pelo preço combinado (o comprador da sessão, conferido pelo servidor contra a sessão); produtoId: produto do catálogo; precoCombinado e vigenteDesde; codigoNoFornecedor e observacoes opcionais; ativo indica se é sugerido em pedidos.",
        "processing": "Recusa se o fornecedor não estiver Active (produtoFornecidoSomenteFornecedorAtivo), se o preço não for maior que zero (precoCombinadoPositivo) ou se já existir produto fornecido para o mesmo fornecedor e produto (produtoFornecidoUnicoPorFornecedor). Recusa compradorId diferente do comprador da sessão quando o ator é comprador (escopo próprio). O código é emitido por sequence.next e precoAtualizadoEm é registrado pelo sistema.",
        "output": "A linha do produto fornecido criada, com código, nome do produto e preço, para inserir no detalhe sem recarregar."
      }
    },
    {
      "id": "alterarPrecoCombinado",
      "kind": "cmd",
      "when": "alterarPrecoCombinado",
      "writes": "ProdutoFornecido.update",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.version"
            ]
          }
        },
        {
          "name": "produtoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.produtoId"
            ]
          }
        },
        {
          "name": "details.precoCombinado",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.details.precoCombinado"
            ]
          }
        },
        {
          "name": "details.vigenteDesde",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.details.vigenteDesde"
            ]
          }
        },
        {
          "name": "details.codigoNoFornecedor",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.details.codigoNoFornecedor"
            ]
          }
        },
        {
          "name": "details.observacoes",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.details.observacoes"
            ]
          }
        },
        {
          "name": "ativo",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "ProdutoFornecido.ativo"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "produtoFornecido",
          "type": "ProdutoFornecidoLinha"
        }
      ],
      "rules": [
        "precoCombinadoPositivo",
        "produtoFornecidoSomenteFornecedorAtivo",
        "produtoFornecidoUnicoPorFornecedor"
      ],
      "jsdoc": {
        "purpose": "Altera o preço combinado, a vigência ou a atividade de um produto fornecido escolhido no detalhe.",
        "input": "id e version do produto fornecido (concorrência otimista); produtoId: produto do catálogo do produto fornecido, como está no formulário; novo precoCombinado, vigenteDesde, codigoNoFornecedor, observacoes e ativo.",
        "processing": "Recusa se o fornecedor do produto fornecido não estiver Active (produtoFornecidoSomenteFornecedorAtivo) ou se o preço não for maior que zero (precoCombinadoPositivo); recusa versão desatualizada. Se produtoId mudar, recusa quando já existir outro produto fornecido do mesmo fornecedor para esse produto (produtoFornecidoUnicoPorFornecedor). Quando o preço muda, precoAtualizadoEm é registrado pelo sistema. Itens de pedido já criados mantêm seu preço.",
        "output": "A linha atualizada com o novo preço e a data de atualização, para substituir no detalhe sem nova chamada."
      }
    },
    {
      "id": "abrirPedido",
      "kind": "cmd",
      "when": "abrirPedido",
      "writes": "PedidoCompra.create",
      "input": [
        {
          "name": "fornecedorId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PedidoCompra.fornecedorId"
            ]
          }
        },
        {
          "name": "compradorId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PedidoCompra.compradorId"
            ]
          }
        },
        {
          "name": "dataPrevistaEntrega",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "PedidoCompra.dataPrevistaEntrega"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "pedido",
          "type": "PedidoComItens"
        }
      ],
      "rules": [
        "fornecedorInativoSemNovoPedido",
        "compradorInativoNaoAbrePedido",
        "numeroPedidoUnico"
      ],
      "jsdoc": {
        "purpose": "Abre um pedido de compra em rascunho para o fornecedor escolhido.",
        "input": "fornecedorId: fornecedor escolhido; compradorId: comprador que abre o pedido (o comprador da sessão, conferido pelo servidor contra a sessão); dataPrevistaEntrega: entrega prevista, opcional na abertura.",
        "processing": "Recusa se o fornecedor não estiver Active (fornecedorInativoSemNovoPedido) ou se o comprador informado estiver inativo (compradorInativoNaoAbrePedido); recusa compradorId diferente do comprador da sessão. Grava com status rascunho e número único emitido por sequence.next (numeroPedidoUnico); dataEmissao é registrada pelo sistema.",
        "output": "O pedido em rascunho com número, situação, itens vazios e valor total zero, para as ações de pedido redesenharem."
      }
    },
    {
      "id": "incluirItemPedido",
      "kind": "cmd",
      "when": "incluirItemPedido",
      "writes": "ItemPedido.create",
      "input": [
        {
          "name": "pedidoCompraId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemPedido.pedidoCompraId"
            ]
          }
        },
        {
          "name": "produtoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemPedido.produtoId"
            ]
          }
        },
        {
          "name": "produtoFornecidoId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "ItemPedido.produtoFornecidoId"
            ]
          }
        },
        {
          "name": "details.quantidade",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemPedido.details.quantidade"
            ]
          }
