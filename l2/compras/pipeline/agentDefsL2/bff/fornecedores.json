          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemPedido.details.precoUnitario"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "pedido",
          "type": "PedidoComItens"
        }
      ],
      "rules": [
        "itemPedidoSomenteEmRascunho",
        "itemPedidoProdutoDoFornecedor",
        "inactiveProductCannotBeOrdered",
        "itemPedidoQuantidadePositiva",
        "precoCombinadoSugerePreco",
        "precoSugeridoNoItemPedido",
        "valorTotalPedidoCalculado"
      ],
      "jsdoc": {
        "purpose": "Inclui um item no pedido em rascunho com quantidade e preço, sugerido pelo preço combinado do fornecedor.",
        "input": "pedidoCompraId: pedido em rascunho; produtoId: produto do item; produtoFornecidoId: produto fornecido cujo preço combinado sugeriu o preço; quantidade e precoUnitario (pode ter sido alterado pelo comprador).",
        "processing": "Recusa se o pedido não estiver em rascunho (itemPedidoSomenteEmRascunho), se o produto não for um produto fornecido ativo do fornecedor do pedido (itemPedidoProdutoDoFornecedor), se o produto estiver inativo no cadastro mestre (inactiveProductCannotBeOrdered), se a quantidade não for maior que zero ou o preço for negativo (itemPedidoQuantidadePositiva). O preço sugerido vem do preço combinado vigente (precoCombinadoSugerePreco) e o item registra produtoFornecidoId quando houver (precoSugeridoNoItemPedido). numeroItem é o próximo da sequência do pedido. valorTotalItem e valorTotal são calculados (valorTotalPedidoCalculado), não gravados.",
        "output": "O pedido com todos os itens e o valor total recalculado, para a revisão redesenhar sem segunda chamada."
      }
    },
    {
      "id": "enviarPedido",
      "kind": "cmd",
      "when": "enviarPedido",
      "writes": "PedidoCompra.enviar",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
