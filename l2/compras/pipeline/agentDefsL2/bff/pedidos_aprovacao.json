  "endpoints": [
    {
      "id": "qryListarPedidos",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "filtro",
          "type": "'todos' | 'pendentesAprovacao' | 'atrasados'",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "pedidos",
          "type": "PedidoResumo[]",
          "paginated": true
        }
      ],
      "rules": [
        "valorLimiteAprovacao",
        "pedidoAtrasadoPrevisaoVencida",
        "pedidoEmAbertoAteRecebimentoTotal"
      ],
      "jsdoc": {
        "purpose": "Carrega a lista paginada dos pedidos de compra da organização, já filtrada pelo filtro rápido escolhido pelo gerente.",
        "input": "filtro: 'todos' (padrão), 'pendentesAprovacao' (aguardandoAprovacao verdadeiro) ou 'atrasados' (atrasado verdadeiro); page e pageSize: página solicitada e tamanho.",
        "processing": "Localiza os pedidos da organização por situação, ordenados pela data de abertura mais recente; aplica o filtro: pendentes são os enviados acima do valor limite ainda sem decisão (valorLimiteAprovacao); atrasados são os em aberto (enviados, aprovados ou recebidos parcialmente, pedidoEmAbertoAteRecebimentoTotal) com entrega prevista anterior a hoje (pedidoAtrasadoPrevisaoVencida). Os campos derivados (valorTotal, quantidadePendente, aguardandoAprovacao, atrasado, emAberto, liberadoAoFornecedor) são calculados, nunca gravados. Hidrata de uma vez o nome do fornecedor e do comprador pelo cadastro mestre.",
        "output": "Página { items, page, pageSize, hasMore } de linhas com número, situação, datas, valor total, quantidade pendente, indicadores e nomes de fornecedor e comprador, prontas para a lista."
      }
    },
    {
      "id": "qryObterPedido",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "pedidoId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "pedido",
          "type": "PedidoAnalise"
        },
        {
          "name": "historico",
          "type": "HistoricoPedido"
        }
      ],
      "rules": [
        "valorTotalPedidoCalculado",
        "quantidadeRecebidaNaoExcedePedido",
        "entradaPublicadaAoEstoque"
      ],
      "jsdoc": {
        "purpose": "Abre o pedido escolhido na lista com tudo o que a análise, a decisão e o histórico mostram, numa só chamada.",
        "input": "pedidoId: id do pedido selecionado na lista.",
        "processing": "Lê o pedido pelo id, seus itens (listByForeignKey) com nome e unidade do produto, fornecedor (nome, razão social, CNPJ) e comprador pelo cadastro mestre. Calcula valorTotalItem, quantidadeRecebida (soma das entradas do item), quantidadePendente e recebidoTotalmente de cada item, e valorTotal do pedido como soma de quantidade x preço dos itens (valorTotalPedidoCalculado), além da quantidadePendente e aguardandoAprovacao do pedido. Lista os recebimentos do pedido e as entradas no estoque desses recebimentos, ordenados cronologicamente; valorTotal da entrada é quantidade x valor unitário e publicada é verdadeiro quando há momento de publicação (entradaPublicadaAoEstoque). Derivados são calculados, nunca gravados.",
        "output": "pedido: cabeçalho com itens, totais, data de envio e decisão (usado na análise, na decisão e nos eventos de envio e decisão do histórico); historico: recebimentos e entradas no estoque para a linha do tempo."
      }
    },
    {
      "id": "cmdAprovarPedido",
      "kind": "cmd",
      "when": "aprovarPedido",
      "writes": "PedidoCompra.aprovar",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PedidoCompra.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "PedidoCompra.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "pedido",
          "type": "PedidoAnalise"
        },
        {
          "name": "resumo",
          "type": "PedidoResumo"
        }
      ],
      "rules": [
        "valorLimiteAprovacao"
      ],
      "jsdoc": {
        "purpose": "Aprova o pedido que aguarda decisão do gerente, liberando-o ao fornecedor.",
        "input": "id e version do pedido em análise (concorrência otimista).",
        "processing": "Executa a transição aprovar (enviado → aprovado). Recusa se o pedido não estiver enviado ou não estiver aguardando aprovação, isto é, se o valor total não estiver acima do valor limite (valorLimiteAprovacao), ou se a versão divergir. O momento da decisão é registrado pela transição; aguardandoAprovacao e liberadoAoFornecedor passam a refletir a nova situação por cálculo.",
