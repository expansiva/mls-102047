  "endpoints": [
    {
      "id": "qryPainelCompras",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "mesReferencia",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "painelMes",
          "type": "IndicadoresMes"
        },
        {
          "name": "resumoSituacao",
          "type": "ResumoSituacao"
        },
        {
          "name": "aprovacoesPendentes",
          "type": "PedidoPendenteAprovacao[]"
        }
      ],
      "rules": [
        "totalCompradoConsideraPedidosAprovados",
        "pedidoAtrasadoPrevisaoVencida",
        "pedidoEmAbertoAteRecebimentoTotal",
        "valorLimiteAprovacao"
      ],
      "jsdoc": {
        "purpose": "Carrega de uma vez o que o painel do gerente mostra ao abrir: indicadores do mês, resumo da situação dos pedidos e a caixa de pedidos aguardando aprovação.",
        "input": "mesReferencia: início do mês a resumir; quando ausente, usa o mês corrente.",
        "processing": "Lê o agregado PainelCompras do mês (read.window): a linha sem fornecedor dá os totais da organização e as linhas por fornecedor formam o ranking ordenado por totalComprado desc, com o nome do fornecedor hidratado de uma vez no cadastro mestre. totalComprado segue totalCompradoConsideraPedidosAprovados (só liberados ou recebidos); pedidosEmAberto e pedidosAtrasados seguem pedidoEmAbertoAteRecebimentoTotal e pedidoAtrasadoPrevisaoVencida. O resumo conta (count) pedidos com aguardandoAprovacao, liberadoAoFornecedor e emAberto e soma quantidadePendente dos pedidos em aberto; tudo é derivado e calculado, nunca gravado. A caixa lista os pedidos enviados com aguardandoAprovacao verdadeiro (valorLimiteAprovacao), ordenados por dataEnvio, com nomes de fornecedor e comprador hidratados.",
        "output": "painelMes com totais e ranking por fornecedor; resumoSituacao com os números prontos; aprovacoesPendentes com id e version para decidir na hora."
      }
    },
    {
      "id": "qryPedidosAtrasados",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "pedidosAtrasados",
          "type": "PedidoAtrasado[]",
          "paginated": true
        }
      ],
      "rules": [
        "pedidoAtrasadoPrevisaoVencida",
        "pedidoEmAbertoAteRecebimentoTotal"
      ],
      "jsdoc": {
        "purpose": "Lista paginada dos pedidos atrasados para o gerente acompanhar e abrir.",
        "input": "page e pageSize: página pedida e tamanho da página.",
        "processing": "Filtra pedidos em aberto (enviado, aprovado ou recebidoParcial, pedidoEmAbertoAteRecebimentoTotal) com dataPrevistaEntrega anterior a hoje (pedidoAtrasadoPrevisaoVencida), ordenados pela entrega prevista mais antiga; hidrata o nome do fornecedor; valorTotal e quantidadePendente são derivados calculados.",
        "output": "{ items, page, pageSize, hasMore } com os pedidos atrasados; a página seguinte é anexada à lista."
      }
    },
    {
      "id": "cmdAprovarPedido",
      "kind": "cmd",
      "when": "aprovarPedido",
      "writes": "PedidoCompra.aprovar",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PedidoCompra.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "PedidoCompra.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "pedido",
          "type": "PedidoPendenteAprovacao"
        },
        {
          "name": "resumoSituacao",
          "type": "ResumoSituacao"
        },
        {
          "name": "painelMes",
          "type": "IndicadoresMes"
        }
      ],
      "rules": [
        "valorLimiteAprovacao"
      ],
      "jsdoc": {
        "purpose": "Aprova um pedido acima do valor limite, liberando-o ao fornecedor.",
        "input": "id e version do pedido (concorrência otimista).",
        "processing": "Executa a transição aprovar (enviado → aprovado); recusa se o pedido não estiver enviado aguardando aprovação (valorLimiteAprovacao) ou se a version divergir. decididoEm é registrado pela plataforma. Depois recalcula o resumo e lê o painel do mês atualizado.",
        "output": "O pedido com a nova situação (sai da caixa de pendentes), o resumo da situação e o painel do mês já atualizados, sem nova chamada."
      }
    },
    {
      "id": "cmdRejeitarPedido",
      "kind": "cmd",
      "when": "rejeitarPedido",
      "writes": "PedidoCompra.rejeitar",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PedidoCompra.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "PedidoCompra.version"
            ]
          }
        },
        {
          "name": "details.decisao.motivoRejeicao",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PedidoCompra.details.decisao.motivoRejeicao"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "pedido",
          "type": "PedidoPendenteAprovacao"
        },
        {
          "name": "resumoSituacao",
          "type": "ResumoSituacao"
        },
        {
          "name": "painelMes",
          "type": "IndicadoresMes"
        }
      ],
      "rules": [
        "valorLimiteAprovacao",
        "rejeicaoExigeMotivo"
      ],
      "jsdoc": {
        "purpose": "Rejeita um pedido acima do valor limite registrando o motivo.",
        "input": "id e version do pedido; motivoRejeicao: texto informado pelo gerente.",
        "processing": "Executa a transição rejeitar (enviado → rejeitado) gravando details.decisao.motivoRejeicao; recusa motivo vazio (rejeicaoExigeMotivo) e pedido que não esteja aguardando aprovação (valorLimiteAprovacao) ou com version divergente. decididoEm é registrado pela plataforma. Recalcula o resumo e lê o painel do mês atualizado.",
        "output": "O pedido rejeitado (sai da caixa), o resumo e o painel atualizados; a lista de atrasados é recarregada pois o pedido deixa de estar em aberto."
      }
    }
  ],
