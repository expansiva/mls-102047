{
  "types": [
    {
      "name": "PagadorIdentificacao",
      "description": "Nome e documento do pagador para o resumo, o extrato e a confirmação do pagamento.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Pagador.id"
            ]
          }
        },
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Pagador.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.docId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Pagador.details.identification.docId"
            ]
          }
        }
      ]
    },
    {
      "name": "ResumoPagador",
      "description": "Indicadores da posição do pagador, já calculados no servidor.",
      "fields": [
        {
          "name": "totalRecebido",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "TituloReceber.details.totalRecebido"
            ]
          }
        },
        {
          "name": "saldoAberto",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "TituloReceber.details.saldoAberto"
            ]
          }
        },
        {
          "name": "totalVencido",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "TituloReceber.details.saldoAberto",
              "TituloReceber.details.vencido"
            ]
          }
        },
        {
          "name": "quantidadeVencidos",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "TituloReceber.details.vencido"
            ]
          }
        }
      ]
    },
    {
      "name": "TituloPagador",
      "description": "Título do pagador com a situação e os dados de conferência usados na lista e no detalhe.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.version"
            ]
          }
        },
        {
          "name": "numero",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.numero"
            ]
          }
        },
        {
          "name": "origem",
          "type": "'restaurante' | 'academia' | 'assistenciaTecnica'",
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.origem"
            ]
          }
        },
        {
          "name": "emissao",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.emissao"
            ]
          }
        },
        {
          "name": "vencimento",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.vencimento"
            ]
          }
        },
        {
          "name": "details.valor",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.details.valor"
            ]
          }
        },
        {
          "name": "details.descricao",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.details.descricao"
            ]
          }
        },
        {
          "name": "details.origemRotulo",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.details.origemRotulo"
            ]
          }
        },
        {
          "name": "details.totalRecebido",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.details.totalRecebido"
            ]
          }
        },
        {
          "name": "details.saldoAberto",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.details.saldoAberto"
            ]
          }
        },
        {
          "name": "details.quitado",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.details.quitado"
            ]
          }
        },
        {
          "name": "details.parcialmenteRecebido",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.details.parcialmenteRecebido"
            ]
          }
        },
        {
          "name": "details.vencido",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.details.vencido"
            ]
          }
        },
        {
          "name": "details.diasAtraso",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "TituloReceber.details.diasAtraso"
            ]
          }
        }
      ]
    },
    {
      "name": "RecebimentoPagador",
      "description": "Recebimento de um título do pagador na linha do tempo, com estorno quando houver.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.id"
            ]
          }
        },
        {
          "name": "numero",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.numero"
            ]
          }
        },
        {
          "name": "tituloId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.tituloId"
            ]
          }
        },
        {
          "name": "recebidoEm",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.recebidoEm"
            ]
          }
        },
        {
          "name": "details.valor",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.details.valor"
            ]
          }
        },
        {
          "name": "formaPagamento",
          "type": "'dinheiro' | 'pix' | 'cartao'",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.formaPagamento"
            ]
          }
        },
        {
          "name": "status",
          "type": "'registrado' | 'estornado'",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.status"
            ]
          }
        },
        {
          "name": "details.baixaParcial",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.details.baixaParcial"
            ]
          }
        },
        {
          "name": "details.estorno.estornadoEm",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.details.estorno.estornadoEm"
            ]
          }
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "carregarPosicaoPagador",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "pagadorId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "pagador",
          "type": "PagadorIdentificacao"
        },
        {
          "name": "resumo",
          "type": "ResumoPagador"
        },
        {
          "name": "titulos",
          "type": "TituloPagador[]"
        },
        {
          "name": "recebimentos",
          "type": "RecebimentoPagador[]"
        }
      ],
      "rules": [
        "pagadorVeApenasProprios",
        "pagadorVeSomenteProprios",
        "saldoAbertoCalculado",
        "recebimentoEstornadoNaoConta",
        "estornoExcluiDoRecebido",
        "tituloQuitadoQuandoSaldoZera",
        "tituloVencidoEmAbertoAposVencimento"
      ],
      "jsdoc": {
        "purpose": "Carrega de uma vez a posição completa do pagador: identificação, indicadores, títulos com situação e histórico de recebimentos.",
        "input": "pagadorId: pagador vindo da URL quando quem acessa é o gerente financeiro; para o pagador no portal é ignorado e o pagador é resolvido pelo login da sessão (locate.byLogin).",
        "processing": "Resolve o pagador (pela sessão no portal, aplicando pagadorVeApenasProprios e pagadorVeSomenteProprios; pelo id para o gerente). Lê nome e documento no registro mestre. Lista os títulos do pagador (listByForeignKey) ordenados por vencimento e os recebimentos desses títulos ordenados por recebidoEm decrescente, incluindo estornados. Calcula por título totalRecebido somando recebimentos não estornados (recebimentoEstornadoNaoConta), saldoAberto = valor - totalRecebido nunca negativo (saldoAbertoCalculado), quitado e parcialmenteRecebido (tituloQuitadoQuandoSaldoZera), vencido e diasAtraso (tituloVencidoEmAbertoAposVencimento); por recebimento calcula baixaParcial. O resumo soma totalRecebido (sem estornos, estornoExcluiDoRecebido), saldoAberto, saldo vencido e conta os vencidos. Nada derivado é gravado.",
        "output": "pagador para cabeçalho e extrato; resumo com os números já prontos; titulos com tudo o que a lista e o detalhe mostram (o detalhe abre do item da lista sem nova chamada); recebimentos para a linha do tempo e o extrato."
      }
    },
    {
      "id": "pagarTituloComCartao",
      "kind": "cmd",
      "when": "pagarComCartao",
      "writes": "Recebimento.create",
      "input": [
        {
          "name": "tituloId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.tituloId"
            ]
          }
        },
        {
          "name": "cartaoToken",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "recebimento",
          "type": "RecebimentoPagador"
        },
        {
          "name": "titulo",
          "type": "TituloPagador"
        },
        {
          "name": "resumo",
          "type": "ResumoPagador"
        }
      ],
      "rules": [
        "portalSomenteCartao",
        "portalPagaSaldoIntegral",
        "pagadorVeSomenteProprios",
        "tituloQuitadoNaoRecebe",
        "recebimentoValorPositivo",
        "recebimentoNaoExcedeSaldo",
        "numeroRecebimentoUnico",
        "stripePagamentoUnico",
        "saldoAbertoCalculado",
        "tituloQuitadoQuandoSaldoZera"
      ],
      "jsdoc": {
        "purpose": "Paga com cartão via Stripe o saldo integral de um título em aberto do pagador logado e registra o recebimento.",
        "input": "tituloId: título escolhido na lista; cartaoToken: token do cartão gerado pelo Stripe no navegador, não gravado.",
        "processing": "Confirma que o título é do pagador da sessão (pagadorVeSomenteProprios) e que não está quitado (tituloQuitadoNaoRecebe). Calcula o saldo em aberto (saldoAbertoCalculado) e usa-o como valor (portalPagaSaldoIntegral), recusando valor não positivo ou acima do saldo (recebimentoValorPositivo, recebimentoNaoExcedeSaldo). Cobra o cartão no Stripe (portalSomenteCartao) e, ao confirmar, cria em transação o recebimento com formaPagamento cartao, canal portal, status registrado, stripePaymentIntentId único (stripePagamentoUnico) e número de sequence.next (numeroRecebimentoUnico). Recalcula o título (quitado pela tituloQuitadoQuandoSaldoZera) e o resumo do pagador; derivados não são gravados.",
        "output": "recebimento criado para a linha do tempo e confirmação, o título atualizado (quitado, saldo zero) para a lista e o detalhe, e o resumo recalculado; a página não precisa recarregar."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "resumoPagador",
        "reads": "carregarPosicaoPagador.pagador"
      },
      {
        "organism": "resumoPagador",
        "reads": "carregarPosicaoPagador.resumo"
      },
      {
        "organism": "titulosDoPagador",
        "reads": "carregarPosicaoPagador.titulos"
      },
      {
        "organism": "detalheTitulo",
        "reads": "carregarPosicaoPagador.titulos"
      },
      {
        "organism": "recebimentosDoPagador",
        "reads": "carregarPosicaoPagador.recebimentos"
      },
      {
        "organism": "acoesExtratoPagamento",
        "reads": "carregarPosicaoPagador.pagador"
      },
      {
        "organism": "acoesExtratoPagamento",
        "reads": "carregarPosicaoPagador.titulos"
      }
    ],
    "commands": [
      {
        "endpoint": "pagarTituloComCartao",
        "refreshes": []
      }
    ],
    "selections": [
      {
        "organism": "titulosDoPagador",
        "via": {
          "list": "carregarPosicaoPagador.titulos"
        }
      }
    ],
    "journeys": [
      {
        "step": "consultarMeusTitulos/listarMeusTitulos",
        "organisms": [
          "resumoPagador",
          "titulosDoPagador"
        ],
        "endpoints": [
          "carregarPosicaoPagador"
        ]
      },
      {
        "step": "consultarMeusTitulos/verMeuTitulo",
        "organisms": [
          "detalheTitulo",
          "recebimentosDoPagador"
        ],
        "endpoints": [
          "carregarPosicaoPagador"
        ]
      },
      {
        "step": "emitirExtratoPagador/localizarPagador",
        "organisms": [
          "resumoPagador"
        ],
        "endpoints": [
          "carregarPosicaoPagador"
        ]
      },
      {
        "step": "emitirExtratoPagador/verExtrato",
        "organisms": [
          "titulosDoPagador",
          "recebimentosDoPagador",
          "resumoPagador"
        ],
        "endpoints": [
          "carregarPosicaoPagador"
        ]
      },
      {
        "step": "emitirExtratoPagador/emitirExtrato",
        "organisms": [
          "acoesExtratoPagamento"
        ],
        "endpoints": [
          "carregarPosicaoPagador"
        ]
      },
      {
        "step": "pagarTituloCartao/localizarTituloAberto",
        "organisms": [
          "titulosDoPagador"
        ],
        "endpoints": [
          "carregarPosicaoPagador"
        ]
      },
      {
        "step": "pagarTituloCartao/conferirValor",
        "organisms": [
          "detalheTitulo"
        ],
        "endpoints": [
          "carregarPosicaoPagador"
        ]
      },
      {
        "step": "pagarTituloCartao/pagarComCartao",
        "organisms": [
          "acoesExtratoPagamento"
        ],
        "endpoints": [
          "pagarTituloComCartao"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "pagarTituloComCartao",
        "state": "carregarPosicaoPagador.titulos",
        "mode": "upsert"
      },
      {
        "endpoint": "pagarTituloComCartao",
        "state": "carregarPosicaoPagador.recebimentos",
        "mode": "upsert"
      },
      {
        "endpoint": "pagarTituloComCartao",
        "state": "carregarPosicaoPagador.resumo",
        "mode": "replace"
      }
    ]
  }
}
