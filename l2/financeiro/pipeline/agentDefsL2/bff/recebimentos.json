        ]
      }
    ],
    "updates": [
      {
        "endpoint": "listarRecebimentos",
        "state": "listarRecebimentos.recebimentos",
        "mode": "append"
      },
      {
        "endpoint": "buscarTitulosAbertos",
        "state": "buscarTitulosAbertos.titulos",
        "mode": "replace"
      },
      {
        "endpoint": "obterRecebimento",
        "state": "obterRecebimento.recebimento",
        "mode": "replace"
      },
      {
        "endpoint": "registrarRecebimento",
        "state": "listarRecebimentos.recebimentos",
        "mode": "upsert"
      },
      {
        "endpoint": "registrarRecebimento",
        "state": "buscarTitulosAbertos.titulos",
        "mode": "upsert"
      },
      {
        "endpoint": "estornarRecebimento",
        "state": "obterRecebimento.recebimento",
        "mode": "replace"
      },
