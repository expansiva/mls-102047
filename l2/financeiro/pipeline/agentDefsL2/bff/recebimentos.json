  "endpoints": [
    {
      "id": "listarRecebimentos",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "numero",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.numero"
            ]
          }
        },
        {
          "name": "recebidoEm",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.recebidoEm"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "recebimentos",
          "type": "RecebimentoItem[]",
          "paginated": true
        }
      ],
      "rules": [
        "estornoSomenteMesmoDia"
      ],
      "jsdoc": {
        "purpose": "Lista paginada dos recebimentos da organização para o caixa e o gerente localizarem um recebimento e verem quais ainda podem ser estornados hoje.",
        "input": "page/pageSize: página da lista; numero: filtro opcional pelo número do recebimento; recebidoEm: filtro opcional pela data (dia) de recebimento.",
        "processing": "Filtra os recebimentos da organização por número e/ou dia de recebimento, ordenados do mais recente para o mais antigo; resolve o número do título e o nome do pagador (read.mdmRecord). Calcula details.estornavel conforme estornoSomenteMesmoDia: status registrado e recebidoEm no dia de hoje; não é gravado.",
        "output": "Página { items, page, pageSize, hasMore } de RecebimentoItem pronta para a lista, com destaque dos estornáveis."
      }
    },
    {
      "id": "obterRecebimento",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "recebimentoId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "recebimento",
          "type": "RecebimentoDetalhe"
        }
      ],
      "rules": [
        "estornoSomenteMesmoDia",
        "saldoAbertoCalculado",
        "recebimentoEstornadoNaoConta"
      ],
      "jsdoc": {
        "purpose": "Carrega o recebimento selecionado na lista para conferência e eventual estorno.",
        "input": "recebimentoId: id do recebimento escolhido na lista.",
        "processing": "Lê o recebimento por id, o título baixado com seu saldo em aberto (saldoAbertoCalculado: valor do título menos recebimentos não estornados, recebimentoEstornadoNaoConta) e o nome do pagador. Calcula estornavel (estornoSomenteMesmoDia) e baixaParcial; campos derivados não são gravados.",
        "output": "RecebimentoDetalhe com versão, título e saldo, pagador e dados do estorno quando houver; alimenta o detalhe e as ações de estorno."
      }
    },
    {
      "id": "buscarTitulosAbertos",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "titulos",
          "type": "TituloAberto[]",
          "paginated": true
        }
      ],
      "rules": [
        "tituloQuitadoNaoRecebe",
        "saldoAbertoCalculado",
        "recebimentoEstornadoNaoConta"
      ],
      "jsdoc": {
        "purpose": "Busca os títulos em aberto que o caixa pode receber no formulário de registro.",
        "input": "busca: texto opcional com número do título, referência de origem ou nome/documento do pagador; page/pageSize: página.",
        "processing": "Retorna apenas títulos não quitados (tituloQuitadoNaoRecebe), ordenados por vencimento; calcula o saldo em aberto como valor menos recebimentos não estornados (saldoAbertoCalculado, recebimentoEstornadoNaoConta); resolve nome e documento do pagador.",
        "output": "Página { items, page, pageSize, hasMore } de TituloAberto com valor, saldo e vencimento para o caixa escolher e não exceder o devido."
      }
    },
    {
      "id": "registrarRecebimento",
      "kind": "cmd",
      "when": "registrarRecebimento",
      "writes": "Recebimento.create",
      "input": [
        {
          "name": "tituloId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.tituloId"
            ]
          }
        },
        {
          "name": "details.valor",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.details.valor"
            ]
          }
        },
        {
          "name": "formaPagamento",
          "type": "'dinheiro' | 'pix' | 'cartao'",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.formaPagamento"
            ]
          }
        },
        {
          "name": "details.observacao",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.details.observacao"
            ]
          }
        },
        {
          "name": "stripePaymentIntentId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.stripePaymentIntentId"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "recebimento",
          "type": "RecebimentoItem"
        },
        {
          "name": "titulo",
          "type": "TituloAberto"
        }
      ],
      "rules": [
        "recebimentoValorPositivo",
        "recebimentoNaoExcedeSaldo",
        "tituloQuitadoNaoRecebe",
        "formaPagamentoPermitida",
        "numeroRecebimentoUnico",
        "stripePagamentoUnico",
        "tituloQuitadoQuandoSaldoZera",
        "saldoAbertoCalculado"
      ],
      "jsdoc": {
        "purpose": "Registra no caixa o recebimento total ou parcial de um título.",
        "input": "tituloId: título baixado; valor: valor recebido; formaPagamento: dinheiro, pix ou cartão; observacao: anotação livre; stripePaymentIntentId: identificador da cobrança no Stripe, obrigatório quando a forma é cartão.",
        "processing": "Em transação: recusa valor <= 0 (recebimentoValorPositivo), valor maior que o saldo em aberto (recebimentoNaoExcedeSaldo), título quitado (tituloQuitadoNaoRecebe), forma fora de dinheiro/pix/cartão (formaPagamentoPermitida), cartão sem identificador Stripe ou com identificador já usado (stripePagamentoUnico). Emite o número por sequence.next (numeroRecebimentoUnico), grava status registrado, canal caixa e recebidoEm pelo sistema. O saldo do título é recalculado (saldoAbertoCalculado) e quitado quando zera (tituloQuitadoQuandoSaldoZera); baixaParcial é derivada, não gravada.",
        "output": "O recebimento criado como linha da lista e o título com saldo atualizado, para a página redesenhar lista e formulário sem nova chamada."
      }
    },
    {
      "id": "estornarRecebimento",
      "kind": "cmd",
      "when": "estornarRecebimento",
      "writes": "Recebimento.estornar",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.version"
            ]
          }
        },
        {
          "name": "details.estorno.motivo",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Recebimento.details.estorno.motivo"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "recebimento",
          "type": "RecebimentoDetalhe"
        },
        {
          "name": "recebimentoItem",
          "type": "RecebimentoItem"
        }
      ],
      "rules": [
        "estornoExigeMotivo",
        "estornoSomenteMesmoDia",
        "estornoRestabeleceSaldo",
        "recebimentoEstornadoNaoConta"
      ],
      "jsdoc": {
        "purpose": "Estorna, pelo caixa, um recebimento registrado por engano no mesmo dia.",
        "input": "id e version: recebimento e versão para concorrência otimista; motivo: motivo do estorno.",
        "processing": "Apenas o ator caixa. Recusa motivo vazio (estornoExigeMotivo) e recebimento que não esteja registrado ou não seja de hoje (estornoSomenteMesmoDia). Em transação, move para estornado, grava o motivo e estornadoEm pelo sistema; o recebimento deixa de contar no total recebido (recebimentoEstornadoNaoConta) e o saldo do título é restabelecido, deixando de estar quitado se voltar a ter saldo (estornoRestabeleceSaldo).",
        "output": "O recebimento estornado completo, com o saldo do título restabelecido, para o detalhe, e a linha atualizada para a lista."
      }
    }
  ],
  "bindings": {
