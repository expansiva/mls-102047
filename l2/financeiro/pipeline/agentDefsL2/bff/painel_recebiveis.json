  "endpoints": [
    {
      "id": "qryPainelRecebiveis",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "periodoInicio",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "periodoFim",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "origem",
          "type": "'restaurante' | 'academia' | 'assistenciaTecnica'",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pagadorBusca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "porOrigem",
          "type": "PosicaoOrigem[]"
        },
        {
          "name": "resumoVencidos",
          "type": "ResumoVencidos"
        },
        {
          "name": "vencidos",
          "type": "TituloVencidoLinha[]",
          "paginated": true
        }
      ],
      "rules": [
        "painelSomenteGerenteFinanceiro",
        "painelTotaisCalculados",
        "estornoExcluiDoRecebido",
        "tituloVencidoEmAbertoAposVencimento",
        "saldoAbertoCalculado"
      ],
      "jsdoc": {
        "purpose": "Carrega de uma vez o painel de recebíveis do período escolhido: os totais por origem, o resumo dos vencidos e a primeira página da lista de títulos vencidos. É chamada de novo quando o gerente troca período, origem ou busca de pagador.",
        "input": "periodoInicio/periodoFim: janela de datas do período (padrão: mês corrente); origem: filtra uma origem (restaurante, academia, assistência técnica), ausente = todas; pagadorBusca: nome ou documento do pagador para restringir a lista de vencidos; pageSize: tamanho da primeira página da lista.",
        "processing": "Acesso somente ao gerente financeiro (painelSomenteGerenteFinanceiro). Lê o painel pela janela (read.window) e soma as linhas diárias por origem: totalAReceber, totalRecebido, totalEmAberto, quantidadeTitulos e quantidadeRecebimentos (painelTotaisCalculados; estornos excluídos do recebido e da quantidade, estornoExcluiDoRecebido). Soma totalVencido e quantidadeVencidos do período/origem para o resumo. A lista traz títulos com vencimento no período, saldo em aberto > 0 e vencimento anterior a hoje (tituloVencidoEmAbertoAposVencimento; saldo = valor − recebimentos não estornados, saldoAbertoCalculado), com nome do pagador do registro mestre, ordenada por diasAtraso decrescente, página 1. Campos derivados são calculados, nunca gravados.",
        "output": "porOrigem: uma posição por origem com os totais já calculados; resumoVencidos: valor e quantidade vencidos; vencidos: primeira página { items, page, pageSize, hasMore } da lista de vencidos."
      }
    },
    {
      "id": "qryVencidosPagina",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "periodoInicio",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "periodoFim",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "origem",
          "type": "'restaurante' | 'academia' | 'assistenciaTecnica'",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pagadorBusca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "vencidos",
          "type": "TituloVencidoLinha[]",
          "paginated": true
        }
      ],
      "rules": [
        "painelSomenteGerenteFinanceiro",
        "tituloVencidoEmAbertoAposVencimento",
        "saldoAbertoCalculado"
      ],
      "jsdoc": {
        "purpose": "Traz as páginas seguintes da lista de títulos vencidos quando o gerente rola ou pede mais.",
        "input": "Os mesmos filtros do painel (periodoInicio, periodoFim, origem, pagadorBusca) e page/pageSize da página pedida.",
        "processing": "Somente gerente financeiro (painelSomenteGerenteFinanceiro). Filtra títulos do período/origem/pagador com saldo em aberto e vencimento anterior a hoje (tituloVencidoEmAbertoAposVencimento), saldo calculado como valor menos recebimentos não estornados (saldoAbertoCalculado), dias de atraso calculados até hoje; ordena por diasAtraso decrescente e lê o nome do pagador no registro mestre.",
        "output": "vencidos: { items, page, pageSize, hasMore } que a página acrescenta à lista já exibida."
      }
    },
    {
      "id": "qryTituloVencido",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "tituloId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "titulo",
          "type": "TituloVencidoDetalhe"
        }
      ],
      "rules": [
        "painelSomenteGerenteFinanceiro",
        "saldoAbertoCalculado",
        "recebimentoEstornadoNaoConta",
        "tituloQuitadoQuandoSaldoZera",
        "tituloVencidoEmAbertoAposVencimento"
      ],
      "jsdoc": {
        "purpose": "Abre o título vencido selecionado na lista com pagador, valores, atraso e todos os recebimentos, inclusive estornados.",
        "input": "tituloId: id do título escolhido na lista de vencidos.",
        "processing": "Somente gerente financeiro (painelSomenteGerenteFinanceiro). Lê o título por id, o nome e o documento do pagador no registro mestre e os recebimentos do título (listByForeignKey) ordenados por recebidoEm. totalRecebido exclui estornados (recebimentoEstornadoNaoConta); saldoAberto = valor − totalRecebido, nunca negativo (saldoAbertoCalculado); parcialmenteRecebido conforme tituloQuitadoQuandoSaldoZera; diasAtraso conforme tituloVencidoEmAbertoAposVencimento. Tudo calculado na leitura.",
        "output": "titulo: o detalhe completo com a lista de recebimentos, para a página exibir sem outra chamada."
      }
    }
  ],
