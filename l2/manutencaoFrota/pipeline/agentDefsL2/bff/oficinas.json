  "endpoints": [
    {
      "id": "listarOficinas",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "oficinas",
          "type": "OficinaResumo[]",
          "paginated": true
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Lista as oficinas da transportadora para o gestor localizar e escolher qual abrir no formulário; é chamada ao abrir a página e novamente ao buscar ou pedir a próxima página.",
        "input": "busca: texto opcional comparado ao nome da oficina ou ao número do documento (CNPJ); page e pageSize: página solicitada e tamanho da página.",
        "processing": "Filtra as oficinas da organização do gestor (escopo organization). Com busca, localiza por nome (locate.byName) ou por documento (locate.byDocument), ignorando pontuação do CNPJ. Ordena por nome. A situação (status) é lida do cadastro mestre, nunca calculada aqui.",
        "output": "Página { items, page, pageSize, hasMore } de oficinas com id, nome, tipo e número do documento, situação, razão social e nome fantasia, já no formato das linhas da lista."
      }
    },
    {
      "id": "obterOficina",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "oficina",
          "type": "OficinaFicha"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Carrega a ficha completa da oficina selecionada na lista para edição no formulário.",
        "input": "id: identificador da oficina selecionada na lista.",
        "processing": "Lê a oficina pelo id (read.byId) dentro da organização do gestor e devolve identificação, dados de pessoa jurídica, outros nomes, endereço, contatos e observações. Contatos é um resumo derivado dos vínculos HasContact, apenas lido. Devolve a versão para controle de concorrência na atualização.",
        "output": "A oficina com id, versão e detalhes, para preencher o formulário."
      }
    },
    {
      "id": "cadastrarOficina",
      "kind": "cmd",
      "when": "cadastrarOficina",
      "writes": "Oficina.create",
      "input": [
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
