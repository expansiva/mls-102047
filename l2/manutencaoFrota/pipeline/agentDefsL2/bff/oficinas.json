          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Oficina.details.identification.docType"
            ]
          }
        },
        {
          "name": "details.identification.docId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Oficina.details.identification.docId"
            ]
          }
        },
        {
          "name": "details.identification.countryCode",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Oficina.details.identification.countryCode"
            ]
          }
        },
        {
          "name": "details.company.companyKind",
          "type": "'LegalEntity' | 'Branch' | 'Franchise'",
          "origin": {
            "kind": "field",
            "paths": [
              "Oficina.details.company.companyKind"
            ]
          }
        },
        {
          "name": "details.company.legalName",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Oficina.details.company.legalName"
            ]
          }
        },
        {
          "name": "details.company.tradeName",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Oficina.details.company.tradeName"
            ]
          }
        },
        {
          "name": "details.base.aliases",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Oficina.details.base.aliases"
            ]
          }
        },
        {
          "name": "details.base.addresses",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Oficina.details.base.addresses"
            ]
          }
        },
        {
          "name": "details.base.notes",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Oficina.details.base.notes"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "oficina",
          "type": "OficinaFicha"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Cadastra uma nova oficina da frota (ou vincula uma empresa já existente com o papel de oficina).",
        "input": "Nome, tipo e número do documento, país, tipo de organização, razão social, nome fantasia, outros nomes, endereço e observações informados no formulário.",
        "processing": "Antes de criar, procura empresa com o mesmo documento (locate.byDocument) para evitar duplicidade e, se existir, vincula-a (register.createOrAttach). Valida o formato do documento conforme o tipo e exige a razão social. O subtipo é sempre Company; id, versão e situação inicial são definidos pelo motor, nunca recebidos.",
        "output": "A oficina criada com id, versão e detalhes, para o formulário passar ao modo de atualização sem nova chamada."
      }
    },
