          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Veiculo.modelo"
            ]
          }
        },
        {
          "name": "motoristaId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Veiculo.motoristaId"
            ]
          }
        },
        {
          "name": "details",
