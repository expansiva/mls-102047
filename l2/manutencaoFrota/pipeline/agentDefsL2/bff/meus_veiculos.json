          "type": "MotoristaDetalhes"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "carregarMeusVeiculos",
      "kind": "qry",
      "when": "onLoad",
      "input": [],
      "output": [
        {
          "name": "motorista",
          "type": "MotoristaAtual"
        },
        {
          "name": "veiculos",
          "type": "MeuVeiculo[]"
        }
      ],
      "rules": [
        "motoristaVeSomenteVeiculosAtribuidos",
        "motoristaVeSomenteSeusAbastecimentos",
        "precoPorLitroCalculado"
      ],
      "jsdoc": {
        "purpose": "Carrega de uma vez tudo o que a página Meus veículos mostra ao abrir: o motorista logado e os veículos atribuídos a ele, cada um com seus dados de ficha e o último abastecimento registrado.",
        "input": "Sem entrada: o motorista vem da sessão.",
        "processing": "Identifica o motorista da sessão e lê nome e situação no cadastro mestre. Lista os veículos por Veiculo.motoristaId igual ao motorista (motoristaVeSomenteVeiculosAtribuidos), sem paginação, pois um motorista tem poucos veículos. Para todos os veículos de uma vez, busca o abastecimento mais recente por data registrado pelo próprio motorista (motoristaVeSomenteSeusAbastecimentos). O preço por litro é campo derivado, calculado como valor dividido por litros (precoPorLitroCalculado), nunca gravado.",
        "output": "motorista com nome e situação (para a ficha e para avisar se inativo não pode lançar) e a lista de veículos com placa, modelo, ano, quilometragem atual e último abastecimento (data, km no painel, preço por litro); serve a lista, a ficha (seleção na própria lista), o formulário e o resumo."
      }
    },
    {
      "id": "lancarAbastecimento",
      "kind": "cmd",
      "when": "lancarAbastecimento",
      "writes": "Abastecimento.create",
      "input": [
        {
          "name": "veiculoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Abastecimento.veiculoId"
            ]
          }
        },
        {
          "name": "motoristaId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Abastecimento.motoristaId"
            ]
          }
        },
        {
          "name": "data",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Abastecimento.data"
            ]
          }
        },
        {
          "name": "details.litros",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Abastecimento.details.litros"
            ]
          }
        },
        {
          "name": "details.valor",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Abastecimento.details.valor"
            ]
          }
        },
        {
          "name": "details.kmPainel",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Abastecimento.details.kmPainel"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "veiculo",
          "type": "MeuVeiculo"
        }
      ],
      "rules": [
        "abastecimentoSomenteVeiculoAtribuido",
        "litrosEValorPositivos",
        "kmPainelNaoMenorQueAtual",
        "kmPainelAtualizaQuilometragemVeiculo",
        "quilometragemNaoRegride",
        "precoPorLitroCalculado"
      ],
      "jsdoc": {
        "purpose": "Registra o abastecimento do veículo escolhido e atualiza a quilometragem atual dele numa só operação.",
        "input": "veiculoId: veículo abastecido, escolhido na lista; motoristaId: motorista logado que registra o abastecimento (a página envia o da sessão e o servidor confere que é o mesmo); data: data do abastecimento; litros: quantidade abastecida; valor: valor total pago; kmPainel: quilometragem marcada no painel.",
        "processing": "Recusa se motoristaId diferir do motorista da sessão, se ele estiver inativo ou se o veículo não estiver atribuído a ele (abastecimentoSomenteVeiculoAtribuido). Recusa litros ou valor menores ou iguais a zero (litrosEValorPositivos). Recusa kmPainel menor que a quilometragem atual do veículo (kmPainelNaoMenorQueAtual, quilometragemNaoRegride). Em transação tudo ou nada, cria o Abastecimento e grava kmPainel como nova quilometragem atual do veículo (kmPainelAtualizaQuilometragemVeiculo). O preço por litro é derivado, calculado como valor/litros na leitura (precoPorLitroCalculado), não gravado.",
        "output": "O veículo atualizado, com a nova quilometragem atual e o abastecimento recém-lançado como último, para a página redesenhar lista, ficha, formulário e resumo sem nova chamada."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "listaVeiculos",
        "reads": "carregarMeusVeiculos.veiculos"
      },
      {
        "organism": "fichaVeiculo",
        "reads": "carregarMeusVeiculos.veiculos"
      },
      {
        "organism": "fichaVeiculo",
        "reads": "carregarMeusVeiculos.motorista"
      },
      {
        "organism": "registrarAbastecimento",
        "reads": "carregarMeusVeiculos.veiculos"
      },
      {
        "organism": "registrarAbastecimento",
        "reads": "carregarMeusVeiculos.motorista"
      },
      {
        "organism": "resumoVeiculos",
        "reads": "carregarMeusVeiculos.veiculos"
      }
    ],
    "commands": [
      {
        "endpoint": "lancarAbastecimento",
        "refreshes": []
      }
    ],
    "selections": [
      {
        "organism": "listaVeiculos",
        "via": {
          "list": "carregarMeusVeiculos.veiculos"
        }
      },
      {
        "organism": "fichaVeiculo",
        "via": {
          "list": "carregarMeusVeiculos.veiculos"
        }
      }
    ],
    "journeys": [
      {
        "step": "registrarAbastecimento/localizarVeiculo",
        "organisms": [
          "listaVeiculos"
        ],
        "endpoints": [
          "carregarMeusVeiculos"
        ]
      },
      {
        "step": "registrarAbastecimento/conferirVeiculo",
        "organisms": [
          "fichaVeiculo"
        ],
        "endpoints": [
          "carregarMeusVeiculos"
        ]
      },
      {
        "step": "registrarAbastecimento/lancarAbastecimento",
        "organisms": [
          "registrarAbastecimento"
        ],
        "endpoints": [
          "lancarAbastecimento"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "lancarAbastecimento",
        "state": "carregarMeusVeiculos.veiculos",
        "mode": "upsert"
      }
    ]
  }
}
