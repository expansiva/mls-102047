  "endpoints": [
    {
      "id": "qryPlanosLista",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "situacao",
          "type": "'todos' | 'vencidos' | 'vencidoPorKm' | 'vencidoPorTempo'",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "veiculoId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "planos",
          "type": "PlanoItem[]",
          "paginated": true
        }
      ],
      "rules": [
        "planoVencimentoCalculado",
        "avisoPreventivaVencidaKm"
      ],
      "jsdoc": {
        "purpose": "Carrega a lista paginada dos planos de preventiva da organização, já com o veículo e a situação de vencimento, filtrável pelos vencidos por km ou por tempo.",
        "input": "situacao: 'todos' (padrão), 'vencidos' (por km ou tempo), 'vencidoPorKm' ou 'vencidoPorTempo'; busca: texto na descrição do plano ou placa; veiculoId: restringe aos planos de um veículo (ao conferir os planos existentes antes de criar um novo); page e pageSize: paginação.",
        "processing": "Lista PlanoManutencao com o Veiculo de cada plano (listByForeignKey em lote, sem N+1). Os derivados kmPrevisto, dataPrevista, vencidoPorKm, vencidoPorTempo, kmExcedido e temOrdemAberta são calculados no servidor conforme planoVencimentoCalculado (última preventiva concluída ou referência + intervalo) e avisoPreventivaVencidaKm (quilometragem atual > km previsto); temOrdemAberta verifica ordem do plano com status open. Nada é gravado. Ordena vencidos primeiro, por kmExcedido decrescente, depois pela descrição.",
        "output": "planos: página { items, page, pageSize, hasMore } de PlanoItem, pronta para a lista destacar os vencidos e onde agir primeiro."
      }
    },
    {
      "id": "qryPlanoDetalhe",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "planoId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "plano",
          "type": "PlanoDetalhe"
        }
      ],
      "rules": [
        "planoVencimentoCalculado",
        "avisoPreventivaVencidaKm",
        "planoUmaOrdemAberta"
      ],
      "jsdoc": {
        "purpose": "Abre o plano escolhido na lista ou vindo do aviso de preventiva vencida, com o veículo, o vencimento e a ordem aberta.",
        "input": "planoId: id do plano selecionado na lista ou recebido pela URL do aviso.",
        "processing": "Lê o PlanoManutencao por id, o Veiculo (placa e quilometragem atual) e a ordem do plano com status open, se houver (planoUmaOrdemAberta garante no máximo uma). Calcula kmUltimaPreventiva, dataUltimaPreventiva, kmPrevisto, dataPrevista, kmExcedido, vencidoPorKm, vencidoPorTempo e temOrdemAberta conforme planoVencimentoCalculado e avisoPreventivaVencidaKm; diasNaOficina da ordem é contado até hoje. Nada é gravado.",
        "output": "plano: PlanoDetalhe com veículo e ordemManutencao opcional, para a ficha e para habilitar a ação de abrir ordem."
      }
    },
    {
      "id": "qryVeiculosBusca",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "veiculos",
          "type": "VeiculoOpcao[]"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Localiza o veículo pela placa ou modelo para definir o plano de preventiva.",
        "input": "busca: parte da placa ou do modelo digitada pelo gestor.",
        "processing": "Veiculo locate.byText em placa e modelo, escopo da organização, limitado a 20 resultados ordenados pela placa.",
        "output": "veiculos: opções com id, placa, modelo e quilometragem atual, para escolher o veículo e sugerir o km de referência."
      }
    },
    {
      "id": "qryOficinas",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "oficinas",
          "type": "OficinaOpcao[]"
        }
      ],
      "rules": [
        "oficinaInativaSemNovasOrdens"
      ],
      "jsdoc": {
        "purpose": "Lista as oficinas que podem receber a ordem preventiva.",
        "input": "busca: parte do nome da oficina (opcional).",
        "processing": "Oficina locate.byName no cadastro mestre; conforme oficinaInativaSemNovasOrdens retorna só oficinas com status Active, limitado a 20, ordenadas pelo nome.",
        "output": "oficinas: id, nome e situação para o seletor de oficina da ação de abrir ordem."
      }
    },
    {
      "id": "cmdSalvarPlano",
      "kind": "cmd",
      "when": "salvarPlano",
      "writes": "PlanoManutencao.create",
      "input": [
        {
          "name": "veiculoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PlanoManutencao.veiculoId"
            ]
          }
        },
        {
          "name": "descricao",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PlanoManutencao.descricao"
            ]
          }
        },
        {
          "name": "details.intervaloKm",
          "type": "number",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "PlanoManutencao.details.intervaloKm"
            ]
          }
        },
        {
          "name": "details.intervaloMeses",
          "type": "number",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "PlanoManutencao.details.intervaloMeses"
            ]
          }
        },
        {
          "name": "details.kmReferencia",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "PlanoManutencao.details.kmReferencia"
            ]
          }
        },
        {
          "name": "details.dataReferencia",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PlanoManutencao.details.dataReferencia"
            ]
          }
        },
        {
          "name": "details.observacoes",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "PlanoManutencao.details.observacoes"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "plano",
          "type": "PlanoItem"
        }
      ],
      "rules": [
        "planoIntervaloObrigatorio",
        "planoVencimentoCalculado",
        "avisoPreventivaVencidaKm"
      ],
      "jsdoc": {
        "purpose": "Cria o plano de preventiva do veículo.",
        "input": "veiculoId: veículo escolhido; descricao: o que a preventiva faz; intervaloKm e/ou intervaloMeses: periodicidade; kmReferencia e dataReferencia: início da contagem; observacoes: orientações opcionais.",
        "processing": "Recusa quando nenhum intervalo é informado ou algum informado não é maior que zero (planoIntervaloObrigatorio). Grava o PlanoManutencao.create. Os derivados não são gravados: kmPrevisto, dataPrevista, vencidoPorKm, vencidoPorTempo e kmExcedido são calculados na resposta conforme planoVencimentoCalculado e avisoPreventivaVencidaKm.",
        "output": "plano: o novo PlanoItem com veículo e vencimento, inserido na lista sem nova consulta."
      }
    },
    {
      "id": "cmdAbrirOrdemPreventiva",
      "kind": "cmd",
      "when": "abrirOrdemPreventiva",
      "writes": "OrdemManutencao.create",
      "input": [
        {
          "name": "planoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdemManutencao.planoId"
            ]
          }
        },
        {
          "name": "veiculoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdemManutencao.veiculoId"
            ]
          }
        },
        {
          "name": "tipo",
          "type": "'preventive' | 'corrective'",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdemManutencao.tipo"
            ]
          }
        },
        {
          "name": "oficinaId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdemManutencao.oficinaId"
            ]
          }
        },
        {
          "name": "details.descricao",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdemManutencao.details.descricao"
            ]
          }
        },
        {
          "name": "dataEntrada",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdemManutencao.dataEntrada"
            ]
          }
        },
        {
          "name": "details.kmEntrada",
          "type": "number",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "OrdemManutencao.details.kmEntrada"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "plano",
          "type": "PlanoDetalhe"
        }
      ],
      "rules": [
        "ordemPreventivaExigePlano",
        "oficinaInativaSemNovasOrdens",
        "planoUmaOrdemAberta",
        "numeroOrdemUnico",
        "planoVencimentoCalculado"
      ],
      "jsdoc": {
        "purpose": "Abre a ordem de manutenção preventiva para o plano vencido.",
        "input": "planoId e veiculoId: plano selecionado e seu veículo; tipo: sempre 'preventive'; oficinaId: oficina escolhida; descricao: serviço a executar; dataEntrada: entrada na oficina; kmEntrada: quilometragem na entrada (opcional, sugerida pela quilometragem atual).",
        "processing": "Recusa se o plano não existe ou não é do mesmo veículo (ordemPreventivaExigePlano), se a oficina não está Active (oficinaInativaSemNovasOrdens) ou se o plano já tem ordem open (planoUmaOrdemAberta). Grava OrdemManutencao.create com status open e número emitido pela sequência do módulo (numeroOrdemUnico). Relê o plano com vencimento recalculado (planoVencimentoCalculado) e a ordem aberta; derivados não são gravados.",
