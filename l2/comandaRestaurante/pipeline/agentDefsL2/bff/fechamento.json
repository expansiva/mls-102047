{
  "types": [
    {
      "name": "ComandaAbertaResumo",
      "description": "Resumo de uma comanda aberta para a lista de localização do caixa.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.id"
            ]
          }
        },
        {
          "name": "number",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.number"
            ]
          }
        },
        {
          "name": "status",
          "type": "'open' | 'closed'",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.status"
            ]
          }
        },
        {
          "name": "mesaId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.mesaId"
            ]
          }
        },
        {
          "name": "mesaCode",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Mesa.code"
            ]
          }
        },
        {
          "name": "totalComanda",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.details.totalComanda"
            ]
          }
        }
      ]
    },
    {
      "name": "PaginaComandasAbertas",
      "description": "Página de comandas abertas, com o total calculado para a navegação da lista.",
      "fields": [
        {
          "name": "items",
          "type": "ComandaAbertaResumo[]"
        },
        {
          "name": "totalOpenComandas",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Comanda.id",
              "Comanda.status"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ]
    },
    {
      "name": "LinhaComandaFechamento",
      "description": "Item da comanda apresentado ao caixa para conferir a cobrança.",
      "fields": [
        {
          "name": "itemCardapioId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.itemCardapioId"
            ]
          }
        },
        {
          "name": "itemName",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemCardapio.name"
            ]
          }
        },
        {
          "name": "status",
          "type": "'launched' | 'canceled'",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.status"
            ]
          }
        },
        {
          "name": "quantidade",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.details.quantidade"
            ]
          }
        },
        {
          "name": "observacao",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.details.observacao"
            ]
          }
        },
        {
          "name": "precoUnitario",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.details.precoUnitario"
            ]
          }
        },
        {
          "name": "valorTotal",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.details.valorTotal"
            ]
          }
        }
      ]
    },
    {
      "name": "ComandaParaFechamento",
      "description": "Comanda escolhida, com seus itens, totais de conferência e situação da mesa após o fechamento.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.version"
            ]
          }
        },
        {
          "name": "number",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.number"
            ]
          }
        },
        {
          "name": "status",
          "type": "'open' | 'closed'",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.status"
            ]
          }
        },
        {
          "name": "mesaId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.mesaId"
            ]
          }
        },
        {
          "name": "mesaDisponivel",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Mesa.details.disponivel"
            ]
          }
        },
        {
          "name": "subtotal",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.details.subtotal"
            ]
          }
        },
        {
          "name": "discountAmount",
          "type": "number",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.details.discountAmount"
            ]
          }
        },
        {
          "name": "paymentMethod",
          "type": "'cash' | 'debitCard' | 'creditCard' | 'pix'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.details.paymentMethod"
            ]
          }
        },
        {
          "name": "totalComanda",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.details.totalComanda"
            ]
          }
        },
        {
          "name": "lines",
          "type": "LinhaComandaFechamento[]"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "carregarFechamento",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "page",
          "type": "number",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "comandaId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "openComandas",
          "type": "PaginaComandasAbertas"
        },
        {
          "name": "selectedComanda",
          "type": "ComandaParaFechamento",
          "optional": true
        }
      ],
      "rules": [
        "subtotalComandaCalculado",
        "totalComandaCalculado",
        "valorTotalItemComandaCalculado"
      ],
      "jsdoc": {
        "purpose": "Inicializa o fechamento exibindo ao caixa a primeira página de comandas abertas e, quando vier no contexto, a comanda já escolhida para conferência e pagamento.",
        "input": "page e pageSize definem a fatia da lista de comandas abertas. comandaId é o identificador opcional vindo do contexto da página para abrir diretamente uma comanda.",
        "processing": "Filtra a lista por Comanda.status = open, junta o código da mesa, ordena de forma estável para localização e devolve somente a página solicitada com a quantidade total de comandas abertas. Se comandaId estiver presente, compõe seu cabeçalho, itens e mesa; os valores obedecem subtotalComandaCalculado, totalComandaCalculado e valorTotalItemComandaCalculado, considerando itens não cancelados nos cálculos.",
        "output": "Retorna a lista já pronta para localizar a conta, incluindo o indicador totalOpenComandas para paginação. selectedComanda, quando solicitada, já contém linhas, totais e dados de pagamento para preencher a conferência sem nova composição no cliente."
      }
    },
    {
      "id": "localizarComandasAbertas",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "search",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "openComandas",
          "type": "PaginaComandasAbertas"
        }
      ],
      "rules": [
        "totalComandaCalculado"
      ],
      "jsdoc": {
        "purpose": "Localiza, sob demanda, comandas ainda abertas pelo número da comanda ou pelo código da mesa.",
        "input": "search é o termo informado pelo caixa para número ou mesa. page e pageSize definem a página que deve ser exibida.",
        "processing": "Mantém obrigatoriamente o filtro de situação aberta, aplica a busca por número da comanda ou código da mesa, ordena os resultados de forma estável e calcula o total de ocorrências para a paginação. O total apresentado em cada resumo respeita totalComandaCalculado.",
        "output": "Retorna uma página da lista de comandas abertas, já com número, mesa, situação, total e indicador totalOpenComandas, sem transferir comandas fechadas ou itens."
      }
    },
    {
      "id": "consultarComandaParaFechamento",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "comandaId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "comanda",
          "type": "ComandaParaFechamento"
        }
      ],
      "rules": [
        "subtotalComandaCalculado",
        "totalComandaCalculado",
        "valorTotalItemComandaCalculado"
      ],
      "jsdoc": {
        "purpose": "Carrega a comanda selecionada na lista para o caixa conferir seus lançamentos e registrar o pagamento.",
        "input": "comandaId identifica a comanda escolhida pelo caixa na lista de comandas abertas.",
        "processing": "Lê a comanda e a mesa vinculada, reúne os itens com seus nomes de cardápio e apresenta os itens lançados para conferência. Calcula os valores conforme subtotalComandaCalculado, totalComandaCalculado e valorTotalItemComandaCalculado; itens cancelados não compõem os totais.",
        "output": "Retorna uma ComandaParaFechamento com cabeçalho, linhas, desconto, forma de pagamento, subtotal, total e disponibilidade da mesa, pronta para redesenhar a área de conferência e pagamento."
      }
    },
    {
      "id": "fecharComandaPaga",
      "kind": "cmd",
      "when": "fecharComandaPaga",
      "writes": "Comanda.fecharComanda",
      "input": [
        {
          "name": "comandaId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.version"
            ]
          }
        },
        {
          "name": "discountAmount",
          "type": "number",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.details.discountAmount"
            ]
          }
        },
        {
          "name": "paymentMethod",
          "type": "'cash' | 'debitCard' | 'creditCard' | 'pix'",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.details.paymentMethod"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "comanda",
          "type": "ComandaParaFechamento"
        }
      ],
      "rules": [
        "pagamentoObrigatorioNoFechamento",
        "descontoNaoExcedeSubtotal",
        "fechamentoLiberaMesa",
        "subtotalComandaCalculado",
        "totalComandaCalculado",
        "valorTotalItemComandaCalculado"
      ],
      "jsdoc": {
        "purpose": "Registra o desconto e a forma de pagamento, fecha a comanda conferida e devolve a cobrança no estado final para a página comunicar a liberação da mesa.",
        "input": "comandaId e version identificam com segurança a comanda aberta que será fechada. discountAmount é o desconto opcional aplicado pelo caixa. paymentMethod é a forma obrigatória de quitação.",
        "processing": "Executa a transição fecharComanda somente para a versão informada. Exige paymentMethod por pagamentoObrigatorioNoFechamento, recusa desconto maior que o subtotal por descontoNaoExcedeSubtotal e, na mesma operação atômica, fecha a comanda e deixa sua mesa disponível conforme fechamentoLiberaMesa. Recalcula e persiste os totais conforme subtotalComandaCalculado, totalComandaCalculado e valorTotalItemComandaCalculado.",
        "output": "Retorna a ComandaParaFechamento já fechada, com linhas, desconto, pagamento, totais recalculados e mesaDisponivel = true, para a página redesenhar a confirmação sem fazer nova consulta."
      }
    }
  ]
}
