{
  "types": [
    {
      "name": "MesaResumo",
      "description": "Dados da mesa vinculada à comanda, apresentados para o caixa localizar a cobrança.",
      "fields": [
        {
          "name": "code",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Mesa.code"
            ]
          }
        }
      ]
    },
    {
      "name": "ComandaAbertaResumo",
      "description": "Resumo de uma comanda ainda aberta para localização e seleção no fechamento.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.id"
            ]
          }
        },
        {
          "name": "number",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.number"
            ]
          }
        },
        {
          "name": "mesaId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.mesaId"
            ]
          }
        },
        {
          "name": "status",
          "type": "'open' | 'closed'",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.status"
            ]
          }
        },
        {
          "name": "details",
          "type": "ComandaResumoDetails"
        },
        {
          "name": "mesa",
          "type": "MesaResumo"
        }
      ]
    },
    {
      "name": "ComandaResumoDetails",
      "description": "Valores calculados exibidos no resumo de uma comanda aberta.",
      "fields": [
        {
          "name": "totalComanda",
          "type": "string",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Comanda.details.totalComanda",
              "Comanda.details.subtotal",
              "Comanda.details.discountAmount",
              "ItemComanda.status",
              "ItemComanda.details.valorTotal",
              "ItemComanda.details.quantidade",
              "ItemComanda.details.precoUnitario"
            ]
          }
        }
      ]
    },
    {
      "name": "ItemCardapioNaComanda",
      "description": "Identificação do item de cardápio associada a uma linha da comanda.",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemCardapio.name"
            ]
          }
        }
      ]
    },
    {
      "name": "ItemComandaDetailsParaFechamento",
      "description": "Dados de quantidade, observação, preço registrado e total calculado da linha conferida pelo caixa.",
      "fields": [
        {
          "name": "details.quantidade",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.details.quantidade"
            ]
          }
        },
        {
          "name": "details.observacao",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.details.observacao"
            ]
          }
        },
        {
          "name": "details.precoUnitario",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.details.precoUnitario"
            ]
          }
        },
        {
          "name": "valorTotal",
          "type": "string",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "ItemComanda.details.valorTotal",
              "ItemComanda.details.quantidade",
              "ItemComanda.details.precoUnitario"
            ]
          }
        }
      ]
    },
    {
      "name": "ItemComandaParaFechamento",
      "description": "Linha válida da comanda que compõe a cobrança a conferir.",
      "fields": [
        {
          "name": "status",
          "type": "'launched' | 'canceled'",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.status"
            ]
          }
        },
        {
          "name": "itemCardapioId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.itemCardapioId"
            ]
          }
        },
        {
          "name": "details",
          "type": "ItemComandaDetailsParaFechamento"
        },
        {
          "name": "itemCardapio",
          "type": "ItemCardapioNaComanda"
        }
      ]
    },
    {
      "name": "ComandaDetailsParaFechamento",
      "description": "Desconto, pagamento e totais da comanda mostrados e informados no fechamento.",
      "fields": [
        {
          "name": "details.discountAmount",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.details.discountAmount"
            ]
          }
        },
        {
          "name": "details.paymentMethod",
          "type": "'cash' | 'debitCard' | 'creditCard' | 'pix'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.details.paymentMethod"
            ]
          }
        },
        {
          "name": "subtotal",
          "type": "string",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Comanda.details.subtotal",
              "ItemComanda.status",
              "ItemComanda.details.valorTotal",
              "ItemComanda.details.quantidade",
              "ItemComanda.details.precoUnitario"
            ]
          }
        },
        {
          "name": "totalComanda",
          "type": "string",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Comanda.details.totalComanda",
              "Comanda.details.subtotal",
              "Comanda.details.discountAmount",
              "ItemComanda.status",
              "ItemComanda.details.valorTotal",
              "ItemComanda.details.quantidade",
              "ItemComanda.details.precoUnitario"
            ]
          }
        }
      ]
    },
    {
      "name": "MesaNoFechamento",
      "description": "Indicador de disponibilidade da mesa vinculada após a situação atual da comanda.",
      "fields": [
        {
          "name": "disponivel",
          "type": "boolean",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Mesa.details.disponivel",
              "Mesa.id",
              "Comanda.mesaId",
              "Comanda.status"
            ]
          }
        }
      ]
    },
    {
      "name": "ComandaParaFechamento",
      "description": "Comanda selecionada com linhas válidas, totais calculados, dados de pagamento e indicador da mesa para conferência e fechamento.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.version"
            ]
          }
        },
        {
          "name": "number",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.number"
            ]
          }
        },
        {
          "name": "status",
          "type": "'open' | 'closed'",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.status"
            ]
          }
        },
        {
          "name": "details",
          "type": "ComandaDetailsParaFechamento"
        },
        {
          "name": "items",
          "type": "ItemComandaParaFechamento[]"
        },
        {
          "name": "mesa",
          "type": "MesaNoFechamento"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "carregarFechamento",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "comandaId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "number",
          "type": "number",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "mesaCode",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "openComandas",
          "type": "ComandaAbertaResumo[]",
          "paginated": true
        },
        {
          "name": "selectedComanda",
          "type": "ComandaParaFechamento",
          "optional": true
        }
      ],
      "rules": [
        "subtotalComandaCalculado",
        "totalComandaCalculado",
        "valorTotalItemComandaCalculado"
      ],
      "jsdoc": {
        "purpose": "Carrega o fechamento com as comandas abertas para localização e, quando houver contexto, a cobrança completa que o caixa irá conferir.",
        "input": "comandaId identifica a comanda recebida no contexto. number e mesaCode restringem a localização inicial. page e pageSize definem a janela da lista de comandas abertas.",
        "processing": "Filtra a lista obrigatoriamente por situação open, aplica número e código de mesa quando informados, ordena de forma estável e entrega a janela paginada. Compõe o código da mesa e calcula o total de cada resumo conforme valorTotalItemComandaCalculado, subtotalComandaCalculado e totalComandaCalculado. Se comandaId identificar uma comanda aberta, compõe suas linhas launched, nomes do cardápio, pagamento, totais calculados e disponibilidade calculada da mesa; campos derivados são apenas calculados.",
        "output": "Retorna uma lista paginada e enxuta pronta para localizar a conta e, opcionalmente, a comanda contextual completa para preencher revisão, pagamento e ação de fechamento."
      }
    },
    {
      "id": "buscarComandasAbertas",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "number",
          "type": "number",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "mesaCode",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "openComandas",
          "type": "ComandaAbertaResumo[]",
          "paginated": true
        }
      ],
      "rules": [
        "subtotalComandaCalculado",
        "totalComandaCalculado",
        "valorTotalItemComandaCalculado"
      ],
      "jsdoc": {
        "purpose": "Substitui a lista de localização pelas comandas abertas que correspondem ao número ou à mesa procurados pelo caixa.",
        "input": "number filtra pelo número da comanda e mesaCode pelo código da mesa. page e pageSize definem a primeira janela resultante da busca ou troca de filtros.",
        "processing": "Restringe o resultado a comandas open, combina os filtros informados e ordena antes de paginar. Para cada resumo, compõe a mesa e calcula totalComanda pelas regras valorTotalItemComandaCalculado, subtotalComandaCalculado e totalComandaCalculado, sem registrar valores derivados.",
        "output": "Retorna a janela paginada de resumos para substituir a lista que o caixa está pesquisando."
      }
    },
    {
      "id": "carregarMaisComandasAbertas",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "number",
          "type": "number",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "mesaCode",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "openComandas",
          "type": "ComandaAbertaResumo[]",
          "paginated": true
        }
      ],
      "rules": [
        "subtotalComandaCalculado",
        "totalComandaCalculado",
        "valorTotalItemComandaCalculado"
      ],
      "jsdoc": {
        "purpose": "Busca a próxima janela das comandas abertas da localização atual sem recarregar os resumos já exibidos.",
        "input": "number e mesaCode repetem os filtros ativos. page e pageSize identificam a próxima janela solicitada.",
        "processing": "Aplica os mesmos filtros obrigatórios de situação open, número e mesa, ordena de forma estável e pagina a próxima janela. Compõe mesa e total calculado conforme valorTotalItemComandaCalculado, subtotalComandaCalculado e totalComandaCalculado.",
        "output": "Retorna uma página adicional de resumos para ser anexada à lista de comandas abertas."
      }
    },
    {
      "id": "obterComandaParaFechamento",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "comanda",
          "type": "ComandaParaFechamento"
        }
      ],
      "rules": [
        "subtotalComandaCalculado",
        "totalComandaCalculado",
        "valorTotalItemComandaCalculado"
      ],
      "jsdoc": {
        "purpose": "Obtém a comanda aberta selecionada pelo caixa, já composta para conferência, recebimento e fechamento.",
        "input": "id é o identificador da comanda escolhida na lista de comandas abertas.",
        "processing": "Lê a comanda aberta autorizada, inclui somente itens launched, associa o nome de cada ItemCardapio e calcula valorTotal, subtotal e totalComanda segundo valorTotalItemComandaCalculado, subtotalComandaCalculado e totalComandaCalculado. Também calcula o indicador de disponibilidade da mesa, sem gravar nenhum campo derivado.",
        "output": "Retorna versão, situação, linhas válidas, desconto, forma de pagamento, totais e indicador da mesa para os organismos de revisão, pagamento e fechamento."
      }
    },
    {
      "id": "fecharComandaPaga",
      "kind": "cmd",
      "when": "fecharComandaPaga",
      "writes": "Comanda.fecharComanda",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.version"
            ]
          }
        },
        {
          "name": "details.discountAmount",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.details.discountAmount"
            ]
          }
        },
        {
          "name": "details.paymentMethod",
          "type": "'cash' | 'debitCard' | 'creditCard' | 'pix'",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.details.paymentMethod"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "comanda",
          "type": "ComandaParaFechamento"
        }
      ],
      "rules": [
        "pagamentoObrigatorioNoFechamento",
        "descontoNaoExcedeSubtotal",
        "fechamentoLiberaMesa",
        "subtotalComandaCalculado",
        "totalComandaCalculado",
        "valorTotalItemComandaCalculado"
      ],
      "jsdoc": {
        "purpose": "Registra o desconto e o pagamento, fecha a comanda e confirma que sua mesa foi liberada.",
        "input": "id e version identificam a comanda aberta e protegem contra fechamento concorrente. discountAmount é o desconto opcional. paymentMethod é a forma de pagamento obrigatória do fechamento.",
        "processing": "Em transação, recompõe os itens launched e recalcula valorTotal, subtotal e total pelas regras valorTotalItemComandaCalculado, subtotalComandaCalculado e totalComandaCalculado. Recusa pagamento ausente por pagamentoObrigatorioNoFechamento e desconto superior ao subtotal por descontoNaoExcedeSubtotal. Com a versão válida, grava o payload da transição fecharComanda, muda a situação para closed e libera a mesa segundo fechamentoLiberaMesa.",
        "output": "Retorna a comanda fechada, com linhas, desconto, pagamento, totais recalculados e indicador de mesa disponível, para redesenhar imediatamente a confirmação."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "openComandaList",
        "reads": "carregarFechamento.openComandas"
      },
      {
        "organism": "comandaReview",
        "reads": "obterComandaParaFechamento.comanda"
      },
      {
        "organism": "paymentForm",
        "reads": "obterComandaParaFechamento.comanda"
      },
      {
        "organism": "closeComandaActions",
        "reads": "obterComandaParaFechamento.comanda"
      }
    ],
    "commands": [
      {
        "endpoint": "fecharComandaPaga",
        "refreshes": [
          "buscarComandasAbertas"
        ]
      }
    ],
    "selections": [
      {
        "organism": "openComandaList",
        "via": {
          "query": "obterComandaParaFechamento"
        }
      }
    ],
    "journeys": [
      {
        "step": "fecharComanda/localizarComandaParaFechamento",
        "organisms": [
          "openComandaList"
        ],
        "endpoints": [
          "carregarFechamento",
          "buscarComandasAbertas",
          "carregarMaisComandasAbertas",
          "obterComandaParaFechamento"
        ]
      },
      {
        "step": "fecharComanda/conferirTotalComanda",
        "organisms": [
          "comandaReview",
          "paymentForm"
        ],
        "endpoints": [
          "obterComandaParaFechamento"
        ]
      },
      {
        "step": "fecharComanda/fecharComandaPaga",
        "organisms": [
          "paymentForm",
          "closeComandaActions",
          "comandaReview"
        ],
        "endpoints": [
          "fecharComandaPaga",
          "buscarComandasAbertas"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "carregarFechamento",
        "state": "carregarFechamento.openComandas",
        "mode": "replace"
      },
      {
        "endpoint": "carregarFechamento",
        "state": "obterComandaParaFechamento.comanda",
        "mode": "replace"
      },
      {
        "endpoint": "buscarComandasAbertas",
        "state": "carregarFechamento.openComandas",
        "mode": "replace"
      },
      {
        "endpoint": "carregarMaisComandasAbertas",
        "state": "carregarFechamento.openComandas",
        "mode": "append"
      },
      {
        "endpoint": "obterComandaParaFechamento",
        "state": "obterComandaParaFechamento.comanda",
        "mode": "replace"
      },
      {
        "endpoint": "fecharComandaPaga",
        "state": "obterComandaParaFechamento.comanda",
        "mode": "upsert"
      }
    ]
  }
}
