          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.version"
            ]
          }
