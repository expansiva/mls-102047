            "paths": [
              "ItemComanda.details.quantidade"
            ]
          }
        },
        {
          "name": "observacao",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.details.observacao"
            ]
          }
        },
        {
          "name": "precoUnitario",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
