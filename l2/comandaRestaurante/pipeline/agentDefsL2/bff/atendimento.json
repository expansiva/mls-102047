            ]
          }
        },
        {
          "name": "subtotal",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "ItemComanda.status",
              "ItemComanda.details.valorTotal",
              "Comanda.details.subtotal"
            ]
          }
        },
        {
          "name": "itens",
