            ]
          }
        },
        {
          "name": "valorTotal",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemComanda.details.valorTotal"
            ]
          }
        }
      ]
    },
    {
      "name": "ComandaAtendimento",
      "description": "Comanda escolhida ou alterada, já composta com mesa, linhas e subtotal para redesenhar a conferência.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.id"
            ]
          }
        },
        {
          "name": "versao",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.version"
            ]
          }
        },
        {
          "name": "numero",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.number"
            ]
          }
        },
        {
          "name": "mesaId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Comanda.mesaId"
            ]
          }
        },
        {
          "name": "codigoMesa",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
