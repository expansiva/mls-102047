            ]
          }
        },
        {
          "name": "eventoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.eventoId"
            ]
          }
        },
        {
          "name": "status",
          "type": "'confirmed' | 'waitlisted' | 'cancelled'",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.status"
            ]
          }
        },
        {
          "name": "receivedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.receivedAt"
            ]
          }
        },
        {
          "name": "evento",
          "type": "EventoResumo"
        }
      ]
    },
    {
      "name": "InscricaoDetalheDetails",
      "description": "Campos derivados da inscrição: se ocupa vaga e posição na lista de espera.",
      "fields": [
        {
          "name": "details.ocupaVaga",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.details.ocupaVaga"
            ]
          }
        },
        {
          "name": "details.posicaoListaEspera",
          "type": "number",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.details.posicaoListaEspera"
            ]
          }
        }
      ]
    },
    {
      "name": "InscricaoDetalhe",
      "description": "Inscrição aberta com seu evento, usada no detalhe e nas ações de cancelamento.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.version"
            ]
          }
        },
        {
          "name": "registrationCode",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.registrationCode"
            ]
          }
        },
        {
          "name": "status",
          "type": "'confirmed' | 'waitlisted' | 'cancelled'",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.status"
            ]
          }
        },
        {
          "name": "receivedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.receivedAt"
            ]
          }
        },
        {
          "name": "details",
          "type": "InscricaoDetalheDetails"
        },
        {
          "name": "evento",
          "type": "EventoDetalhe"
        }
      ]
    },
    {
      "name": "PosicaoEsperaDetails",
      "description": "Posição da inscrição na fila.",
      "fields": [
        {
          "name": "details.posicaoListaEspera",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.details.posicaoListaEspera"
            ]
          }
        }
      ]
    },
    {
      "name": "PosicaoEsperaItem",
      "description": "Inscrição em lista de espera com a posição na fila e o evento.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.id"
            ]
          }
        },
        {
          "name": "details",
          "type": "PosicaoEsperaDetails"
        },
        {
          "name": "evento",
          "type": "EventoTitulo"
        }
      ]
    },
    {
      "name": "ResumoInscricoes",
      "description": "Panorama das inscrições da pessoa: contagens e posições na lista de espera.",
      "fields": [
        {
          "name": "totalOcupandoVaga",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Inscricao.status",
              "Inscricao.details.ocupaVaga"
            ]
          }
        },
        {
          "name": "totalEmListaEspera",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Inscricao.status"
            ]
          }
        },
        {
          "name": "emListaEspera",
          "type": "PosicaoEsperaItem[]"
        }
      ]
    },
    {
      "name": "PromocaoDetails",
      "description": "Momento da promoção.",
      "fields": [
        {
          "name": "details.promotedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.details.promotedAt"
            ]
          }
        }
      ]
    },
    {
      "name": "PromocaoItem",
      "description": "Evento do histórico: inscrição promovida da lista de espera.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.id"
            ]
          }
        },
        {
          "name": "registrationCode",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.registrationCode"
            ]
          }
        },
        {
          "name": "details",
          "type": "PromocaoDetails"
        },
        {
          "name": "evento",
          "type": "EventoTitulo"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "carregarMinhasInscricoes",
      "kind": "qry",
      "when": "onLoad",
      "input": [],
      "output": [
        {
          "name": "resumo",
          "type": "ResumoInscricoes"
        },
        {
          "name": "inscricoes",
          "type": "InscricaoListaItem[]"
        },
        {
          "name": "promocoes",
          "type": "PromocaoItem[]"
        }
      ],
      "rules": [
        "calculoPosicaoListaEspera",
        "ordemChegadaListaEspera"
      ],
      "jsdoc": {
        "purpose": "Carrega de uma vez tudo que a página mostra ao abrir: o panorama das inscrições da pessoa, a lista das suas inscrições e o histórico de promoções da lista de espera.",
        "input": "Sem parâmetros; o participante é identificado pela sessão do público (escopo own).",
        "processing": "Lê as inscrições do participante da sessão com o título e a data do evento, ordenadas por recebimento (mais recente primeiro). Calcula no servidor: totalOcupandoVaga = inscrições com ocupaVaga verdadeiro (confirmadas); totalEmListaEspera = inscrições com status waitlisted; emListaEspera com a posição derivada por calculoPosicaoListaEspera (inscrições do mesmo evento em lista de espera recebidas antes, mais um, na ordem de ordemChegadaListaEspera). Monta promocoes com as inscrições que têm promotedAt preenchido, em ordem cronológica. Campos derivados são calculados, nunca gravados.",
        "output": "resumo para o panorama, inscricoes para a lista e promocoes para a linha do tempo, já no formato que a página exibe."
      }
    },
    {
      "id": "buscarMinhasInscricoes",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "texto",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "inscricoes",
          "type": "InscricaoListaItem[]"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Filtra as inscrições da pessoa pelo código da inscrição ou pelo título do evento.",
        "input": "texto: termo digitado na busca; compara com o código da inscrição ou com o título do evento.",
        "processing": "Restringe às inscrições do participante da sessão (escopo own) e aplica o filtro por registrationCode ou Evento.title (sem distinção de maiúsculas), ordenando por recebimento.",
        "output": "A lista filtrada, que substitui a lista exibida."
      }
    },
    {
      "id": "obterInscricao",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.id"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "inscricao",
          "type": "InscricaoDetalhe"
        }
      ],
      "rules": [
        "calculoPosicaoListaEspera"
      ],
      "jsdoc": {
        "purpose": "Abre a inscrição escolhida na lista para a pessoa conferir os dados antes de decidir cancelar.",
        "input": "inscricaoId: id da inscrição selecionada na lista.",
        "processing": "Lê a inscrição garantindo que pertence ao participante da sessão; compõe o evento com título, data e nome do local. ocupaVaga é derivado do status confirmado; posicaoListaEspera é calculada por calculoPosicaoListaEspera apenas quando a inscrição está em lista de espera. Devolve a versão para o cancelamento com concorrência otimista.",
        "output": "A inscrição com seu evento e versão, usada pelo detalhe e pelas ações (que mostram o cancelamento só para confirmed ou waitlisted)."
      }
    },
    {
      "id": "cancelarInscricao",
      "kind": "cmd",
      "when": "cancelarInscricao",
      "writes": "Inscricao.cancelar",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "inscricao",
          "type": "InscricaoDetalhe"
        }
      ],
      "rules": [
        "cancelamentoSomentePropriaInscricao",
        "promoverPrimeiroListaEsperaAoCancelar",
        "ordemChegadaListaEspera"
      ],
      "jsdoc": {
        "purpose": "Cancela a inscrição aberta pela pessoa, liberando a vaga quando ela a ocupava.",
        "input": "inscricaoId: id da inscrição a cancelar. version: versão da inscrição lida no detalhe, para concorrência otimista (recusa se a inscrição mudou desde a leitura).",
        "processing": "Aplica cancelamentoSomentePropriaInscricao: recusa se a inscrição não pertence ao participante da sessão ou se o status não é confirmed ou waitlisted. Confere a versão e executa a transição cancelar (status cancelled, registrando cancelledAt). Se a inscrição ocupava vaga, na mesma transação promove a primeira inscrição em lista de espera do mesmo evento por ordem de chegada (ordemChegadaListaEspera, promoverPrimeiroListaEsperaAoCancelar), registrando promotedAt. Tudo ou nada.",
        "output": "A inscrição atualizada com seu evento e nova versão, para redesenhar o detalhe e as ações sem nova chamada."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "resumoInscricoes",
        "reads": "carregarMinhasInscricoes.resumo"
      },
      {
        "organism": "listaInscricoes",
        "reads": "carregarMinhasInscricoes.inscricoes"
      },
      {
        "organism": "detalheInscricao",
        "reads": "obterInscricao.inscricao"
      },
      {
        "organism": "acoesInscricao",
        "reads": "obterInscricao.inscricao"
      },
      {
        "organism": "promocoesListaEspera",
        "reads": "carregarMinhasInscricoes.promocoes"
      }
    ],
    "commands": [
      {
        "endpoint": "cancelarInscricao",
        "refreshes": [
          "carregarMinhasInscricoes"
        ]
      }
    ],
    "selections": [
      {
        "organism": "listaInscricoes",
        "via": {
          "query": "obterInscricao"
        }
      }
    ],
    "journeys": [
      {
        "step": "cancelarInscricao/localizarInscricao",
        "organisms": [
          "resumoInscricoes",
          "listaInscricoes"
        ],
        "endpoints": [
          "carregarMinhasInscricoes",
          "buscarMinhasInscricoes"
        ]
      },
      {
        "step": "cancelarInscricao/verInscricao",
        "organisms": [
          "detalheInscricao"
        ],
        "endpoints": [
          "obterInscricao"
        ]
      },
      {
        "step": "cancelarInscricao/cancelar",
        "organisms": [
          "acoesInscricao"
        ],
        "endpoints": [
          "cancelarInscricao"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "buscarMinhasInscricoes",
        "state": "carregarMinhasInscricoes.inscricoes",
        "mode": "replace"
      },
      {
        "endpoint": "cancelarInscricao",
        "state": "obterInscricao.inscricao",
        "mode": "upsert"
      }
    ]
  }
}
