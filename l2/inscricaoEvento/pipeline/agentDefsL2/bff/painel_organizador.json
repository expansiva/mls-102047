{
  "types": [
    {
      "name": "OcupacaoEventoDetails",
      "description": "Números de ocupação do evento, calculados a partir das inscrições.",
      "fields": [
        {
          "name": "details.capacity",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.capacity"
            ]
          }
        },
        {
          "name": "details.occupiedSeats",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.occupiedSeats"
            ]
          }
        },
        {
          "name": "details.remainingSeats",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.remainingSeats"
            ]
          }
        },
        {
          "name": "details.waitlistSize",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.waitlistSize"
            ]
          }
        },
        {
          "name": "details.isFull",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.isFull"
            ]
          }
        }
      ]
    },
    {
      "name": "OcupacaoEvento",
      "description": "Evento publicado com sua ocupação, para os destaques do painel.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.id"
            ]
          }
        },
        {
          "name": "title",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.title"
            ]
          }
        },
        {
          "name": "eventDate",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.eventDate"
            ]
          }
        },
        {
          "name": "status",
          "type": "'draft' | 'published'",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.status"
            ]
          }
        },
        {
          "name": "details",
          "type": "OcupacaoEventoDetails"
        }
      ]
    },
    {
      "name": "PublicacaoRecenteDetails",
      "description": "Data de publicação e vagas ocupadas do evento publicado recentemente.",
      "fields": [
        {
          "name": "details.publishedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.publishedAt"
            ]
          }
        },
        {
          "name": "details.occupiedSeats",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.occupiedSeats"
            ]
          }
        }
      ]
    },
    {
      "name": "PublicacaoRecente",
      "description": "Evento publicado recentemente, para o resumo do painel.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.id"
            ]
          }
        },
        {
          "name": "title",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.title"
            ]
          }
        },
        {
          "name": "status",
          "type": "'draft' | 'published'",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.status"
            ]
          }
        },
        {
          "name": "details",
          "type": "PublicacaoRecenteDetails"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "qryPainelOrganizador",
      "kind": "qry",
      "when": "onLoad",
      "input": [],
      "output": [
        {
          "name": "eventosOcupacao",
          "type": "OcupacaoEvento[]"
        },
        {
          "name": "totalVagasOcupadas",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Evento.details.occupiedSeats",
              "Evento.status"
            ]
          }
        },
        {
          "name": "publicacoesRecentes",
          "type": "PublicacaoRecente[]"
        }
      ],
      "rules": [
        "calculoVagasOcupadas",
        "calculoVagasRestantes",
        "listaEsperaQuandoVagasEsgotadas"
      ],
      "jsdoc": {
        "purpose": "Carrega numa só chamada tudo o que o painel do organizador mostra ao abrir: a ocupação de cada evento publicado, o total de vagas ocupadas e os eventos publicados recentemente.",
        "input": "Nenhuma entrada; o escopo é a organização do organizador autenticado.",
        "processing": "Filtra os eventos da organização com status 'published'. Para cada um calcula a partir das inscrições (nunca grava): occupiedSeats = inscrições confirmadas, sem canceladas nem em lista de espera (calculoVagasOcupadas); remainingSeats = capacity - occupiedSeats, nunca abaixo de zero (calculoVagasRestantes); waitlistSize = inscrições em lista de espera; isFull = occupiedSeats >= capacity (listaEsperaQuandoVagasEsgotadas). Ordena eventosOcupacao colocando primeiro os lotados e com fila (isFull desc, waitlistSize desc), depois os com menos vagas restantes, e por eventDate. totalVagasOcupadas é a soma de occupiedSeats dos eventos publicados, calculada no servidor. publicacoesRecentes traz os eventos publicados mais recentes ordenados por publishedAt decrescente, limitados a um número curto (ex.: 5).",
        "output": "eventosOcupacao para os destaques de ocupação; totalVagasOcupadas já somado para o resumo; publicacoesRecentes com a data de publicação. Os ids permitem navegar para a gestão do evento."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "ocupacaoEventos",
        "reads": "qryPainelOrganizador.eventosOcupacao"
      },
      {
        "organism": "resumoPublicacoes",
        "reads": "qryPainelOrganizador.totalVagasOcupadas"
      },
      {
        "organism": "resumoPublicacoes",
        "reads": "qryPainelOrganizador.publicacoesRecentes"
      }
    ],
    "commands": [],
    "selections": [],
    "journeys": [
      {
        "step": "acompanharInscritos/verOcupacao",
        "organisms": [
          "ocupacaoEventos",
          "resumoPublicacoes"
        ],
        "endpoints": [
          "qryPainelOrganizador"
        ]
      },
      {
        "step": "acompanharInscritos/localizarEventoOrg",
        "organisms": [
          "ocupacaoEventos"
        ],
        "endpoints": [
          "qryPainelOrganizador"
        ],
        "continuesIn": "gestao_eventos"
      },
      {
        "step": "acompanharInscritos/verInscritos",
        "organisms": [],
        "endpoints": [],
        "continuesIn": "gestao_eventos"
      },
      {
        "step": "acompanharInscritos/baixarCsv",
        "organisms": [],
        "endpoints": [],
        "continuesIn": "gestao_eventos"
      }
    ],
    "updates": []
  }
}
