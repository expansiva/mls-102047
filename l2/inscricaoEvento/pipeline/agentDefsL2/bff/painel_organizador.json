          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.waitlistSize"
            ]
          }
        },
        {
          "name": "details.isFull",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.isFull"
            ]
          }
        }
      ]
    },
    {
      "name": "EventoOcupacao",
      "description": "Evento publicado com sua situação de ocupação, para os destaques do painel.",
