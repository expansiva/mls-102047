            ]
          }
        },
        {
          "name": "details.occupiedSeats",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.occupiedSeats"
            ]
          }
        },
        {
          "name": "details.remainingSeats",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
