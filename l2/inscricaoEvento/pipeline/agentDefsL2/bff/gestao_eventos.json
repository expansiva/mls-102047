            ]
          }
        }
      ]
    },
    {
      "name": "PromocaoItem",
      "description": "Inscrição promovida automaticamente da lista de espera para vaga confirmada.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.id"
            ]
          }
        },
        {
          "name": "registrationCode",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.registrationCode"
            ]
          }
        },
        {
          "name": "receivedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.receivedAt"
            ]
          }
        },
        {
          "name": "details.promotedAt",
          "type": "string",
          "origin": {
