      "fields": [
        {
          "name": "registrationCode",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.registrationCode"
            ]
          }
        },
        {
          "name": "receivedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.receivedAt"
            ]
          }
        },
        {
          "name": "status",
          "type": "'confirmed' | 'waitlisted' | 'cancelled'",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.status"
            ]
          }
        },
        {
          "name": "participante.details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.identification.name"
            ]
          }
        },
        {
          "name": "emailParticipante.details.contactChannel.value",
          "type": "string",
          "origin": {
            "kind": "field",
