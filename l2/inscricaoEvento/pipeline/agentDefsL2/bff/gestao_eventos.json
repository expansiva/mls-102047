        ]
      }
    ],
    "updates": [
      {
        "endpoint": "cmdSalvarEvento",
        "state": "qryEventos.eventos",
        "mode": "upsert"
      },
      {
        "endpoint": "cmdSalvarEvento",
        "state": "qryEventoPainel.evento",
        "mode": "replace"
      },
      {
        "endpoint": "cmdPublicarEvento",
        "state": "qryEventos.eventos",
        "mode": "upsert"
      },
