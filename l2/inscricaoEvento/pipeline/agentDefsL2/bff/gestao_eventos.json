            "paths": [
              "Participante.details.identification.name"
            ]
          }
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "qryListarEventos",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "status",
          "type": "'draft' | 'published'",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "dataDe",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "dataAte",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "eventos",
          "type": "EventoResumo[]",
          "paginated": true
        }
      ],
      "rules": [
        "calculoVagasOcupadas",
        "calculoVagasRestantes"
      ],
      "jsdoc": {
        "purpose": "Lista os eventos da organização do organizador para ele localizar o evento a trabalhar, já com a ocupação de cada um.",
        "input": "busca: trecho do título; status: filtra rascunho ou publicado; dataDe/dataAte: intervalo da data do evento; page/pageSize: paginação.",
        "processing": "Filtra os eventos do escopo da organização por título (contém, sem distinção de maiúsculas), situação e intervalo de data; ordena por data do evento. Para cada evento calcula vagas ocupadas (calculoVagasOcupadas: inscrições confirmadas, sem canceladas nem em espera) e vagas restantes (calculoVagasRestantes: vagas menos ocupadas, nunca abaixo de zero). Os derivados são calculados, não gravados.",
        "output": "Página de eventos { items, page, pageSize, hasMore } com título, data, situação, vagas ocupadas e restantes."
      }
    },
    {
      "id": "qryAbrirEvento",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "eventoId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "evento",
          "type": "EventoDetalhe"
        },
        {
          "name": "promocoes",
          "type": "PromocaoItem[]"
        }
      ],
      "rules": [
        "calculoVagasOcupadas",
        "calculoVagasRestantes",
        "listaEsperaQuandoVagasEsgotadas",
        "promoverPrimeiroListaEsperaAoCancelar"
      ],
      "jsdoc": {
        "purpose": "Abre o evento escolhido para revisão, com dados, publicação, ocupação e o histórico de promoções automáticas.",
        "input": "eventoId: evento selecionado na lista ou recém-cadastrado.",
        "processing": "Lê o evento por id no escopo da organização. Calcula vagas ocupadas (calculoVagasOcupadas), restantes (calculoVagasRestantes), lotado quando ocupadas alcançam as vagas (listaEsperaQuandoVagasEsgotadas) e tamanho da lista de espera (inscrições waitlisted). Lista as inscrições do evento com promovida em preenchida (registradas por promoverPrimeiroListaEsperaAoCancelar), com o nome do participante, ordenadas pela promoção mais recente.",
        "output": "evento: detalhe com indicadores prontos para eventoDetail e publicarActions; promocoes: linha do tempo de quem foi promovido e quando."
      }
    },
    {
      "id": "qryListarInscritos",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "eventoId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "inscritos",
          "type": "InscritoItem[]",
          "paginated": true
        }
      ],
      "rules": [
        "ordemChegadaListaEspera",
        "calculoPosicaoListaEspera",
        "calculoVagasOcupadas"
      ],
      "jsdoc": {
        "purpose": "Lista os inscritos do evento em foco em ordem de chegada, com quem ocupa vaga e a posição na lista de espera.",
        "input": "eventoId: evento em foco; page/pageSize: paginação, pois um evento pode ter muitos inscritos.",
        "processing": "Lista as inscrições do evento ordenadas por recebida em (ordemChegadaListaEspera), compondo nome do participante e e-mail do cadastro mestre. ocupaVaga é verdadeiro para confirmadas (calculoVagasOcupadas); posicaoListaEspera, só para waitlisted, é o número de inscrições em espera do mesmo evento recebidas antes, mais um (calculoPosicaoListaEspera). Derivados calculados, não gravados.",
        "output": "Página { items, page, pageSize, hasMore } de inscritos para inscritosList."
      }
    },
    {
      "id": "qryExportarInscritosCsv",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "eventoId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "linhas",
          "type": "InscritoCsv[]"
        },
        {
          "name": "nomeArquivo",
          "type": "string",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Evento.title"
            ]
          }
        }
      ],
      "rules": [
        "ordemChegadaListaEspera"
      ],
      "jsdoc": {
        "purpose": "Gera o conteúdo do CSV com todos os inscritos do evento para o organizador baixar.",
        "input": "eventoId: evento em foco.",
        "processing": "Lê todas as inscrições do evento (sem paginação), compõe nome e e-mail do participante e ordena por recebida em (ordemChegadaListaEspera). O nome do arquivo deriva do título do evento.",
        "output": "linhas com código, nome, e-mail, situação e recebida em, e nomeArquivo, para exportarCsvActions montar o download."
      }
    },
    {
      "id": "cmdCriarEvento",
      "kind": "cmd",
      "when": "criarEvento",
      "writes": "Evento.create",
      "input": [
        {
          "name": "title",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.title"
            ]
          }
        },
        {
          "name": "eventDate",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.eventDate"
            ]
          }
        },
        {
          "name": "details.description",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.description"
            ]
          }
        },
        {
          "name": "details.venue.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.venue.name"
            ]
          }
        },
        {
          "name": "details.venue.address.line1",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.venue.address.line1"
            ]
          }
        },
        {
          "name": "details.venue.address.line2",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.venue.address.line2"
            ]
          }
        },
        {
          "name": "details.venue.address.city",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.venue.address.city"
            ]
          }
        },
        {
          "name": "details.venue.address.stateOrProvince",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.venue.address.stateOrProvince"
            ]
          }
        },
        {
          "name": "details.venue.address.postalCode",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.venue.address.postalCode"
            ]
          }
        },
        {
          "name": "details.venue.address.countryCode",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.venue.address.countryCode"
            ]
          }
        },
        {
          "name": "details.capacity",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.details.capacity"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "evento",
          "type": "EventoDetalhe"
        }
      ],
      "rules": [
        "calculoVagasOcupadas",
        "calculoVagasRestantes"
      ],
      "jsdoc": {
        "purpose": "Cadastra um novo evento como rascunho e o deixa em foco para revisão.",
        "input": "Título, data, descrição, nome do local, endereço (opcional) e número de vagas informados no formulário.",
        "processing": "Cria o Evento na organização do organizador com situação draft. Não grava derivados: publicado em fica vazio; vagas ocupadas (calculoVagasOcupadas) e restantes (calculoVagasRestantes) são calculadas na resposta (zero ocupadas, restantes = vagas).",
        "output": "evento: detalhe do evento criado, que substitui o evento em foco sem nova chamada."
      }
    },
    {
      "id": "cmdPublicarEvento",
      "kind": "cmd",
      "when": "publicarEvento",
      "writes": "Evento.publicar",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "evento",
          "type": "EventoDetalhe"
        }
      ],
      "rules": [
        "publicarExigeDadosCompletos"
      ],
      "jsdoc": {
        "purpose": "Publica o evento em foco para abrir sua página pública a inscrições.",
        "input": "eventoId e version do evento em foco (concorrência otimista).",
        "processing": "Executa a transição publicar (draft → published). Recusa se o evento não estiver em rascunho ou se faltar título, descrição, data, local ou número de vagas, ou se as vagas não forem maiores que zero (publicarExigeDadosCompletos). Recusa versão divergente. Publicado em é registrado pelo sistema.",
        "output": "evento: detalhe atualizado com situação publicado e publicado em, que redesenha o evento em foco."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "eventosList",
        "reads": "qryListarEventos.eventos"
      },
      {
        "organism": "eventoDetail",
        "reads": "qryAbrirEvento.evento"
      },
      {
        "organism": "publicarActions",
        "reads": "qryAbrirEvento.evento"
      },
      {
        "organism": "promocoesTimeline",
        "reads": "qryAbrirEvento.promocoes"
      },
      {
        "organism": "inscritosList",
        "reads": "qryListarInscritos.inscritos"
      },
      {
        "organism": "exportarCsvActions",
        "reads": "qryExportarInscritosCsv.linhas"
      },
      {
        "organism": "exportarCsvActions",
        "reads": "qryExportarInscritosCsv.nomeArquivo"
      }
    ],
    "commands": [
      {
        "endpoint": "cmdCriarEvento",
        "refreshes": [
          "qryListarEventos"
        ]
      },
      {
        "endpoint": "cmdPublicarEvento",
        "refreshes": [
          "qryListarEventos"
        ]
      }
    ],
    "selections": [
      {
        "organism": "eventosList",
        "via": {
          "query": "qryAbrirEvento"
        }
      },
      {
        "organism": "eventoForm",
        "via": {
          "query": "qryAbrirEvento"
        }
      }
    ],
    "journeys": [
      {
        "step": "acompanharInscritos/localizarEventoOrg",
        "organisms": [
          "eventosList"
        ],
        "endpoints": [
          "qryListarEventos"
        ]
      },
      {
        "step": "acompanharInscritos/verOcupacao",
        "organisms": [
          "eventoDetail"
        ],
        "endpoints": [
          "qryAbrirEvento"
        ]
      },
      {
        "step": "acompanharInscritos/verInscritos",
        "organisms": [
          "inscritosList",
          "promocoesTimeline"
        ],
        "endpoints": [
          "qryListarInscritos",
          "qryAbrirEvento"
        ]
      },
      {
        "step": "acompanharInscritos/baixarCsv",
        "organisms": [
          "exportarCsvActions"
