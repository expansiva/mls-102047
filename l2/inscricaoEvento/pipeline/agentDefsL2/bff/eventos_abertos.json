  ],
  "endpoints": [
    {
      "id": "qryEventosPublicados",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "texto",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "dataInicio",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "dataFim",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "eventos",
          "type": "EventoResumo[]",
          "paginated": true
        }
      ],
      "rules": [
        "inscricaoSomenteEventoPublicado",
        "calculoVagasOcupadas",
        "listaEsperaQuandoVagasEsgotadas"
      ],
      "jsdoc": {
        "purpose": "Carrega e busca a lista paginada de eventos publicados para a pessoa escolher qual abrir.",
        "input": "page e pageSize: página pedida e tamanho; texto: termo opcional buscado no título e no nome do local; dataInicio/dataFim: intervalo opcional sobre a data do evento.",
        "processing": "Filtra apenas eventos com situação publicado (inscricaoSomenteEventoPublicado; a situação não é exposta), aplica o texto sobre título e nome do local e o intervalo sobre eventDate, ordena por data. Calcula isFull por evento contando as inscrições confirmadas (calculoVagasOcupadas) e comparando com o número de vagas (listaEsperaQuandoVagasEsgotadas); o campo é derivado, nunca gravado.",
        "output": "{ items, page, pageSize, hasMore } com id, título, data, nome do local e indicador de lotado, para a lista e para abrir o evento."
      }
    },
    {
      "id": "qryDetalheEvento",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "eventoId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "evento",
          "type": "EventoDetalhe"
        }
      ],
      "rules": [
        "inscricaoSomenteEventoPublicado",
        "calculoVagasOcupadas",
        "calculoVagasRestantes",
        "listaEsperaQuandoVagasEsgotadas"
      ],
      "jsdoc": {
        "purpose": "Abre a página pública do evento escolhido com descrição, local e disponibilidade de vagas.",
        "input": "eventoId: id do evento selecionado na lista ou vindo da URL.",
        "processing": "Lê o evento pelo id e recusa (não encontrado) se não estiver publicado (inscricaoSomenteEventoPublicado). Conta inscrições confirmadas para vagas ocupadas (calculoVagasOcupadas), calcula vagas restantes = vagas − ocupadas, nunca abaixo de zero (calculoVagasRestantes), isFull quando ocupadas alcançam as vagas (listaEsperaQuandoVagasEsgotadas) e o tamanho da lista de espera contando inscrições em espera. Tudo calculado, nada gravado.",
        "output": "O evento com título, data, descrição, local e endereço, vagas, vagas restantes, lotado e tamanho da lista de espera, usado pelo detalhe e pela ação de inscrição."
      }
    },
    {
      "id": "cmdInscreverMe",
      "kind": "cmd",
      "when": "inscreverMe",
      "writes": "Inscricao.create",
      "input": [
        {
          "name": "eventoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Inscricao.eventoId"
            ]
          }
        },
        {
          "name": "participante.details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.identification.name"
            ]
          }
        },
        {
          "name": "participante.details.base.contacts",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.base.contacts"
            ]
          }
        },
        {
          "name": "participante.details.identification.countryCode",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.identification.countryCode"
            ]
          }
        },
        {
          "name": "participante.details.person.privacyConsent",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Participante.details.person.privacyConsent"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "inscricao",
          "type": "InscricaoResultado"
        },
        {
          "name": "evento",
          "type": "EventoDetalhe"
        }
      ],
      "rules": [
        "inscricaoSomenteEventoPublicado",
        "inscricaoUnicaPorEmailEvento",
        "umaInscricaoPorEmailPorEvento",
        "inscricaoExcedenteVaiParaListaEspera",
        "listaEsperaQuandoVagasEsgotadas",
        "ordemChegadaListaEspera",
        "calculoPosicaoListaEspera",
        "calculoVagasOcupadas",
        "calculoVagasRestantes"
      ],
      "jsdoc": {
        "purpose": "Inscreve a pessoa no evento aberto com nome e e-mail, garantindo vaga ou lugar na lista de espera.",
        "input": "eventoId: evento da página; name: nome informado; email: e-mail de contato da pessoa; countryCode: país (ISO 3166-1 alfa-2); privacyConsent: aceite LGPD/GDPR, exigido conforme o país.",
        "processing": "Recusa se o evento não estiver publicado (inscricaoSomenteEventoPublicado). Localiza ou cria o participante pelo e-mail (register.createOrAttach, link.contact) gravando o consentimento. Recusa se o e-mail já tiver inscrição confirmada ou em lista de espera no evento (inscricaoUnicaPorEmailEvento, umaInscricaoPorEmailPorEvento). Dentro da mesma transação conta as vagas ocupadas (calculoVagasOcupadas): se houver vaga restante cria como confirmada, senão como em lista de espera (inscricaoExcedenteVaiParaListaEspera, listaEsperaQuandoVagasEsgotadas). O sistema registra receivedAt e emite o código da inscrição. Calcula ocupaVaga e a posição na lista de espera pelas inscrições em espera que chegaram antes, mais um (ordemChegadaListaEspera, calculoPosicaoListaEspera), e recalcula a disponibilidade do evento (calculoVagasRestantes); derivados nunca são gravados.",
        "output": "A inscrição criada (código, recebida em, ocupa vaga, posição na lista de espera) para mostrar o resultado, e o evento com disponibilidade atualizada para redesenhar o detalhe sem nova chamada."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "eventosPublicados",
        "reads": "qryEventosPublicados.eventos"
      },
      {
        "organism": "detalheEvento",
        "reads": "qryDetalheEvento.evento"
      },
      {
        "organism": "acaoInscricao",
        "reads": "qryDetalheEvento.evento"
      },
      {
        "organism": "acaoInscricao",
        "reads": "cmdInscreverMe.inscricao"
      }
    ],
    "commands": [
      {
        "endpoint": "cmdInscreverMe",
        "refreshes": []
      }
    ],
    "selections": [
      {
        "organism": "eventosPublicados",
        "via": {
          "query": "qryDetalheEvento"
        }
      },
      {
        "organism": "detalheEvento",
        "via": {
          "list": "qryDetalheEvento.evento"
        }
      }
    ],
    "journeys": [
      {
        "step": "inscreverEmEvento/localizarEvento",
        "organisms": [
          "eventosPublicados"
        ],
        "endpoints": [
          "qryEventosPublicados"
        ]
      },
      {
        "step": "inscreverEmEvento/verEvento",
        "organisms": [
          "detalheEvento"
        ],
        "endpoints": [
          "qryDetalheEvento"
        ]
      },
      {
        "step": "inscreverEmEvento/criarInscricao",
        "organisms": [
          "acaoInscricao"
        ],
        "endpoints": [
          "cmdInscreverMe"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "qryEventosPublicados",
        "state": "qryEventosPublicados.eventos",
        "mode": "replace"
      },
      {
        "endpoint": "qryEventosPublicados",
        "state": "qryEventosPublicados.eventos",
        "mode": "append"
      },
      {
        "endpoint": "cmdInscreverMe",
        "state": "qryDetalheEvento.evento",
        "mode": "replace"
      }
    ]
  }
}
