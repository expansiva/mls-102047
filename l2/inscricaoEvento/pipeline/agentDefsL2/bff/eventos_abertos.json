        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.id"
            ]
          }
        },
        {
          "name": "title",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.title"
            ]
          }
        },
        {
          "name": "eventDate",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Evento.eventDate"
            ]
          }
        },
        {
          "name": "details",
