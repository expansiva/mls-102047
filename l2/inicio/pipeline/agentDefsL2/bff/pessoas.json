{
  "types": [
    {
      "name": "PessoaResumo",
      "description": "Pessoa da organização com a situação do cadastro e do acesso.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.id"
            ]
          }
        },
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.countryCode",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.countryCode"
            ]
          }
        },
        {
          "name": "details.identification.status",
          "type": "'Active' | 'Inactive' | 'Merged' | 'Blocked'",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.status"
            ]
          }
        },
        {
          "name": "details.identification.updatedAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.updatedAt"
            ]
          }
        },
        {
          "name": "details.inicio.acessoCompleto",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.inicio.acessoCompleto"
            ]
          }
        },
        {
          "name": "details.inicio.dadosFaltantes",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.inicio.dadosFaltantes"
            ]
          }
        }
      ]
    },
    {
      "name": "ContatoPessoa",
      "description": "Canal de contato ligado à pessoa da organização.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Contato.id"
            ]
          }
        },
        {
          "name": "details.contactChannel.contactType",
          "type": "'Phone' | 'Email' | 'WhatsApp'",
          "origin": {
            "kind": "field",
            "paths": [
              "Contato.details.contactChannel.contactType"
            ]
          }
        },
        {
          "name": "details.contactChannel.value",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Contato.details.contactChannel.value"
            ]
          }
        },
        {
          "name": "details.contactChannel.isVerified",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Contato.details.contactChannel.isVerified"
            ]
          }
        }
      ]
    },
    {
      "name": "EmpresaResumo",
      "description": "Empresa da organização à qual a pessoa pertence.",
      "fields": [
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Empresa.details.identification.name"
            ]
          }
        }
      ]
    },
    {
      "name": "PessoaDetalhe",
      "description": "Cadastro da pessoa da organização com a situação do acesso, o que falta, a exigência de consentimento, seus contatos e a empresa.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.id"
            ]
          }
        },
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.countryCode",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.countryCode"
            ]
          }
        },
        {
          "name": "details.identification.status",
          "type": "'Active' | 'Inactive' | 'Merged' | 'Blocked'",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.status"
            ]
          }
        },
        {
          "name": "details.identification.createdAt",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.createdAt"
            ]
          }
        },
        {
          "name": "details.inicio.acessoCompleto",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.inicio.acessoCompleto"
            ]
          }
        },
        {
          "name": "details.inicio.dadosFaltantes",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.inicio.dadosFaltantes"
            ]
          }
        },
        {
          "name": "details.inicio.consentimentoExigido",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.inicio.consentimentoExigido"
            ]
          }
        },
        {
          "name": "contatos",
          "type": "ContatoPessoa[]"
        },
        {
          "name": "empresa",
          "type": "EmpresaResumo"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "qryPaginaPessoas",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "pessoas",
          "type": "PessoaResumo[]",
          "paginated": true
        },
        {
          "name": "pedidos",
          "type": "PessoaResumo[]"
        }
      ],
      "rules": [
        "prepararSomenteResponsavel",
        "acessoCompletoDadosMinimos",
        "liberacaoPeloResponsavel"
      ],
      "jsdoc": {
        "purpose": "Carrega ao abrir a página a primeira página das pessoas da organização e os pedidos de liberação, já com a situação do acesso de cada pessoa.",
        "input": "pageSize: tamanho da primeira página da lista de pessoas (opcional; padrão do servidor).",
        "processing": "Recusa quem não é o responsável da empresa (prepararSomenteResponsavel). Lista as pessoas com o papel inicio.PessoaOrganizacao da organização do responsável logado, ordenadas por updatedAt decrescente, página 1. Calcula na leitura acessoCompleto e dadosFaltantes conforme acessoCompletoDadosMinimos (nome, país e consentimento válido quando o país é Brasil ou UE; telefone não conta); nada é gravado. Os pedidos de liberação são derivados, sem pendência guardada (liberacaoPeloResponsavel): pessoas da organização cujo e-mail a plataforma não ligou sozinha e que ainda não têm acesso completo, ordenadas por updatedAt decrescente.",
        "output": "pessoas: { items, page, pageSize, hasMore } com PessoaResumo; pedidos: lista de PessoaResumo das pessoas aguardando liberação."
      }
    },
    {
      "id": "qryBuscarPessoas",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "somentePendentes",
          "type": "boolean",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "pessoas",
          "type": "PessoaResumo[]",
          "paginated": true
        }
      ],
      "rules": [
        "prepararSomenteResponsavel",
        "acessoCompletoDadosMinimos"
      ],
      "jsdoc": {
        "purpose": "Localiza pessoas da organização pelo nome e filtra quem ainda não completou o acesso, página a página.",
        "input": "busca: trecho do nome da pessoa; somentePendentes: quando verdadeiro, só pessoas sem acesso completo; page e pageSize: página pedida.",
        "processing": "Só o responsável pode consultar (prepararSomenteResponsavel). Procura por nome (locate.byName) entre as pessoas com papel inicio.PessoaOrganizacao da organização do responsável logado, ordena por updatedAt decrescente. Calcula acessoCompleto e dadosFaltantes na leitura conforme acessoCompletoDadosMinimos e, se somentePendentes, mantém só quem tem acessoCompleto falso.",
        "output": "pessoas: { items, page, pageSize, hasMore } com PessoaResumo que atendem à busca e ao filtro."
      }
    },
    {
      "id": "qryDetalhePessoa",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "pessoaId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "pessoa",
          "type": "PessoaDetalhe"
        }
      ],
      "rules": [
        "prepararSomenteResponsavel",
        "acessoCompletoDadosMinimos"
      ],
      "jsdoc": {
        "purpose": "Abre o cadastro da pessoa escolhida para o responsável conferir se é a pessoa certa e o que ainda falta.",
        "input": "pessoaId: id da pessoa escolhida na lista ou nos pedidos de liberação.",
        "processing": "Só o responsável, e só para pessoas da sua organização (prepararSomenteResponsavel). Lê a pessoa por id, seus canais ligados por HasContact e a empresa ligada por AssignedTo. Calcula na leitura consentimentoExigido (país Brasil ou UE), acessoCompleto e dadosFaltantes conforme acessoCompletoDadosMinimos. Não expõe o consentimento de privacidade, negado pelo grant.",
        "output": "pessoa: PessoaDetalhe com a situação do acesso, o que falta, a exigência de consentimento, os contatos e o nome da empresa."
      }
    },
    {
      "id": "cmdEnviarConvite",
      "kind": "cmd",
      "when": "enviarConvite",
      "writes": "PessoaOrganizacao.create",
      "input": [
        {
          "name": "contato.details.contactChannel.value",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Contato.details.contactChannel.value"
            ]
          }
        },
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.countryCode",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.countryCode"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "pessoa",
          "type": "PessoaResumo"
        }
      ],
      "rules": [
        "prepararSomenteResponsavel",
        "conviteDaPlataformaSemGuardar",
        "semDuplicarPessoaAoRepetir",
        "liberacaoPeloResponsavel",
        "preencherDadosNaoDaPermissao",
        "acessoCompletoDadosMinimos"
      ],
      "jsdoc": {
        "purpose": "Convida uma pessoa pelo e-mail com o convite da plataforma, seja uma pessoa nova ou a pessoa certa de um pedido de liberação.",
        "input": "contato.details.contactChannel.value: e-mail para o convite e login; details.identification.name: nome da pessoa; details.identification.countryCode: país (ISO 3166-1 alfa-2).",
        "processing": "Recusa quem não é o responsável (prepararSomenteResponsavel). Procura pessoa já ligada ao e-mail; se existe, usa esse cadastro e só anexa o papel, sem criar outra pessoa nem outro vínculo (semDuplicarPessoaAoRepetir, register.createOrAttach); se não existe, cadastra com nome e país e liga à empresa da organização do responsável. Dispara o convite da plataforma (invite.login), que liga o login à pessoa e libera o acesso de quem pediu (liberacaoPeloResponsavel); o módulo não guarda convites nem pendências (conviteDaPlataformaSemGuardar). Não concede papéis de módulos (preencherDadosNaoDaPermissao). acessoCompleto e dadosFaltantes são calculados na leitura, não gravados.",
        "output": "pessoa: PessoaResumo da pessoa convidada (nova ou existente), no estado atual, com a situação do acesso calculada."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "listaPessoas",
        "reads": "qryPaginaPessoas.pessoas"
      },
      {
        "organism": "detalhePessoa",
        "reads": "qryDetalhePessoa.pessoa"
      },
      {
        "organism": "pedidosLiberacao",
        "reads": "qryPaginaPessoas.pedidos"
      },
      {
        "organism": "acoesConvite",
        "reads": "qryPaginaPessoas.pedidos"
      }
    ],
    "commands": [
      {
        "endpoint": "cmdEnviarConvite",
        "refreshes": [
          "qryPaginaPessoas"
        ]
      }
    ],
    "selections": [
      {
        "organism": "listaPessoas",
        "via": {
          "query": "qryDetalhePessoa"
        }
      },
      {
        "organism": "pedidosLiberacao",
        "via": {
          "query": "qryDetalhePessoa"
        }
      },
      {
        "organism": "acoesConvite",
        "via": {
          "list": "qryPaginaPessoas.pedidos"
        }
      }
    ],
    "journeys": [
      {
        "step": "acompanharAcessos/listarPessoas",
        "organisms": [
          "listaPessoas"
        ],
        "endpoints": [
          "qryPaginaPessoas",
          "qryBuscarPessoas"
        ]
      },
      {
        "step": "acompanharAcessos/verSituacao",
        "organisms": [
          "listaPessoas",
          "detalhePessoa"
        ],
        "endpoints": [
          "qryBuscarPessoas",
          "qryDetalhePessoa"
        ]
      },
      {
        "step": "convidarPessoas/informarEmail",
        "organisms": [
          "acoesConvite",
          "formConvite"
        ],
        "endpoints": [
          "cmdEnviarConvite"
        ]
      },
      {
        "step": "convidarPessoas/conferirPessoa",
        "organisms": [
          "listaPessoas",
          "detalhePessoa"
        ],
        "endpoints": [
          "qryPaginaPessoas",
          "qryDetalhePessoa"
        ]
      },
      {
        "step": "liberarAcesso/localizarPessoa",
        "organisms": [
          "pedidosLiberacao",
          "listaPessoas"
        ],
        "endpoints": [
          "qryPaginaPessoas",
          "qryBuscarPessoas"
        ]
      },
      {
        "step": "liberarAcesso/conferirCadastro",
        "organisms": [
          "detalhePessoa"
        ],
        "endpoints": [
          "qryDetalhePessoa"
        ]
      },
      {
        "step": "liberarAcesso/convidarPessoaCerta",
        "organisms": [
          "acoesConvite",
          "formConvite"
        ],
        "endpoints": [
          "cmdEnviarConvite"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "qryBuscarPessoas",
        "state": "qryPaginaPessoas.pessoas",
        "mode": "replace"
      },
      {
        "endpoint": "cmdEnviarConvite",
        "state": "qryPaginaPessoas.pessoas",
        "mode": "upsert"
      }
    ]
  }
}
