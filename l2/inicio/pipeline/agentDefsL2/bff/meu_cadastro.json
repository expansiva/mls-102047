{
  "types": [
    {
      "name": "EmpresaDaPessoa",
      "description": "A empresa da organização à qual a pessoa está ligada, com o nome que a pessoa pode ver.",
      "fields": [
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Empresa.details.identification.name"
            ]
          }
        }
      ]
    },
    {
      "name": "MeuCadastro",
      "description": "O cadastro da própria pessoa na organização, com a situação do acesso, os dados mínimos que faltam, os contatos, os vínculos e a empresa a que pertence.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.version"
            ]
          }
        },
        {
          "name": "details.identification.name",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.countryCode",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.countryCode"
            ]
          }
        },
        {
          "name": "details.identification.status",
          "type": "'Active' | 'Inactive' | 'Merged' | 'Blocked'",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.status"
            ]
          }
        },
        {
          "name": "details.base.contacts",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.base.contacts"
            ]
          }
        },
        {
          "name": "details.base.relationshipRefs",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.base.relationshipRefs"
            ]
          }
        },
        {
          "name": "details.inicio.acessoCompleto",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.inicio.acessoCompleto"
            ]
          }
        },
        {
          "name": "details.inicio.dadosFaltantes",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.inicio.dadosFaltantes"
            ]
          }
        },
        {
          "name": "details.inicio.consentimentoExigido",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.inicio.consentimentoExigido"
            ]
          }
        },
        {
          "name": "aguardaLiberacao",
          "type": "boolean",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "PessoaOrganizacao.details.identification.status",
              "PessoaOrganizacao.details.base.contacts",
              "PessoaOrganizacao.details.base.relationshipRefs"
            ]
          }
        },
        {
          "name": "empresa",
          "type": "EmpresaDaPessoa"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "qryMeuCadastro",
      "kind": "qry",
      "when": "onLoad",
      "input": [],
      "output": [
        {
          "name": "meuCadastro",
          "type": "MeuCadastro"
        }
      ],
      "rules": [
        "acessoCompletoDadosMinimos",
        "naoPedirDadoJaExistente",
        "ligacaoLoginPelaPlataforma",
        "seguirDiretoSeCompleto",
        "repetirNaoDuplicaPessoa",
        "emailContaNaoEditavel"
      ],
      "jsdoc": {
        "purpose": "Carrega, em uma só chamada, o cadastro da pessoa logada na organização com a situação do acesso, o que falta, o aviso de liberação e o andamento do pedido.",
        "input": "Nenhuma entrada: a pessoa é a da sessão, resolvida pela plataforma (locate.byLogin).",
        "processing": "Lê o PessoaOrganizacao da sessão (read.byId) e o nome da Empresa ligada por AssignedTo. Calcula, sem gravar, acessoCompleto, dadosFaltantes e consentimentoExigido conforme acessoCompletoDadosMinimos (nome e país, e consentimento válido se o país for Brasil ou União Europeia; telefone não conta) e naoPedirDadoJaExistente (só lista o que a plataforma ainda não tem). Calcula aguardaLiberacao a partir da situação, dos contatos e dos vínculos quando já existe outro cadastro com o mesmo e-mail, sem guardar pendência nem decidir a ligação (ligacaoLoginPelaPlataforma); como é recalculado a cada leitura, o aviso persiste em outro navegador (repetirNaoDuplicaPessoa). O e-mail da conta vem nos contatos apenas para exibição (emailContaNaoEditavel). acessoCompleto verdadeiro indica que a pessoa pode seguir direto aos módulos (seguirDiretoSeCompleto).",
        "output": "meuCadastro: o cadastro atual da pessoa com id, versão, nome, país, situação, contatos, vínculos, acesso completo, dados que faltam, consentimento exigido, indicador de aguardar liberação e o nome da empresa."
      }
    },
    {
      "id": "salvarMeusDados",
      "kind": "cmd",
      "when": "salvarMeusDados",
      "writes": "PessoaOrganizacao.update",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.version"
            ]
          }
        },
        {
          "name": "details.identification.name",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.countryCode",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.countryCode"
            ]
          }
        },
        {
          "name": "details.person.privacyConsent",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.person.privacyConsent"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "meuCadastro",
          "type": "MeuCadastro"
        }
      ],
      "rules": [
        "acessoCompletoDadosMinimos",
        "naoPedirDadoJaExistente",
        "emailContaNaoEditavel",
        "repetirNaoDuplicaPessoa",
        "dadosNaoConcedemPermissoes"
      ],
      "jsdoc": {
        "purpose": "Grava no próprio cadastro da pessoa logada os dados mínimos que faltavam.",
        "input": "id e version: o cadastro da pessoa e a versão lida, para concorrência otimista. details.identification.name: nome, quando faltava. details.identification.countryCode: país ISO 3166-1 alfa-2, quando faltava. details.person.privacyConsent: consentimento de privacidade, enviado quando o país exige (Brasil ou União Europeia).",
        "processing": "Recusa se o id não for o cadastro da pessoa da sessão ou se a versão estiver desatualizada. Atualiza pelo PessoaOrganizacao.update apenas os campos ainda vazios, sem sobrescrever o que a plataforma já tem (naoPedirDadoJaExistente). Recusa qualquer alteração do e-mail da conta (emailContaNaoEditavel). Exige consentimento quando o país informado ou existente é Brasil ou União Europeia (acessoCompletoDadosMinimos). É idempotente: repetir o envio atualiza o mesmo cadastro e nunca cria outra pessoa nem outro vínculo (repetirNaoDuplicaPessoa). Não concede papéis nem permissões (dadosNaoConcedemPermissoes). acessoCompleto, dadosFaltantes e consentimentoExigido são recalculados, nunca gravados.",
        "output": "meuCadastro: o cadastro da pessoa no novo estado, com a nova versão, o acesso completo e os dados que ainda faltam recalculados, contatos, vínculos, aviso de liberação e nome da empresa."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "meuCadastroResumo",
        "reads": "qryMeuCadastro.meuCadastro"
      },
      {
        "organism": "avisoLiberacao",
        "reads": "qryMeuCadastro.meuCadastro"
      },
      {
        "organism": "dadosMinimosForm",
        "reads": "qryMeuCadastro.meuCadastro"
      },
      {
        "organism": "acoesMeuCadastro",
        "reads": "qryMeuCadastro.meuCadastro"
      },
      {
        "organism": "andamentoLiberacao",
        "reads": "qryMeuCadastro.meuCadastro"
      }
    ],
    "commands": [
      {
        "endpoint": "salvarMeusDados",
        "refreshes": []
      }
    ],
    "selections": [],
    "journeys": [
      {
        "step": "aguardarLiberacaoAcesso/verAvisoLiberacao",
        "organisms": [
          "avisoLiberacao",
          "andamentoLiberacao"
        ],
        "endpoints": [
          "qryMeuCadastro"
        ]
      },
      {
        "step": "completarMeuAcesso/verMeuCadastro",
        "organisms": [
          "meuCadastroResumo",
          "dadosMinimosForm"
        ],
        "endpoints": [
          "qryMeuCadastro"
        ]
      },
      {
        "step": "completarMeuAcesso/preencherDadosMinimos",
        "organisms": [
          "dadosMinimosForm",
          "acoesMeuCadastro"
        ],
        "endpoints": [
          "salvarMeusDados"
        ]
      },
      {
        "step": "completarMeuAcesso/seguirParaModulos",
        "organisms": [
          "acoesMeuCadastro"
        ],
        "endpoints": [
          "qryMeuCadastro",
          "salvarMeusDados"
        ],
        "continuesIn": "inicio_pessoa"
      }
    ],
    "updates": [
      {
        "endpoint": "salvarMeusDados",
        "state": "qryMeuCadastro.meuCadastro",
        "mode": "replace"
      }
    ]
  }
}
