{
  "types": [
    {
      "name": "MeuAcesso",
      "description": "Cadastro da pessoa da organização ligada à sessão, com a situação dos seus dados mínimos.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.id"
            ]
          }
        },
        {
          "name": "details",
          "type": "MeuAcessoDetalhes"
        }
      ]
    },
    {
      "name": "MeuAcessoDetalhes",
      "description": "Detalhes do cadastro da pessoa: identificação e situação do acesso.",
      "fields": [
        {
          "name": "identification",
          "type": "MeuAcessoIdentificacao"
        },
        {
          "name": "inicio",
          "type": "MeuAcessoInicio"
        }
      ]
    },
    {
      "name": "MeuAcessoIdentificacao",
      "description": "Identificação da pessoa na plataforma.",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.name"
            ]
          }
        },
        {
          "name": "countryCode",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.countryCode"
            ]
          }
        },
        {
          "name": "status",
          "type": "'Active' | 'Inactive' | 'Merged' | 'Blocked'",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.identification.status"
            ]
          }
        }
      ]
    },
    {
      "name": "MeuAcessoInicio",
      "description": "Situação calculada do acesso da pessoa a partir dos dados mínimos.",
      "fields": [
        {
          "name": "acessoCompleto",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.inicio.acessoCompleto"
            ]
          }
        },
        {
          "name": "dadosFaltantes",
          "type": "string[]",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.inicio.dadosFaltantes"
            ]
          }
        },
        {
          "name": "consentimentoExigido",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.inicio.consentimentoExigido"
            ]
          }
        }
      ]
    },
    {
      "name": "PendenciaAcesso",
      "description": "Algo que espera pela pessoa para concluir o seu acesso: pedir a liberação ao responsável ou completar os dados mínimos.",
      "fields": [
        {
          "name": "tipo",
          "type": "'pedirLiberacao' | 'completarDadosMinimos'",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "PessoaOrganizacao.details.identification.status",
              "PessoaOrganizacao.details.base.contacts",
              "PessoaOrganizacao.details.inicio.acessoCompleto"
            ]
          }
        },
        {
          "name": "emailConta",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "aggregate",
            "paths": [
              "PessoaOrganizacao.details.base.contacts"
            ]
          }
        },
        {
          "name": "details.inicio.dadosFaltantes",
          "type": "string[]",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "PessoaOrganizacao.details.inicio.dadosFaltantes"
            ]
          }
        }
      ]
    },
    {
      "name": "EmpresaDestaque",
      "description": "Empresa à qual a pessoa pertence, com os campos que a pessoa pode ver.",
      "fields": [
        {
          "name": "details",
          "type": "EmpresaDestaqueDetalhes"
        }
      ]
    },
    {
      "name": "EmpresaDestaqueDetalhes",
      "description": "Detalhes visíveis da empresa: nome e nome fantasia.",
      "fields": [
        {
          "name": "identification",
          "type": "EmpresaDestaqueIdentificacao"
        },
        {
          "name": "company",
          "type": "EmpresaDestaqueCompanhia"
        }
      ]
    },
    {
      "name": "EmpresaDestaqueIdentificacao",
      "description": "Identificação visível da empresa.",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Empresa.details.identification.name"
            ]
          }
        }
      ]
    },
    {
      "name": "EmpresaDestaqueCompanhia",
      "description": "Dados de pessoa jurídica visíveis da empresa.",
      "fields": [
        {
          "name": "tradeName",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Empresa.details.company.tradeName"
            ]
          }
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "qryInicioPessoa",
      "kind": "qry",
      "when": "onLoad",
      "input": [],
      "output": [
        {
          "name": "meuAcesso",
          "type": "MeuAcesso"
        },
        {
          "name": "pendencias",
          "type": "PendenciaAcesso[]"
        },
        {
          "name": "empresa",
          "type": "EmpresaDestaque",
          "optional": true
        }
      ],
      "rules": [
        "acessoCompletoDadosMinimos",
        "ligacaoLoginPelaPlataforma",
        "naoPedirDadoJaExistente",
        "emailContaNaoEditavel",
        "seguirDiretoSeCompleto"
      ],
      "jsdoc": {
        "purpose": "Carrega de uma vez, ao abrir o Início da pessoa, a situação do seu acesso, as pendências que esperam por ela e a empresa à qual pertence.",
        "input": "Nenhuma entrada: a pessoa é a da sessão, resolvida pela plataforma a partir do login (locate.byLogin).",
        "processing": "Lê o cadastro PessoaOrganizacao da pessoa logada (read.byId) e calcula, sem gravar, acessoCompleto, dadosFaltantes e consentimentoExigido (inicio.verificarAcessoCompleto). acessoCompletoDadosMinimos: completo quando há nome e país e, se o país for Brasil ou da União Europeia, consentimento de privacidade válido; telefone não conta. naoPedirDadoJaExistente: dadosFaltantes lista só o que a plataforma ainda não tem. Monta as pendências: ligacaoLoginPelaPlataforma — quando os contatos indicam que já existe outro cadastro com o mesmo e-mail e o login não está ligado, gera uma pendência 'pedirLiberacao' com o e-mail da conta, sem guardar a pendência nem decidir a ligação; quando o login está ligado e o acesso não está completo, gera 'completarDadosMinimos' com os dados que faltam. Se o acesso está completo e ligado, a lista vem vazia (seguirDiretoSeCompleto). emailContaNaoEditavel: o e-mail vem apenas para leitura, extraído dos contatos. Lê a empresa ligada por AssignedTo e devolve apenas nome e nome fantasia, conforme o grant pessoaVerEmpresa.",
        "output": "meuAcesso: o cadastro da pessoa com nome, país, situação na plataforma e os valores calculados de acesso completo, dados que faltam e consentimento exigido. pendencias: lista curta, não paginada, das pendências da pessoa com tipo, e-mail da conta e dados faltantes. empresa: nome e nome fantasia da empresa da pessoa."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "resumoMeuAcesso",
        "reads": "qryInicioPessoa.meuAcesso"
      },
      {
        "organism": "pendenciasMeuAcesso",
        "reads": "qryInicioPessoa.pendencias"
      },
      {
        "organism": "pendenciasMeuAcesso",
        "reads": "qryInicioPessoa.meuAcesso"
      },
      {
        "organism": "destaqueEmpresa",
        "reads": "qryInicioPessoa.empresa"
      }
    ],
    "commands": [],
    "selections": [],
    "journeys": [
      {
        "step": "aguardarLiberacaoAcesso/verAvisoLiberacao",
        "organisms": [
          "pendenciasMeuAcesso",
          "resumoMeuAcesso"
        ],
        "endpoints": [
          "qryInicioPessoa"
        ]
      },
      {
        "step": "completarMeuAcesso/verMeuCadastro",
        "organisms": [
          "resumoMeuAcesso",
          "pendenciasMeuAcesso"
        ],
        "endpoints": [
          "qryInicioPessoa"
        ]
      },
      {
        "step": "completarMeuAcesso/preencherDadosMinimos",
        "organisms": [
          "pendenciasMeuAcesso"
        ],
        "endpoints": [],
        "continuesIn": "meu_cadastro"
      },
      {
        "step": "completarMeuAcesso/seguirParaModulos",
        "organisms": [
          "resumoMeuAcesso"
        ],
        "endpoints": [
          "qryInicioPessoa"
        ]
      }
    ],
    "updates": []
  }
}
