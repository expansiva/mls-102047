      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.id"
            ]
          }
        },
        {
          "name": "codigo",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.codigo"
            ]
          }
        },
        {
          "name": "descricao",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.descricao"
            ]
          }
        },
        {
          "name": "status",
          "type": "'disponivel' | 'emManutencao'",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.status"
            ]
          }
        },
        {
          "name": "details.situacaoAtual",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.details.situacaoAtual"
            ]
          }
        },
        {
          "name": "details.valorDiaria",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.details.valorDiaria"
            ]
          }
        }
      ]
    },
    {
      "name": "TotaisSituacao",
      "description": "Totais de equipamentos por situação atual, calculados no servidor.",
      "fields": [
        {
          "name": "disponiveis",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Equipamento.id",
              "Equipamento.details.situacaoAtual"
            ]
          }
        },
        {
          "name": "locados",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Equipamento.id",
              "Equipamento.details.situacaoAtual"
            ]
          }
        },
        {
          "name": "emManutencao",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
