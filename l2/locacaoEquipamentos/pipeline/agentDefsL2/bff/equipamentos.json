              "Equipamento.details.situacaoAtual"
            ]
          }
        }
      ]
    },
    {
      "name": "ContratoVigente",
      "description": "Contrato vigente que inclui o equipamento, com o item que o liga ao equipamento e o nome do cliente.",
      "fields": [
        {
