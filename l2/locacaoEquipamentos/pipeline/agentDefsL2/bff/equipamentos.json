  "endpoints": [
    {
      "id": "listarEquipamentos",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "situacaoAtual",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "equipamentos",
          "type": "EquipamentoResumo[]",
          "paginated": true
        }
      ],
      "rules": [
        "equipamentoLocadoDecorreDeContratoAtivo"
      ],
      "jsdoc": {
        "purpose": "Carrega, ao abrir a página, a lista paginada de equipamentos e a refaz quando a pessoa pesquisa por código ou descrição ou filtra pela situação atual, para saber o que está livre para locar.",
        "input": "busca: parte do código ou da descrição (ILIKE), opcional; situacaoAtual: filtro opcional por disponivel, locado ou emManutencao; page e pageSize: página pedida e tamanho da página.",
        "processing": "Pesquisa Equipamento por código ou descrição (locate.byText) ordenado por código. Para cada equipamento da página calcula situacaoAtual conforme equipamentoLocadoDecorreDeContratoAtivo: emManutencao quando a situação cadastral é emManutencao, locado quando existe ItemContrato em contrato ativo sem data real de devolução, senão disponivel; o valor é derivado, nunca gravado. Os itens de contrato da página são buscados de uma vez (listByForeignKey por vários equipamentos), sem uma consulta por linha. O filtro por situacaoAtual é aplicado sobre esse cálculo.",
        "output": "equipamentos paginado { items, page, pageSize, hasMore } com id, código, descrição, situação cadastral, diária e situação atual de cada equipamento, já no formato da lista."
      }
    },
    {
      "id": "obterEquipamento",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "equipamentoId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "equipamento",
          "type": "EquipamentoFicha"
        }
      ],
      "rules": [
        "equipamentoLocadoDecorreDeContratoAtivo"
      ],
      "jsdoc": {
        "purpose": "Carrega a ficha do equipamento escolhido na lista: dados cadastrais, situação atual, se está locado e o contrato atual com cliente e período.",
        "input": "equipamentoId: id do equipamento selecionado na lista.",
        "processing": "Lê o Equipamento por id (read.byId); busca seus itens de contrato (listByForeignKey por equipamentoId) e identifica o contrato ativo sem data real de devolução. Calcula locado, contratoAtual (id do contrato, usado também para abrir o contrato) e situacaoAtual conforme equipamentoLocadoDecorreDeContratoAtivo (emManutencao quando assim cadastrado, locado quando há contrato ativo sem devolução, senão disponivel); são derivados, nunca gravados. Para o contrato atual traz número, situação, retirada e devolução prevista, e lê no cadastro mestre apenas o nome do cliente (read.mdmRecord), campo permitido ao gerente.",
        "output": "equipamento com id, version, código, descrição, situação cadastral, diária, situação atual, locado e contratoAtual (id, número, situação, período e cliente; ausente quando não locado), usado pela ficha, pelo cadastro e pelas ações da página."
      }
    }
  ],
  "bindings": {
