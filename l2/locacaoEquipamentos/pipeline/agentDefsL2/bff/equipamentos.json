          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ContratoLocacao.numero"
            ]
          }
        },
        {
          "name": "clienteId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ContratoLocacao.clienteId"
            ]
          }
        },
        {
          "name": "status",
          "type": "'rascunho' | 'vigente' | 'encerrado'",
          "origin": {
            "kind": "field",
            "paths": [
              "ContratoLocacao.status"
            ]
          }
        },
        {
          "name": "dataRetirada",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ContratoLocacao.dataRetirada"
            ]
          }
        },
        {
          "name": "dataPrevistaDevolucao",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ContratoLocacao.dataPrevistaDevolucao"
            ]
          }
        },
        {
          "name": "details.atrasado",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "ContratoLocacao.details.atrasado"
            ]
          }
        },
        {
          "name": "cliente.details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.details.identification.name"
            ]
          }
        },
        {
          "name": "itemContrato.contratoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemContrato.contratoId"
            ]
          }
        },
        {
          "name": "itemContrato.equipamentoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemContrato.equipamentoId"
            ]
          }
        }
      ]
    },
    {
      "name": "EquipamentoFicha",
      "description": "Ficha completa do equipamento: dados de cadastro, situação calculada e contrato vigente quando locado.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.version"
            ]
          }
        },
        {
          "name": "codigo",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.codigo"
            ]
          }
        },
        {
          "name": "descricao",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.descricao"
            ]
          }
        },
        {
          "name": "status",
          "type": "'disponivel' | 'emManutencao'",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.status"
            ]
          }
        },
        {
          "name": "details.valorDiaria",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.details.valorDiaria"
            ]
          }
        },
        {
          "name": "details.situacaoAtual",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.details.situacaoAtual"
            ]
          }
        },
        {
          "name": "details.locado",
          "type": "boolean",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.details.locado"
            ]
          }
        },
        {
          "name": "details.dataPrevistaDevolucao",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.details.dataPrevistaDevolucao"
            ]
          }
        },
        {
          "name": "details.contratoVigente",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.details.contratoVigente"
            ]
          }
        },
        {
          "name": "contratoVigente",
          "type": "ContratoVigente",
          "optional": true
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "listarEquipamentos",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Equipamento.codigo",
              "Equipamento.descricao"
            ]
          }
        },
        {
          "name": "details.situacaoAtual",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.details.situacaoAtual"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "equipamentos",
          "type": "EquipamentoResumo[]",
          "paginated": true
        },
        {
          "name": "totais",
          "type": "TotaisSituacao"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Carrega, ao abrir a página e a cada pesquisa ou troca de filtro, a lista paginada de equipamentos com a situação atual e os totais por situação.",
        "input": "busca: trecho do código ou da descrição (opcional); situacao: filtro pela situação atual — disponível, locado ou em manutenção (opcional); page e pageSize: página pedida e tamanho da página.",
        "processing": "Filtra os equipamentos por trecho de código ou descrição e pela situação atual, ordenados por código. A situação atual é calculada, nunca gravada: em manutenção quando status = emManutencao; locado quando existe contrato vigente com item apontando para o equipamento ainda sem devolução; disponível nos demais casos. Os totais contam os equipamentos por situação atual sobre todo o cadastro (sem a busca), para o painel do gerente.",
        "output": "equipamentos paginado ({ items, page, pageSize, hasMore }) para a lista e totais de disponíveis, locados e em manutenção já calculados."
      }
    },
    {
      "id": "obterEquipamento",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.id"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "equipamento",
          "type": "EquipamentoFicha"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Abre a ficha do equipamento escolhido na lista, com situação, diária, contrato vigente e devolução prevista.",
        "input": "equipamentoId: id do equipamento selecionado na lista.",
        "processing": "Lê o equipamento pelo id e calcula locado, situação atual, contrato vigente (id e dados) e data prevista de devolução a partir dos itens de contrato (por equipamentoId) cujo contrato está vigente e sem devolução registrada. Quando há contrato vigente, compõe número, cliente (nome lido do cadastro mestre), situação, datas de retirada e devolução prevista e o indicador de atraso (calculado: vigente com devolução prevista já passada). Campos derivados são calculados, nunca gravados.",
        "output": "equipamento: a ficha completa com version e a referência do contrato vigente, usada pelo detalhe, pelo formulário de dados e pelas ações de manutenção."
      }
    },
    {
      "id": "enviarManutencao",
      "kind": "cmd",
      "when": "enviarManutencao",
      "writes": "Equipamento.enviarManutencao",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "equipamento",
          "type": "EquipamentoFicha"
        }
      ],
      "rules": [
        "equipamentoLocadoNaoVaiManutencao"
      ],
      "jsdoc": {
        "purpose": "Envia o equipamento para manutenção, retirando-o de operação.",
        "input": "id e version do equipamento, para controle de concorrência otimista.",
        "processing": "Executa a transição enviarManutencao (disponivel → emManutencao), permitida ao gerente. Aplica equipamentoLocadoNaoVaiManutencao: recusa se houver contrato de locação vigente com item deste equipamento ainda sem devolução registrada. Recusa também se a version não confere.",
        "output": "equipamento: a ficha atualizada, que redesenha detalhe e ações sem nova consulta."
      }
    },
    {
      "id": "retornarManutencao",
      "kind": "cmd",
      "when": "retornarManutencao",
      "writes": "Equipamento.retornarManutencao",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Equipamento.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "equipamento",
          "type": "EquipamentoFicha"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Retorna o equipamento da manutenção à operação, deixando-o disponível para novas locações.",
        "input": "id e version do equipamento, para controle de concorrência otimista.",
        "processing": "Executa a transição retornarManutencao (emManutencao → disponivel), permitida ao gerente; recusa se o equipamento não está em manutenção ou se a version não confere.",
        "output": "equipamento: a ficha atualizada, que redesenha detalhe e ações sem nova consulta."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "listaEquipamentos",
        "reads": "listarEquipamentos.equipamentos"
      },
      {
        "organism": "listaEquipamentos",
        "reads": "listarEquipamentos.totais"
      },
      {
        "organism": "detalheEquipamento",
        "reads": "obterEquipamento.equipamento"
      },
      {
        "organism": "dadosEquipamento",
        "reads": "obterEquipamento.equipamento"
      },
      {
        "organism": "acoesManutencao",
        "reads": "obterEquipamento.equipamento"
      }
    ],
    "commands": [
      {
        "endpoint": "enviarManutencao",
        "refreshes": [
          "listarEquipamentos"
        ]
      },
      {
        "endpoint": "retornarManutencao",
        "refreshes": [
          "listarEquipamentos"
        ]
      }
    ],
    "selections": [
      {
        "organism": "listaEquipamentos",
        "via": {
          "query": "obterEquipamento"
        }
      }
    ],
    "journeys": [
      {
        "step": "acompanharSituacaoEquipamentos/filtrarPorSituacao",
        "organisms": [
          "listaEquipamentos"
        ],
        "endpoints": [
          "listarEquipamentos"
        ]
      },
      {
        "step": "acompanharSituacaoEquipamentos/verEquipamento",
        "organisms": [
          "detalheEquipamento"
        ],
        "endpoints": [
          "obterEquipamento"
        ]
      },
      {
        "step": "enviarEquipamentoManutencao/localizarEquipamento",
        "organisms": [
          "listaEquipamentos"
        ],
        "endpoints": [
          "listarEquipamentos"
        ]
      },
      {
        "step": "enviarEquipamentoManutencao/conferirEquipamento",
        "organisms": [
          "detalheEquipamento",
          "acoesManutencao"
        ],
        "endpoints": [
          "obterEquipamento"
        ]
      },
      {
        "step": "enviarEquipamentoManutencao/enviarManutencao",
        "organisms": [
          "acoesManutencao"
        ],
        "endpoints": [
          "enviarManutencao"
        ]
      },
      {
        "step": "retornarEquipamentoManutencao/localizarEmManutencao",
        "organisms": [
          "listaEquipamentos"
        ],
        "endpoints": [
          "listarEquipamentos",
          "obterEquipamento"
        ]
      },
      {
        "step": "retornarEquipamentoManutencao/retornarManutencao",
        "organisms": [
          "acoesManutencao"
        ],
        "endpoints": [
          "retornarManutencao"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "listarEquipamentos",
        "state": "listarEquipamentos.equipamentos",
        "mode": "replace"
      },
      {
        "endpoint": "obterEquipamento",
        "state": "obterEquipamento.equipamento",
        "mode": "replace"
      },
      {
        "endpoint": "enviarManutencao",
        "state": "obterEquipamento.equipamento",
        "mode": "replace"
      },
      {
        "endpoint": "retornarManutencao",
        "state": "obterEquipamento.equipamento",
        "mode": "replace"
      }
    ]
  }
}
