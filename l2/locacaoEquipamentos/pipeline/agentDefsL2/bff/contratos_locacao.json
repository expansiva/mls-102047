          "name": "contrato",
          "type": "ContratoDetalhe"
        }
      ],
      "rules": [
        "contratoExigeItem",
        "contratoComAoMenosUmItem",
        "equipamentoSemSobreposicao",
        "equipamentoDisponivelParaLocar",
        "equipamentoEmManutencaoNaoLoca"
      ],
      "jsdoc": {
        "purpose": "Confirma o contrato em elaboração, passando-o a ativo e os equipamentos a locados.",
        "input": "contratoId e version: contrato a confirmar e versão para concorrência otimista.",
        "processing": "Transição ativarContrato (rascunho → ativo) em transação. Recusa sem ao menos um item (contratoExigeItem, contratoComAoMenosUmItem), com equipamento em manutenção (equipamentoEmManutencaoNaoLoca), indisponível (equipamentoDisponivelParaLocar) ou em outro contrato com período sobreposto (equipamentoSemSobreposicao). O estado locado dos equipamentos é derivado, não gravado.",
        "output": "ContratoDetalhe com status ativo para redesenhar conferência e ações."
      }
    },
