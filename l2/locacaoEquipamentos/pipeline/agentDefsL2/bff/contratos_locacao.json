  "endpoints": [
    {
      "id": "listarContratos",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "status",
          "type": "'rascunho' | 'ativo' | 'encerrado'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "ContratoLocacao.status"
            ]
          }
        },
        {
          "name": "somenteAtrasados",
          "type": "boolean",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "contratos",
          "type": "ContratoResumo[]",
          "paginated": true
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Carrega a lista paginada de contratos de locação ao abrir a página e a cada pesquisa, já com o nome do cliente, a quantidade de equipamentos e o indicador de atraso.",
        "input": "busca: texto livre comparado ao número do contrato ou ao nome do cliente; status: filtra pela situação do contrato; somenteAtrasados: quando verdadeiro traz só contratos em atraso; page/pageSize: paginação.",
        "processing": "Localiza contratos por número (locate.byText) ou pelo nome do cliente resolvido no cadastro mestre, aplica os filtros de situação e atraso, ordena trazendo os atrasados primeiro e depois pela data prevista de devolução. Compõe o nome do cliente via read.mdmRecord. atrasado (ativo sem devolução com prevista anterior a hoje, ou encerrado devolvido após a prevista) e quantidadeItens (contagem de itens) são campos derivados calculados na leitura, nunca gravados.",
        "output": "Página { items, page, pageSize, hasMore } de ContratoResumo para a lista localizar e priorizar contratos."
      }
    },
    {
      "id": "obterContrato",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "contratoId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "contrato",
          "type": "ContratoDetalhe"
        }
      ],
      "rules": [
        "multaPorAtraso",
        "multaAtrasoDevolucao"
      ],
      "jsdoc": {
        "purpose": "Carrega o contrato selecionado na lista com cliente, período, itens, dias de atraso e multa, para conferência e ações.",
        "input": "contratoId: id do contrato escolhido na lista.",
        "processing": "Lê o contrato (read.byId), o nome e situação do cliente (read.mdmRecord), os itens pela chave contratoId e o código/descrição de cada equipamento. Calcula na leitura: diasPrevistos e valorPrevisto por item; diasAtraso do contrato e de cada item (real menos prevista quando posterior, senão zero); multaAtraso por item = diária praticada × dias de atraso × 1,5 (multaPorAtraso); valorMulta = soma das multas dos itens (multaAtrasoDevolucao); quantidadeItens. Nada disso é gravado.",
        "output": "ContratoDetalhe com os itens e os totais já calculados, usado pela conferência e pelas ações do contrato."
      }
    },
    {
      "id": "localizarClientes",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "nome",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "clientes",
          "type": "ClienteResumo[]"
        }
      ],
      "rules": [
        "clienteInativoNaoLoca"
      ],
      "jsdoc": {
        "purpose": "Localiza clientes pelo nome digitado para escolher o titular do novo contrato.",
        "input": "nome: parte do nome do cliente.",
        "processing": "Usa locate.byName no cadastro mestre, limitado a poucas dezenas de resultados. Retorna a situação cadastral para que a página sinalize e impeça a escolha de cliente inativo (clienteInativoNaoLoca).",
        "output": "Lista curta de clientes com id, nome e situação para seleção no formulário."
      }
    },
    {
      "id": "buscarEquipamentos",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "texto",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "dataRetirada",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "dataPrevistaDevolucao",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "equipamentos",
          "type": "EquipamentoOpcao[]"
        }
      ],
      "rules": [
        "equipamentoLocadoDecorreDeContratoAtivo",
        "equipamentoDisponivelParaLocar"
      ],
      "jsdoc": {
        "purpose": "Busca equipamentos pelo código ou descrição para incluir no contrato em montagem, mostrando situação atual e diária.",
        "input": "texto: parte do código ou da descrição; dataRetirada/dataPrevistaDevolucao: período do contrato em montagem, usado para conferir disponibilidade.",
        "processing": "Usa locate.byText (ILIKE) limitado a poucas dezenas de resultados. situacaoAtual é derivada na leitura (equipamentoLocadoDecorreDeContratoAtivo): emManutencao se cadastrado assim, locado se há contrato ativo sem devolução, senão disponível; com período informado, consulta consultarDisponibilidade para indicar se está livre no período (equipamentoDisponivelParaLocar).",
        "output": "Lista de equipamentos com código, descrição, situação atual e diária de referência para preencher o item."
      }
    },
    {
      "id": "abrirContrato",
      "kind": "cmd",
      "when": "abrirContrato",
      "writes": "ContratoLocacao.create",
      "input": [
        {
          "name": "clienteId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ContratoLocacao.clienteId"
            ]
          }
        },
        {
          "name": "dataRetirada",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ContratoLocacao.dataRetirada"
            ]
          }
        },
        {
          "name": "dataPrevistaDevolucao",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ContratoLocacao.dataPrevistaDevolucao"
            ]
          }
        },
        {
          "name": "details.observacoes",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "ContratoLocacao.details.observacoes"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "contrato",
          "type": "ContratoDetalhe"
        }
      ],
      "rules": [
        "clienteInativoNaoLoca",
        "contratoPeriodoValido"
      ],
      "jsdoc": {
        "purpose": "Cria o contrato em elaboração para o cliente escolhido com o período informado.",
        "input": "clienteId: cliente titular; dataRetirada e dataPrevistaDevolucao: período da locação; observacoes: anotações livres.",
        "processing": "Recusa cliente com registro mestre inativo (clienteInativoNaoLoca) e data prevista anterior à retirada (contratoPeriodoValido). Cria com status rascunho e número emitido pela sequência (sequence.next).",
        "output": "ContratoDetalhe recém-criado (sem itens), para o formulário seguir para a inclusão de equipamentos e o contrato ficar selecionado."
      }
    },
    {
      "id": "adicionarItem",
      "kind": "cmd",
      "when": "adicionarItem",
      "writes": "ItemContrato.create",
      "input": [
        {
          "name": "contratoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemContrato.contratoId"
            ]
          }
        },
        {
          "name": "equipamentoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemContrato.equipamentoId"
            ]
          }
        },
        {
          "name": "details.valorDiaria",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "ItemContrato.details.valorDiaria"
            ]
          }
        },
        {
          "name": "details.observacao",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "ItemContrato.details.observacao"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "contrato",
          "type": "ContratoDetalhe"
        }
      ],
      "rules": [
        "contratoEditavelSomenteEmElaboracao",
        "itemUnicoPorContrato",
        "equipamentoSemPeriodoSobreposto",
        "equipamentoSemPeriodosSobrepostos",
        "equipamentoDisponivelParaLocar",
        "equipamentoEmManutencaoNaoLocavel",
        "valorDiariaPositivo"
      ],
      "jsdoc": {
        "purpose": "Inclui um equipamento no contrato em elaboração com a diária praticada.",
        "input": "contratoId: contrato em elaboração; equipamentoId: equipamento escolhido; valorDiaria: diária praticada; observacao: acessórios ou estado na retirada.",
        "processing": "Recusa se o contrato não está em rascunho (contratoEditavelSomenteEmElaboracao), se o equipamento já está no contrato (itemUnicoPorContrato), se está em manutenção (equipamentoEmManutencaoNaoLocavel), se não está disponível no período (equipamentoDisponivelParaLocar) ou consta em outro contrato não encerrado com período sobreposto (equipamentoSemPeriodoSobreposto, equipamentoSemPeriodosSobrepostos), e se a diária não é maior que zero (valorDiariaPositivo). diasPrevistos e valorPrevisto são calculados na leitura, não gravados.",
        "output": "ContratoDetalhe atualizado com o novo item, dias e valor previstos, para redesenhar o formulário sem outra chamada."
      }
    },
    {
