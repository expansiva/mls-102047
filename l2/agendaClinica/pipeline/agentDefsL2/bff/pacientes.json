{
  "types": [
    {
      "name": "PatientListIdentification",
      "description": "Identificação resumida exibida em cada resultado da busca de pacientes.",
      "fields": [
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.status",
          "type": "'Active' | 'Inactive' | 'Merged' | 'Blocked'",
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.details.identification.status"
            ]
          }
        },
        {
          "name": "details.identification.docId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.details.identification.docId"
            ]
          }
        }
      ]
    },
    {
      "name": "PatientListDetails",
      "description": "Dados do paciente necessários para localizar e distinguir resultados pelo nome.",
      "fields": [
        {
          "name": "identification",
          "type": "PatientListIdentification"
        }
      ]
    },
    {
      "name": "PatientListItem",
      "description": "Paciente em formato compacto para a lista de localização.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.id"
            ]
          }
        },
        {
          "name": "details",
          "type": "PatientListDetails"
        }
      ]
    },
    {
      "name": "PatientIdentification",
      "description": "Identificação completa do paciente para conferência e após o cadastro.",
      "fields": [
        {
          "name": "details.identification.subtype",
          "type": "'Person'",
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.details.identification.subtype"
            ]
          }
        },
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.status",
          "type": "'Active' | 'Inactive' | 'Merged' | 'Blocked'",
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.details.identification.status"
            ]
          }
        },
        {
          "name": "details.identification.docType",
          "type": "'SSN' | 'EIN' | 'Passport' | 'DriversLicense' | 'NationalId' | 'CPF' | 'CNPJ' | 'VAT' | 'Other'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.details.identification.docType"
            ]
          }
        },
        {
          "name": "details.identification.docId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.details.identification.docId"
            ]
          }
        }
      ]
    },
    {
      "name": "PatientBase",
      "description": "Bloco base do paciente autorizado para conferência na ficha.",
      "fields": [
        {
          "name": "details.base",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.details.base"
            ]
          }
        }
      ]
    },
    {
      "name": "PatientDetails",
      "description": "Dados completos que a página mostra ao conferir o paciente.",
      "fields": [
        {
          "name": "identification",
          "type": "PatientIdentification"
        },
        {
          "name": "base",
          "type": "PatientBase"
        }
      ]
    },
    {
      "name": "PatientDetail",
      "description": "Paciente selecionado, pronto para conferência e continuidade no agendamento.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.id"
            ]
          }
        },
        {
          "name": "details",
          "type": "PatientDetails"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "loadPatients",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "patients",
          "type": "PatientListItem[]",
          "paginated": true
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Inicializa a área de localização de pacientes sem trazer cadastros antes de a recepcionista informar um nome.",
        "input": "page e pageSize definem a primeira janela da lista. Como a página abriu sem critério de nome, não há termo de busca.",
        "processing": "Prepara a lista paginada em estado vazio quando não há busca nominal. Não consulta nem transfere todos os pacientes; a localização é feita sob demanda por searchPatients.",
        "output": "Retorna patients no contrato paginado para alimentar a lista em estado inicial, preservando a mesma estrutura usada pela busca."
      }
    },
    {
      "id": "searchPatients",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "nameSearch",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "patients",
          "type": "PatientListItem[]",
          "paginated": true
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Localiza pacientes pelo nome para a recepcionista escolher quem seguirá para o agendamento.",
        "input": "nameSearch é o nome informado pela recepcionista; page e pageSize definem a janela solicitada dos resultados.",
        "processing": "Pesquisa Paciente pelo índice de nome, aplica o termo informado e retorna somente a página solicitada. Compõe cada resultado com identificador, nome, situação e número de documento, sem carregar a ficha completa.",
        "output": "Retorna patients paginado, já no formato compacto que a lista apresenta para identificar e selecionar um paciente."
      }
    },
    {
      "id": "loadPatientDetail",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "patientId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "patient",
          "type": "PatientDetail"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Carrega a ficha do paciente que a recepcionista selecionou para confirmar sua identificação antes de ir ao agendamento.",
        "input": "patientId é o identificador do resultado escolhido na lista.",
        "processing": "Lê o paciente selecionado e compõe sua identificação completa e seu bloco base autorizado. A situação é devolvida como campo derivado do cadastro mestre, sem ser gravada por esta consulta.",
        "output": "Retorna patient para a ficha de conferência, evitando carregar dados completos de todos os itens da lista."
      }
    },
    {
      "id": "savePatient",
      "kind": "cmd",
      "when": "savePatient",
      "writes": "Paciente.create",
      "input": [
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.docType",
          "type": "'SSN' | 'EIN' | 'Passport' | 'DriversLicense' | 'NationalId' | 'CPF' | 'CNPJ' | 'VAT' | 'Other'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.details.identification.docType"
            ]
          }
        },
        {
          "name": "details.identification.docId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Paciente.details.identification.docId"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "patient",
          "type": "PatientDetail"
        },
        {
          "name": "patientListItem",
          "type": "PatientListItem"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Cadastra ou associa o novo paciente informado pela recepcionista e o deixa imediatamente disponível para conferência e agendamento.",
        "input": "name é o nome obrigatório de identificação; docType e docId são o tipo e o número do documento quando informados no formulário.",
        "processing": "Executa Paciente.create por meio do cadastro mestre createOrAttach: valida o formato do documento quando ele for informado, procura identidade existente pelo documento e cria ou associa o papel de paciente conforme necessário. A situação, o subtipo e os dados base retornados são determinados pelo cadastro mestre; não são recebidos como campos graváveis da página.",
        "output": "Retorna a ficha completa do paciente cadastrado e sua projeção compacta para atualizar a ficha e inserir ou atualizar o resultado correspondente na lista sem uma segunda chamada."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "patientList",
        "reads": "loadPatients.patients"
      },
      {
        "organism": "patientDetail",
        "reads": "loadPatientDetail.patient"
      }
    ],
    "commands": [
      {
        "endpoint": "savePatient",
        "refreshes": []
      }
    ],
    "selections": [
      {
        "organism": "patientList",
        "via": {
          "query": "loadPatientDetail"
        }
      }
    ],
    "journeys": [
      {
        "step": "agendarConsulta/localizarPaciente",
        "organisms": [
          "patientList",
          "patientDetail"
        ],
        "endpoints": [
          "loadPatients",
          "searchPatients",
          "loadPatientDetail"
        ]
      },
      {
        "step": "agendarConsulta/registrarConsulta",
        "organisms": [
          "patientDetail"
        ],
        "endpoints": [
          "loadPatientDetail"
        ],
        "continuesIn": "consultas"
      },
      {
        "step": "cadastrarPaciente/registrarPaciente",
        "organisms": [
          "patientForm",
          "patientActions",
          "patientList",
          "patientDetail"
        ],
        "endpoints": [
          "savePatient"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "loadPatients",
        "state": "loadPatients.patients",
        "mode": "replace"
      },
      {
        "endpoint": "searchPatients",
        "state": "loadPatients.patients",
        "mode": "replace"
      },
      {
        "endpoint": "searchPatients",
        "state": "loadPatients.patients",
        "mode": "append"
      },
      {
        "endpoint": "loadPatientDetail",
        "state": "loadPatientDetail.patient",
        "mode": "replace"
      },
      {
        "endpoint": "savePatient",
        "state": "loadPatientDetail.patient",
        "mode": "replace"
      },
      {
        "endpoint": "savePatient",
        "state": "loadPatients.patients",
        "mode": "upsert"
      }
    ]
  }
}
