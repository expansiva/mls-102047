  "endpoints": [
    {
      "id": "qryPainelMes",
      "kind": "qry",
      "when": "onLoad",
      "input": [],
      "output": [
        {
          "name": "painel",
          "type": "PainelMensalidadesResumo"
        }
      ],
      "rules": [
        "painelTotalAreceber",
        "painelTotalRecebido",
        "painelQuantidadeAlunos",
        "alunoInadimplente",
        "alunoBloqueadoDuasVencidas",
        "mensalidadeVencida"
      ],
      "jsdoc": {
        "purpose": "Carrega, ao abrir a página, os indicadores financeiros do mês corrente para o resumo e para o lembrete de geração.",
        "input": "Sem entrada: o mês de referência é o mês corrente, determinado no servidor pela data de hoje.",
        "processing": "Lê a linha do PainelMensalidades pelo mesReferencia do mês corrente (read.window). Os valores são derivados e mantidos pela plataforma, nunca gravados pelo endpoint: totalAReceber soma as mensalidades com vencimento no mês (painelTotalAreceber); totalRecebido soma os pagamentos com data no mês (painelTotalRecebido); alunosAtivos, alunosBloqueados e alunosInadimplentes seguem painelQuantidadeAlunos, alunoBloqueadoDuasVencidas e alunoInadimplente, com vencida conforme mensalidadeVencida. Se não houver linha do mês, devolve zeros.",
        "output": "O mês de referência e os cinco indicadores já calculados, exibidos nos destaques e no lembrete (que usa alunosAtivos)."
      }
    },
    {
      "id": "qryMensalidadesVencidas",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "mensalidades",
          "type": "MensalidadeVencida[]",
          "paginated": true
        }
      ],
      "rules": [
        "mensalidadeVencida",
        "mensalidadeVencidaAposVencimento",
        "alunoInadimplente"
      ],
      "jsdoc": {
        "purpose": "Lista, paginada, as mensalidades vencidas dos alunos inadimplentes para a gerência priorizar a cobrança.",
        "input": "page: página solicitada (começa em 1); pageSize: quantidade de itens por página.",
        "processing": "Filtra mensalidades com status aberta e vencimento anterior a hoje (mensalidadeVencida, mensalidadeVencidaAposVencimento), cujos alunos são inadimplentes por definição (alunoInadimplente). Junta a matrícula (número) e o aluno pela matrícula (nome e situação de mensalidades). vencida, totalPago, saldoDevedor, inadimplente e quantidadeMensalidadesVencidas são derivados e calculados, nunca gravados. Ordena por vencimento mais antigo e, em seguida, maior saldo devedor.",
        "output": "Página { items, page, pageSize, hasMore } de mensalidades vencidas com id (para o atalho abrir a mensalidade), competência, vencimento, situação, total pago, saldo devedor, número da matrícula e dados do aluno."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "indicadoresMes",
        "reads": "qryPainelMes.painel"
      },
      {
        "organism": "lembreteGeracao",
        "reads": "qryPainelMes.painel"
      },
      {
        "organism": "mensalidadesVencidas",
        "reads": "qryMensalidadesVencidas.mensalidades"
      }
    ],
    "commands": [],
    "selections": [
      {
        "organism": "mensalidadesVencidas",
        "via": {
          "list": "qryMensalidadesVencidas.mensalidades"
        }
      }
    ],
    "journeys": [
      {
        "step": "acompanharPainel/verPainel",
        "organisms": [
          "indicadoresMes",
          "lembreteGeracao"
        ],
        "endpoints": [
          "qryPainelMes"
        ]
      },
      {
        "step": "acompanharPainel/detalharInadimplentes",
        "organisms": [
          "mensalidadesVencidas",
          "atalhos"
        ],
        "endpoints": [
          "qryMensalidadesVencidas"
        ],
        "continuesIn": "mensalidades"
      }
    ],
    "updates": [
      {
        "endpoint": "qryMensalidadesVencidas",
        "state": "qryMensalidadesVencidas.mensalidades",
        "mode": "append"
      }
    ]
  }
}
