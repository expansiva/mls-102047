  "endpoints": [
    {
      "id": "carregarPainelMensalidades",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "competencia",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "resumo",
          "type": "ResumoDoMes"
        },
        {
          "name": "geracao",
          "type": "LinhaGeracao[]",
          "paginated": true
        },
        {
          "name": "vencidas",
          "type": "MensalidadeVencida[]",
          "paginated": true
        }
      ],
      "rules": [
        "painelTotalAreceber",
        "painelTotalRecebido",
        "alunoInadimplenteComMensalidadeVencida",
        "alunoBloqueadoComDuasVencidas",
        "bloqueioPorDuasMensalidadesVencidas",
        "mensalidadeVencidaAposVencimento",
        "mensalidadePagaQuandoQuitada",
        "mensalidadeSomenteMatriculaAtiva",
        "mensalidadeSomenteAposDataInicio"
      ],
      "jsdoc": {
        "purpose": "Carrega numa só chamada tudo o que o painel de mensalidades mostra ao abrir: os indicadores da competência, a primeira página da conferência da geração e a primeira página das mensalidades vencidas.",
        "input": "competencia: mês AAAA-MM do painel; quando ausente, usa o mês da data atual. pageSize: tamanho da primeira página das duas listas (padrão 20).",
        "processing": "Lê a linha de PainelMensalidades da competência (read.window); totalAReceber (painelTotalAreceber), totalRecebido (painelTotalRecebido), alunosAtivos, alunosBloqueados (alunoBloqueadoComDuasVencidas) e alunosInadimplentes (alunoInadimplenteComMensalidadeVencida) são derivados pelo agregado, nunca gravados aqui; se não houver linha, devolve zeros. A lista de geração traz as matrículas ativas (mensalidadeSomenteMatriculaAtiva) com data de início até o último dia da competência (mensalidadeSomenteAposDataInicio), ordenadas por código, com plano, nome do aluno e a mensalidade da competência quando já gerada (listByForeignKey em lote, sem N+1). A lista de vencidas filtra mensalidades em aberto com vencimento anterior a hoje (mensalidadeVencidaAposVencimento, mensalidadePagaQuandoQuitada) ordenadas por vencimento, com a matrícula (vencidas, total em aberto, bloqueada por bloqueioPorDuasMensalidadesVencidas, inadimplente) e o aluno (inadimplente, bloqueado) calculados.",
        "output": "resumo para o resumoDoMes e o lembreteGeracao (quantidadeMensalidades = 0 aciona o lembrete); geracao paginada para conferir a geração; vencidas paginada para acompanhar a inadimplência."
      }
    },
    {
      "id": "listarGeracaoDoMes",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "competencia",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "geracao",
          "type": "LinhaGeracao[]",
          "paginated": true
        }
      ],
      "rules": [
        "mensalidadeSomenteMatriculaAtiva",
        "mensalidadeSomenteAposDataInicio"
      ],
      "jsdoc": {
        "purpose": "Traz as páginas seguintes da conferência da geração do mês.",
        "input": "competencia: mês AAAA-MM em conferência. page e pageSize: página pedida e seu tamanho.",
        "processing": "Mesmo filtro da carga: matrículas ativas (mensalidadeSomenteMatriculaAtiva) com data de início até o fim da competência (mensalidadeSomenteAposDataInicio), ordenadas por código, com plano, nome do aluno e a mensalidade da competência carregados em lote; situacao da mensalidade é derivada.",
        "output": "Página de linhas da geração, acrescentada à lista já exibida."
      }
    },
    {
      "id": "listarMensalidadesVencidas",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "vencidas",
          "type": "MensalidadeVencida[]",
          "paginated": true
        }
      ],
      "rules": [
        "mensalidadeVencidaAposVencimento",
        "mensalidadePagaQuandoQuitada",
        "bloqueioPorDuasMensalidadesVencidas",
        "alunoBloqueadoComDuasVencidas",
        "alunoInadimplenteComMensalidadeVencida"
      ],
      "jsdoc": {
        "purpose": "Traz as páginas seguintes das mensalidades vencidas e dos alunos inadimplentes.",
        "input": "page e pageSize: página pedida e seu tamanho.",
        "processing": "Filtra mensalidades não pagas (mensalidadePagaQuandoQuitada) com vencimento anterior a hoje (mensalidadeVencidaAposVencimento), ordenadas por vencimento; junta matrícula e aluno em lote com quantidade de vencidas, total em aberto, bloqueio (bloqueioPorDuasMensalidadesVencidas, alunoBloqueadoComDuasVencidas) e inadimplência (alunoInadimplenteComMensalidadeVencida), todos derivados.",
        "output": "Página de mensalidades vencidas acrescentada à lista da inadimplência."
      }
    },
    {
      "id": "gerarMensalidades",
      "kind": "cmd",
      "when": "gerarMensalidades",
      "writes": "Mensalidade.create",
      "input": [
        {
          "name": "competencia",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Mensalidade.competencia"
            ]
          }
        },
        {
          "name": "matriculaId",
          "type": "string[]",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Mensalidade.matriculaId"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "quantidadeGeradas",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Mensalidade.id"
            ]
          }
        },
        {
          "name": "resumo",
          "type": "ResumoDoMes"
        },
        {
          "name": "geracao",
          "type": "LinhaGeracao[]",
          "paginated": true
        }
      ],
      "rules": [
        "mensalidadeSomenteMatriculaAtiva",
        "mensalidadeSomenteAposDataInicio",
        "matriculaCanceladaNaoGeraMensalidade",
        "matriculaCanceladaEncerraGeracao",
        "mensalidadeUnicaPorMatriculaCompetencia",
        "mensalidadeValorDoPlano",
        "mensalidadeVencimentoNoDiaDoPlano",
        "planoAlteracaoNaoAfetaMensalidadesGeradas"
      ],
      "jsdoc": {
        "purpose": "Gera as mensalidades da competência informada pela gerência, uma por matrícula ativa, e devolve o painel e a conferência já atualizados.",
        "input": "competencia: mês AAAA-MM a gerar, gravado em Mensalidade.competencia. matriculaIds: matrículas para as quais gerar, gravadas em Mensalidade.matriculaId de cada mensalidade criada; quando ausente, gera para todas as matrículas elegíveis da competência. pageSize: tamanho da primeira página da conferência devolvida.",
        "processing": "Numa única transação (tudo ou nada) via mensalidadesAcademia.gerarMensalidadesDoMes: seleciona as matrículas informadas (ou todas) com status ativa (mensalidadeSomenteMatriculaAtiva), recusando/ignorando canceladas (matriculaCanceladaNaoGeraMensalidade, matriculaCanceladaEncerraGeracao) e com data de início até o último dia da competência (mensalidadeSomenteAposDataInicio); pula as que já têm mensalidade na competência (mensalidadeUnicaPorMatriculaCompetencia, garantida também pela chave única); cria cada mensalidade com matriculaId da matrícula, valor copiado do plano atual (mensalidadeValorDoPlano, planoAlteracaoNaoAfetaMensalidadesGeradas), vencimento no dia do plano ou no último dia do mês (mensalidadeVencimentoNoDiaDoPlano) e geradaEm = agora. Situação, paga e vencida são derivadas, nunca gravadas. Recusa competência fora do formato AAAA-MM.",
        "output": "quantidadeGeradas para a mensagem de confirmação (0 quando tudo já estava gerado); resumo da competência recalculado, que também apaga o lembrete; primeira página da conferência com as mensalidades geradas, para a página redesenhar sem nova chamada."
      }
    }
  ],
