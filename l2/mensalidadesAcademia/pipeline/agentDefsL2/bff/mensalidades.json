  "endpoints": [
    {
      "id": "carregarMensalidades",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "competencia",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "resumoMes",
          "type": "ResumoMes"
        },
        {
          "name": "mensalidades",
          "type": "MensalidadeLinha[]",
          "paginated": true
        }
      ],
      "rules": [
        "mensalidadeVencida",
        "mensalidadeVencidaAposVencimento",
        "gerarSomenteMatriculaAtiva",
        "somenteAtivaGeraMensalidade"
      ],
      "jsdoc": {
        "purpose": "Abre a página de mensalidades em uma só chamada: o resumo do mês para as ações e a primeira página da lista de mensalidades.",
        "input": "competencia: mês de referência (AAAA-MM) vindo da URL; quando ausente, usa o mês corrente.",
        "processing": "Conta as matrículas ativas com data de início até a competência (gerarSomenteMatriculaAtiva, somenteAtivaGeraMensalidade) e as mensalidades já geradas na competência. Lista as mensalidades da competência com número da matrícula e nome do aluno, ordenadas por vencimento e nome, em página de tamanho padrão. vencida, totalPago e saldoDevedor são calculados na leitura (mensalidadeVencida, mensalidadeVencidaAposVencimento: em aberto com vencimento anterior a hoje; saldo = valor − soma dos pagamentos, nunca abaixo de zero), nunca gravados.",
        "output": "resumoMes para as ações do mês e mensalidades paginadas ({ items, page, pageSize, hasMore }) para a lista, já com as vencidas marcadas para destaque."
      }
    },
    {
      "id": "buscarMensalidades",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "competencia",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Mensalidade.competencia"
            ]
          }
        },
        {
          "name": "status",
          "type": "'aberta' | 'paga'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Mensalidade.status"
            ]
          }
        },
        {
          "name": "details.vencida",
          "type": "boolean",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Mensalidade.details.vencida"
            ]
          }
        },
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "mensalidades",
          "type": "MensalidadeLinha[]",
          "paginated": true
        }
      ],
      "rules": [
        "mensalidadeVencida",
        "mensalidadeVencidaAposVencimento"
      ],
      "jsdoc": {
        "purpose": "Filtra e pagina a lista de mensalidades: a recepção acha a cobrança do aluno, a gerência revisa as geradas do mês ou as vencidas.",
        "input": "competencia: mês de referência; status: aberta ou paga; somenteVencidas: só em aberto com vencimento passado; busca: parte do nome do aluno ou número da matrícula; page e pageSize: página pedida.",
        "processing": "Aplica os filtros sobre as mensalidades, junta número da matrícula e nome do aluno, busca por texto em nome e número. vencida segue mensalidadeVencida/mensalidadeVencidaAposVencimento (em aberto e vencimento anterior a hoje), calculada na leitura junto com totalPago e saldoDevedor. Ordena por vencimento e nome.",
        "output": "Página de mensalidades ({ items, page, pageSize, hasMore }) que substitui a lista exibida."
      }
    },
    {
      "id": "obterMensalidade",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "mensalidadeId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "mensalidade",
          "type": "MensalidadeDetalhe"
        }
      ],
      "rules": [
        "mensalidadeVencida",
        "mensalidadeVencidaAposVencimento"
      ],
      "jsdoc": {
        "purpose": "Carrega a mensalidade escolhida na lista para conferência e para alimentar o lançamento do pagamento.",
        "input": "mensalidadeId: id da linha escolhida na lista.",
        "processing": "Lê a mensalidade pelo id com número da matrícula, nome do aluno e os pagamentos registrados (listados pela mensalidadeId, ordenados por data do pagamento). totalPago, saldoDevedor e vencida são calculados (mensalidadeVencida), nunca gravados.",
        "output": "A mensalidade com valor, vencimento, geração, quitação, situação, pagamentos e saldo devedor; o formulário de pagamento usa o saldo, o vencimento e o nome do aluno."
      }
    },
    {
      "id": "lancarPagamento",
      "kind": "cmd",
      "when": "lancarPagamento",
      "writes": "Pagamento.create",
      "input": [
        {
          "name": "mensalidadeId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Pagamento.mensalidadeId"
            ]
          }
        },
        {
          "name": "dataPagamento",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Pagamento.dataPagamento"
            ]
          }
        },
        {
          "name": "details.valor",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Pagamento.details.valor"
            ]
          }
        },
        {
          "name": "details.formaPagamento",
          "type": "'cash' | 'pix' | 'debitCard' | 'creditCard' | 'bankTransfer' | 'bankSlip'",
          "origin": {
            "kind": "field",
            "paths": [
              "Pagamento.details.formaPagamento"
            ]
          }
        },
        {
          "name": "details.observacao",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Pagamento.details.observacao"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "mensalidade",
          "type": "MensalidadeDetalhe"
        }
      ],
      "rules": [
        "pagamentoValorPositivo",
        "pagamentoSomenteMensalidadeEmAberto",
        "pagamentoQuitaMensalidade",
        "quitacaoPorPagamento",
        "regularizacaoDesbloqueiaAluno"
      ],
      "jsdoc": {
        "purpose": "Registra o pagamento recebido no balcão para a mensalidade conferida e devolve a mensalidade atualizada.",
        "input": "mensalidadeId: mensalidade paga; dataPagamento: data em que o aluno pagou; valor: valor recebido; formaPagamento: meio de pagamento; observacao: anotação livre opcional.",
        "processing": "Recusa valor menor ou igual a zero (pagamentoValorPositivo) e mensalidade já paga (pagamentoSomenteMensalidadeEmAberto). Grava o pagamento com registradoEm preenchido pelo sistema. Na mesma transação, se a soma dos pagamentos atinge o valor, executa a transição quitar para paga com quitadaEm = data do pagamento que completou o valor (pagamentoQuitaMensalidade, quitacaoPorPagamento). A situação de bloqueio do aluno é derivada e deixa de valer quando as vencidas ficam abaixo de duas (regularizacaoDesbloqueiaAluno); nada disso é gravado pelo endpoint.",
        "output": "A mensalidade com pagamentos, total pago, saldo e situação recalculados, para redesenhar a conferência sem nova chamada."
      }
    },
    {
      "id": "gerarMensalidades",
      "kind": "cmd",
      "when": "gerarMensalidades",
      "writes": "Mensalidade.create",
      "input": [
        {
          "name": "competencia",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Mensalidade.competencia"
            ]
          }
        },
        {
          "name": "matriculaId",
          "type": "string[]",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Mensalidade.matriculaId"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "competencia",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Mensalidade.competencia"
            ]
          }
        },
        {
          "name": "quantidadeGeradas",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Mensalidade.id",
              "Mensalidade.competencia"
            ]
          }
        },
        {
          "name": "quantidadeJaExistentes",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Mensalidade.matriculaId",
              "Mensalidade.competencia"
            ]
          }
        }
      ],
      "rules": [
        "gerarSomenteMatriculaAtiva",
        "somenteAtivaGeraMensalidade",
        "cancelamentoEncerraMensalidadesFuturas",
        "mensalidadeUnicaPorMatriculaMes",
        "valorDoPlanoNaGeracao",
        "vencimentoNoDiaDoPlano"
      ],
      "jsdoc": {
        "purpose": "Gera as mensalidades do mês de referência informado pela gerência, uma por matrícula ativa.",
        "input": "competencia: mês de referência (AAAA-MM) da geração; matriculaIds: opcional, matrículas para as quais gerar (preenche Mensalidade.matriculaId de cada mensalidade criada); quando ausente, todas as matrículas ativas elegíveis da competência.",
        "processing": "Seleciona as matrículas ativas com data de início até a competência (restritas a matriculaIds quando informado), ignorando canceladas (gerarSomenteMatriculaAtiva, somenteAtivaGeraMensalidade, cancelamentoEncerraMensalidadesFuturas). Pula matrículas que já têm mensalidade na competência (mensalidadeUnicaPorMatriculaMes). Cada mensalidade nasce aberta com matriculaId da matrícula, valor copiado do plano (valorDoPlanoNaGeracao) e vencimento no dia do plano dentro do mês, caindo no último dia em meses mais curtos (vencimentoNoDiaDoPlano); geradaEm é preenchido pelo sistema. Tudo em uma transação.",
        "output": "Competência e as quantidades geradas e já existentes, para a gerência confirmar o resultado; a lista e o resumo são recarregados."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "listaMensalidades",
        "reads": "carregarMensalidades.mensalidades"
      },
      {
        "organism": "detalheMensalidade",
        "reads": "obterMensalidade.mensalidade"
      },
      {
        "organism": "formPagamento",
        "reads": "obterMensalidade.mensalidade"
      },
      {
        "organism": "acoesMensalidades",
        "reads": "carregarMensalidades.resumoMes"
      }
    ],
    "commands": [
      {
        "endpoint": "lancarPagamento",
        "refreshes": [
          "carregarMensalidades"
        ]
      },
      {
        "endpoint": "gerarMensalidades",
        "refreshes": [
          "carregarMensalidades"
        ]
      }
    ],
    "selections": [
      {
        "organism": "listaMensalidades",
        "via": {
          "query": "obterMensalidade"
        }
      },
      {
        "organism": "detalheMensalidade",
        "via": {
          "list": "obterMensalidade.mensalidade"
        }
      }
    ],
    "journeys": [
      {
        "step": "acompanharPainel/verPainel",
        "organisms": [],
        "endpoints": [],
        "continuesIn": "painel_financeiro"
      },
      {
        "step": "acompanharPainel/detalharInadimplentes",
        "organisms": [
          "listaMensalidades"
        ],
        "endpoints": [
          "carregarMensalidades",
          "buscarMensalidades"
        ]
      },
      {
        "step": "gerarMensalidadesMes/conferirMatriculasAtivas",
        "organisms": [
          "acoesMensalidades"
        ],
        "endpoints": [
          "carregarMensalidades"
        ],
        "continuesIn": "matriculas"
      },
      {
        "step": "gerarMensalidadesMes/gerarMensalidades",
        "organisms": [
          "acoesMensalidades"
        ],
        "endpoints": [
          "gerarMensalidades"
        ]
      },
      {
        "step": "gerarMensalidadesMes/revisarMensalidadesGeradas",
        "organisms": [
          "listaMensalidades"
        ],
        "endpoints": [
          "carregarMensalidades",
          "buscarMensalidades"
        ]
      },
      {
        "step": "registrarPagamento/localizarMensalidade",
        "organisms": [
          "listaMensalidades"
        ],
        "endpoints": [
          "carregarMensalidades",
          "buscarMensalidades"
        ]
      },
      {
        "step": "registrarPagamento/conferirMensalidade",
        "organisms": [
          "detalheMensalidade"
        ],
        "endpoints": [
          "obterMensalidade"
        ]
      },
      {
        "step": "registrarPagamento/lancarPagamento",
        "organisms": [
          "formPagamento"
        ],
        "endpoints": [
          "lancarPagamento"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "buscarMensalidades",
        "state": "carregarMensalidades.mensalidades",
        "mode": "replace"
      },
      {
        "endpoint": "lancarPagamento",
        "state": "obterMensalidade.mensalidade",
        "mode": "replace"
      }
    ]
  }
}
