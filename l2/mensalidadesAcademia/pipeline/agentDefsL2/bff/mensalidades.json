  ],
  "endpoints": [
    {
      "id": "qryMensalidades",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "competencia",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Mensalidade.competencia"
            ]
          }
        },
        {
          "name": "aluno.details.identification.name",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Aluno.details.identification.name"
            ]
          }
        },
        {
          "name": "details.vencida",
          "type": "boolean",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Mensalidade.details.vencida"
            ]
          }
        },
        {
          "name": "details.paga",
          "type": "boolean",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Mensalidade.details.paga"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "mensalidades",
          "type": "MensalidadeLinha[]",
          "paginated": true
        },
        {
          "name": "matriculasAtivas",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Matricula.status",
              "Matricula.id"
            ]
          }
        }
      ],
      "rules": [
        "mensalidadeVencidaAposVencimento",
        "mensalidadePagaQuandoQuitada"
      ],
      "jsdoc": {
        "purpose": "Carrega as mensalidades da competência para a recepção localizar a cobrança e a gerência conferir a geração do mês, junto com a contagem de matrículas ativas usada nas ações do mês.",
        "input": "competencia: mês AAAA-MM (padrão: mês atual); alunoNome: trecho do nome do aluno para busca; vencida/paga: filtros opcionais de situação; page/pageSize: paginação.",
        "processing": "Filtra Mensalidade por competência (e pelos filtros), junta matrícula e nome do aluno do cadastro mestre, ordena por vencimento. totalPago, paga, vencida e situacao são calculados na leitura: totalPago soma os pagamentos; paga quando totalPago alcança o valor (mensalidadePagaQuandoQuitada); vencida quando não paga e vencimento anterior a hoje (mensalidadeVencidaAposVencimento). matriculasAtivas conta matrículas com status ativa.",
        "output": "Página de linhas de mensalidade { items, page, pageSize, hasMore } e o número de matrículas ativas que receberão mensalidade."
      }
    },
    {
      "id": "qryMensalidadeDetalhe",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "mensalidadeId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "mensalidade",
          "type": "MensalidadeCompleta"
        }
      ],
      "rules": [
        "mensalidadePagaQuandoQuitada",
        "mensalidadeVencidaAposVencimento",
        "alunoBloqueadoComDuasVencidas"
      ],
      "jsdoc": {
        "purpose": "Abre a mensalidade escolhida na lista com seus pagamentos, a matrícula e o bloqueio do aluno, para conferência e lançamento de pagamento.",
        "input": "mensalidadeId: mensalidade selecionada na lista.",
        "processing": "Lê a mensalidade por id, a matrícula (código), o aluno (nome e bloqueio) e os pagamentos da mensalidade ordenados por data. totalPago, paga, vencida e situacao são calculados (mensalidadePagaQuandoQuitada, mensalidadeVencidaAposVencimento); bloqueado é calculado quando o aluno tem duas ou mais mensalidades vencidas (alunoBloqueadoComDuasVencidas).",
        "output": "A mensalidade completa, usada pelo detalhe, pelo formulário de pagamento (valor e total pago) e pelo histórico (geradaEm e pagamentos)."
      }
    },
    {
      "id": "cmdRegistrarPagamento",
      "kind": "cmd",
      "when": "registrarPagamento",
      "writes": "Pagamento.create",
      "input": [
        {
          "name": "mensalidadeId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Pagamento.mensalidadeId"
            ]
          }
        },
        {
          "name": "dataPagamento",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Pagamento.dataPagamento"
            ]
          }
        },
        {
          "name": "details.valor",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Pagamento.details.valor"
            ]
          }
        },
        {
          "name": "details.forma",
          "type": "'dinheiro' | 'pix' | 'cartaoCredito' | 'cartaoDebito' | 'boleto' | 'transferencia'",
          "origin": {
            "kind": "field",
            "paths": [
              "Pagamento.details.forma"
            ]
          }
        },
        {
          "name": "details.observacao",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Pagamento.details.observacao"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "mensalidade",
          "type": "MensalidadeCompleta"
        },
        {
          "name": "linha",
          "type": "MensalidadeLinha"
        }
      ],
      "rules": [
        "pagamentoQuitaMensalidade",
        "pagamentoValorPositivo",
        "pagamentoDataNaoFutura",
        "mensalidadePagaQuandoQuitada",
        "alunoDesbloqueadoAoRegularizarVencidas"
      ],
      "jsdoc": {
        "purpose": "Registra o pagamento da mensalidade escolhida e devolve a mensalidade já recalculada.",
        "input": "mensalidadeId: mensalidade paga; dataPagamento, valor, forma e observacao opcional informados pela recepção.",
        "processing": "Recusa se a mensalidade não existir (pagamentoQuitaMensalidade), se valor <= 0 (pagamentoValorPositivo) ou se a data for posterior a hoje (pagamentoDataNaoFutura). Cria o Pagamento em transação. Depois relê a mensalidade: totalPago, paga e situacao são calculados (mensalidadePagaQuandoQuitada) e o bloqueio do aluno é recalculado, deixando de valer com menos de duas vencidas (alunoDesbloqueadoAoRegularizarVencidas); nada disso é gravado.",
        "output": "A mensalidade completa com o novo pagamento, para redesenhar detalhe, formulário e histórico, e a linha atualizada para a lista."
      }
    },
    {
      "id": "cmdGerarMensalidades",
      "kind": "cmd",
      "when": "gerarMensalidades",
      "writes": "Mensalidade.create",
      "input": [
        {
          "name": "competencia",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Mensalidade.competencia"
            ]
          }
        },
        {
          "name": "matriculaId",
          "type": "string[]",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Mensalidade.matriculaId"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "quantidadeGeradas",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Mensalidade.id"
            ]
          }
        },
        {
          "name": "quantidadeJaExistentes",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Mensalidade.id",
              "Mensalidade.matriculaId"
            ]
          }
        }
      ],
      "rules": [
        "mensalidadeSomenteMatriculaAtiva",
        "matriculaCanceladaNaoGeraMensalidade",
        "mensalidadeSomenteAposDataInicio",
        "mensalidadeUnicaPorMatriculaCompetencia",
        "mensalidadeValorDoPlano",
        "mensalidadeVencimentoNoDiaDoPlano"
      ],
      "jsdoc": {
        "purpose": "Gera as mensalidades da competência informada pela gerência, uma por matrícula ativa.",
        "input": "competencia: mês AAAA-MM a gerar; matriculaIds: matrículas (Mensalidade.matriculaId) para as quais gerar; quando omitido, todas as matrículas ativas da academia.",
        "processing": "Seleciona as matrículas informadas (ou todas) com status ativa (mensalidadeSomenteMatriculaAtiva, matriculaCanceladaNaoGeraMensalidade) e dataInicio até o último dia do mês (mensalidadeSomenteAposDataInicio); ignora as que já têm mensalidade na competência (mensalidadeUnicaPorMatriculaCompetencia). Para cada uma grava matriculaId, competencia, valor = valor atual do plano (mensalidadeValorDoPlano), vencimento no diaVencimento do plano ou último dia do mês (mensalidadeVencimentoNoDiaDoPlano) e geradaEm = agora, tudo numa transação.",
        "output": "Quantidades geradas e já existentes, para a mensagem de confirmação; a lista é recarregada."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "mensalidadesLista",
        "reads": "qryMensalidades.mensalidades"
      },
      {
        "organism": "mensalidadeDetalhe",
        "reads": "qryMensalidadeDetalhe.mensalidade"
      },
      {
        "organism": "pagamentoForm",
        "reads": "qryMensalidadeDetalhe.mensalidade"
      },
      {
        "organism": "mensalidadeAcoes",
        "reads": "qryMensalidades.matriculasAtivas"
      },
      {
        "organism": "mensalidadeHistorico",
        "reads": "qryMensalidadeDetalhe.mensalidade"
      }
    ],
    "commands": [
      {
        "endpoint": "cmdRegistrarPagamento",
        "refreshes": []
      },
      {
        "endpoint": "cmdGerarMensalidades",
        "refreshes": [
          "qryMensalidades"
        ]
      }
    ],
    "selections": [
      {
        "organism": "mensalidadesLista",
        "via": {
          "query": "qryMensalidadeDetalhe"
        }
      },
      {
        "organism": "mensalidadeDetalhe",
        "via": {
          "list": "qryMensalidadeDetalhe.mensalidade"
        }
      }
    ],
    "journeys": [
      {
        "step": "acompanharPainel/abrirPainel",
        "organisms": [],
        "endpoints": [],
        "continuesIn": "painel_mensalidades"
      },
      {
        "step": "acompanharPainel/listarInadimplentes",
        "organisms": [
          "mensalidadesLista"
        ],
        "endpoints": [
          "qryMensalidades"
        ]
      },
      {
        "step": "gerarMensalidadesDoMes/consultarMatriculasAtivas",
        "organisms": [
          "mensalidadeAcoes"
        ],
        "endpoints": [
          "qryMensalidades"
        ]
      },
      {
        "step": "gerarMensalidadesDoMes/gerarMensalidades",
        "organisms": [
          "mensalidadeAcoes"
        ],
        "endpoints": [
          "cmdGerarMensalidades"
        ]
      },
      {
        "step": "gerarMensalidadesDoMes/conferirMensalidades",
        "organisms": [
          "mensalidadesLista",
          "mensalidadeHistorico"
        ],
        "endpoints": [
          "qryMensalidades",
          "qryMensalidadeDetalhe"
        ]
      },
      {
        "step": "registrarPagamento/localizarMensalidade",
        "organisms": [
          "mensalidadesLista"
        ],
        "endpoints": [
          "qryMensalidades"
        ]
      },
      {
        "step": "registrarPagamento/verMensalidade",
        "organisms": [
          "mensalidadeDetalhe"
        ],
        "endpoints": [
          "qryMensalidadeDetalhe"
        ]
      },
      {
        "step": "registrarPagamento/lancarPagamento",
        "organisms": [
          "pagamentoForm"
        ],
        "endpoints": [
          "cmdRegistrarPagamento"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "qryMensalidades",
        "state": "qryMensalidades.mensalidades",
        "mode": "replace"
      },
      {
        "endpoint": "cmdRegistrarPagamento",
        "state": "qryMensalidadeDetalhe.mensalidade",
        "mode": "replace"
      },
      {
        "endpoint": "cmdRegistrarPagamento",
        "state": "qryMensalidades.mensalidades",
        "mode": "upsert"
      }
    ]
  }
}
