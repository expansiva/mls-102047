{
  "types": [
    {
      "name": "AlunoIdentificacao",
      "description": "Identificação do aluno exibida na matrícula.",
      "fields": [
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Aluno.details.identification.name"
            ]
          }
        }
      ]
    },
    {
      "name": "AlunoDetails",
      "description": "Detalhes do aluno lidos pela página.",
      "fields": [
        {
          "name": "identification",
          "type": "AlunoIdentificacao"
        }
      ]
    },
    {
      "name": "AlunoNome",
      "description": "Aluno com id e nome, usado na lista de matrículas e na escolha do aluno.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Aluno.id"
            ]
          }
        },
        {
          "name": "details",
          "type": "AlunoDetails"
        }
      ]
    },
    {
      "name": "PlanoNome",
      "description": "Plano da matrícula identificado pelo nome.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Plano.id"
            ]
          }
        },
        {
          "name": "nome",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Plano.nome"
            ]
          }
        }
      ]
    },
    {
      "name": "PlanoDetails",
      "description": "Valor e dia de vencimento do plano.",
      "fields": [
        {
          "name": "details.valor",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Plano.details.valor"
            ]
          }
        },
        {
          "name": "details.diaVencimento",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Plano.details.diaVencimento"
            ]
          }
        }
      ]
    },
    {
      "name": "PlanoOpcao",
      "description": "Plano oferecido na criação da matrícula.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Plano.id"
            ]
          }
        },
        {
          "name": "nome",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Plano.nome"
            ]
          }
        },
        {
          "name": "periodicidade",
          "type": "'monthly' | 'quarterly' | 'annual'",
          "origin": {
            "kind": "field",
            "paths": [
              "Plano.periodicidade"
            ]
          }
        },
        {
          "name": "details",
          "type": "PlanoDetails"
        }
      ]
    },
    {
      "name": "MatriculaDetails",
      "description": "Indicadores calculados da matrícula a partir das mensalidades e pagamentos.",
      "fields": [
        {
          "name": "quantidadeMensalidadesVencidas",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Matricula.details.quantidadeMensalidadesVencidas",
              "Mensalidade.vencimento",
              "Mensalidade.details.paga"
            ]
          }
        },
        {
          "name": "bloqueada",
          "type": "boolean",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Matricula.details.bloqueada",
              "Mensalidade.details.vencida"
            ]
          }
        },
        {
          "name": "inadimplente",
          "type": "boolean",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Matricula.details.inadimplente",
              "Mensalidade.details.vencida"
            ]
          }
        },
        {
          "name": "totalEmAberto",
          "type": "number",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Matricula.details.totalEmAberto",
              "Mensalidade.details.valor",
              "Pagamento.details.valor"
            ]
          }
        }
      ]
    },
    {
      "name": "MatriculaResumo",
      "description": "Matrícula com aluno, plano, situação e indicadores de vencidas e total em aberto; serve à lista, à situação selecionada e às ações.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.version"
            ]
          }
        },
        {
          "name": "codigo",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.codigo"
            ]
          }
        },
        {
          "name": "alunoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.alunoId"
            ]
          }
        },
        {
          "name": "aluno",
          "type": "AlunoNome"
        },
        {
          "name": "planoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.planoId"
            ]
          }
        },
        {
          "name": "plano",
          "type": "PlanoNome"
        },
        {
          "name": "status",
          "type": "'ativa' | 'cancelada'",
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.status"
            ]
          }
        },
        {
          "name": "dataInicio",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.dataInicio"
            ]
          }
        },
        {
          "name": "details",
          "type": "MatriculaDetails"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "listarMatriculas",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "apenasAtivas",
          "type": "boolean",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "busca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "matriculas",
          "type": "MatriculaResumo[]",
          "paginated": true
        }
      ],
      "rules": [
        "bloqueioPorDuasMensalidadesVencidas",
        "mensalidadeVencidaAposVencimento",
        "alunoBloqueadoNaoEntra"
      ],
      "jsdoc": {
        "purpose": "Carrega a lista paginada de matrículas da academia com aluno, plano, situação e indicadores de cobrança, já pronta para a lista, para a situação da matrícula escolhida e para as ações.",
        "input": "apenasAtivas: quando verdadeiro, traz só matrículas com status 'ativa'. busca: trecho do código da matrícula ou do nome do aluno. page e pageSize: página pedida e tamanho da página.",
        "processing": "Filtra por status e busca (código pela locate.byText, nome do aluno pelo cadastro mestre), ordena pelo código e pagina. Compõe nome do aluno (read.mdmRecord) e nome do plano em lote (listByForeignKey). Para cada matrícula calcula, a partir das mensalidades e pagamentos carregados em lote: quantidadeMensalidadesVencidas = mensalidades não pagas com vencimento anterior a hoje (mensalidadeVencidaAposVencimento); bloqueada quando há duas ou mais vencidas (bloqueioPorDuasMensalidadesVencidas, base de alunoBloqueadoNaoEntra); inadimplente com ao menos uma vencida; totalEmAberto = soma de valor menos total pago das mensalidades. Os derivados são calculados, nunca gravados.",
        "output": "matriculas paginada { items, page, pageSize, hasMore } de MatriculaResumo; a página usa o mesmo item para a lista, para a situação selecionada (sem nova chamada) e para id/version do cancelamento."
      }
    },
    {
      "id": "buscarAlunos",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "termo",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "alunos",
          "type": "AlunoNome[]"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Procura o aluno a matricular pelo nome ou documento digitado no formulário de nova matrícula.",
        "input": "termo: trecho do nome ou número do documento do aluno.",
        "processing": "Usa locate.byName e locate.byDocument do cadastro mestre, limitando a poucas dezenas de resultados ordenados por nome; não pagina.",
        "output": "alunos com id e nome, para o formulário preencher alunoId; se não houver, a recepção vai ao cadastro de alunos."
      }
    },
    {
      "id": "opcoesNovaMatricula",
      "kind": "qry",
      "when": "onLoad",
      "input": [],
      "output": [
        {
          "name": "planos",
          "type": "PlanoOpcao[]"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Carrega os planos disponíveis para a escolha na nova matrícula.",
        "input": "Nenhuma.",
        "processing": "Lista todos os planos da academia ordenados por nome (locate.byColumn); a lista é curta e não é paginada.",
        "output": "planos com nome, periodicidade, valor e dia de vencimento, para a recepção escolher e conferir o plano."
      }
    },
    {
      "id": "criarMatricula",
      "kind": "cmd",
      "when": "criarMatricula",
      "writes": "Matricula.create",
      "input": [
        {
          "name": "alunoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.alunoId"
            ]
          }
        },
        {
          "name": "planoId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.planoId"
            ]
          }
        },
        {
          "name": "dataInicio",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.dataInicio"
            ]
          }
        },
        {
          "name": "details.observacoes",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.details.observacoes"
            ]
          }
        },
        {
          "name": "dataCancelamento",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.dataCancelamento"
            ]
          }
        },
        {
          "name": "details.cancelamento.motivo",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.details.cancelamento.motivo"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "matricula",
          "type": "MatriculaResumo"
        }
      ],
      "rules": [
        "matriculaUnicaAtivaPorAluno",
        "codigoMatriculaSequencial"
      ],
      "jsdoc": {
        "purpose": "Cria a matrícula do aluno no plano escolhido a partir da data de início, já ativa.",
        "input": "alunoId: aluno matriculado. planoId: plano escolhido. dataInicio: data a partir da qual o aluno fica matriculado. observacoes: anotações opcionais da recepção. dataCancelamento e motivo: campos de cancelamento editados na página, opcionais e normalmente vazios na criação.",
        "processing": "Recusa se o aluno já tem matrícula ativa (matriculaUnicaAtivaPorAluno). Emite o código pela sequência da plataforma, sem aceitá-lo do cliente (codigoMatriculaSequencial). Grava status 'ativa' e recepcionistaId resolvido da sessão (locate.byLogin). Como a matrícula nasce ativa, recusa a criação se dataCancelamento ou motivo vierem preenchidos; o cancelamento é feito só pela transição cancelarMatricula. Indicadores derivados saem zerados por cálculo, nunca gravados.",
        "output": "matricula criada como MatriculaResumo, inserida na lista pela página sem recarregar."
      }
    },
    {
      "id": "cancelarMatricula",
      "kind": "cmd",
      "when": "cancelarMatricula",
      "writes": "Matricula.cancelarMatricula",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.version"
            ]
          }
        },
        {
          "name": "dataCancelamento",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.dataCancelamento"
            ]
          }
        },
        {
          "name": "details.cancelamento.motivo",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Matricula.details.cancelamento.motivo"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "matricula",
          "type": "MatriculaResumo"
        }
      ],
      "rules": [
        "cancelamentoEncerraMensalidadesFuturas",
        "matriculaCanceladaNaoGeraMensalidade"
      ],
      "jsdoc": {
        "purpose": "Registra o cancelamento pedido pelo aluno, passando a matrícula de ativa para cancelada.",
        "input": "id e version: matrícula selecionada e versão para concorrência otimista. dataCancelamento: data do pedido do aluno. motivo: motivo informado pelo aluno.",
        "processing": "Aceita só matrícula 'ativa'; executa a transição cancelarMatricula gravando dataCancelamento, motivo e registradoEm com o momento atual. Mantém as mensalidades já geradas e a matrícula deixa de entrar nas gerações posteriores (cancelamentoEncerraMensalidadesFuturas, matriculaCanceladaNaoGeraMensalidade). Recalcula os indicadores derivados para a resposta.",
        "output": "matricula atualizada como MatriculaResumo com status 'cancelada', para a página substituir o item na lista e na situação selecionada."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "matriculasList",
        "reads": "listarMatriculas.matriculas"
      },
      {
        "organism": "situacaoMatricula",
        "reads": "listarMatriculas.matriculas"
      },
      {
        "organism": "acoesMatricula",
        "reads": "listarMatriculas.matriculas"
      },
      {
        "organism": "novaMatriculaForm",
        "reads": "opcoesNovaMatricula.planos"
      },
      {
        "organism": "novaMatriculaForm",
        "reads": "buscarAlunos.alunos"
      }
    ],
    "commands": [
      {
        "endpoint": "criarMatricula",
        "refreshes": []
      },
      {
        "endpoint": "cancelarMatricula",
        "refreshes": []
      }
    ],
    "selections": [
      {
        "organism": "matriculasList",
        "via": {
          "list": "listarMatriculas.matriculas"
        }
      }
    ],
    "journeys": [
      {
        "step": "cancelarMatricula/localizarMatriculaCancelar",
        "organisms": [
          "matriculasList"
        ],
        "endpoints": [
          "listarMatriculas"
        ]
      },
      {
        "step": "cancelarMatricula/conferirMatriculaCancelar",
        "organisms": [
          "situacaoMatricula"
        ],
        "endpoints": [
          "listarMatriculas"
        ]
      },
      {
        "step": "cancelarMatricula/registrarCancelamento",
        "organisms": [
          "acoesMatricula"
        ],
        "endpoints": [
          "cancelarMatricula"
        ]
      },
      {
        "step": "gerarMensalidadesDoMes/consultarMatriculasAtivas",
        "organisms": [
          "matriculasList"
        ],
        "endpoints": [
          "listarMatriculas"
        ]
      },
      {
        "step": "gerarMensalidadesDoMes/gerarMensalidades",
        "organisms": [
          "acoesMatricula"
        ],
        "endpoints": [],
        "continuesIn": "mensalidades"
      },
      {
        "step": "gerarMensalidadesDoMes/conferirMensalidades",
        "organisms": [],
        "endpoints": [],
        "continuesIn": "mensalidades"
      },
      {
        "step": "matricularAluno/localizarAluno",
        "organisms": [
          "novaMatriculaForm"
        ],
        "endpoints": [
          "buscarAlunos"
        ]
      },
      {
        "step": "matricularAluno/registrarAluno",
        "organisms": [
          "acoesMatricula"
        ],
        "endpoints": [],
        "continuesIn": "alunos"
      },
      {
        "step": "matricularAluno/escolherPlano",
        "organisms": [
          "novaMatriculaForm"
        ],
        "endpoints": [
          "opcoesNovaMatricula"
        ]
      },
      {
        "step": "matricularAluno/criarMatricula",
        "organisms": [
          "novaMatriculaForm"
        ],
        "endpoints": [
          "criarMatricula"
        ]
      },
      {
        "step": "verificarAcessoAluno/buscarAlunoEntrada",
        "organisms": [
          "matriculasList"
        ],
        "endpoints": [
          "listarMatriculas"
        ]
      },
      {
        "step": "verificarAcessoAluno/verSituacaoMatricula",
        "organisms": [
          "situacaoMatricula"
        ],
        "endpoints": [
          "listarMatriculas"
        ]
      }
    ],
    "updates": [
      {
        "endpoint": "criarMatricula",
        "state": "listarMatriculas.matriculas",
        "mode": "upsert"
      },
      {
        "endpoint": "cancelarMatricula",
        "state": "listarMatriculas.matriculas",
        "mode": "upsert"
      },
      {
        "endpoint": "buscarAlunos",
        "state": "buscarAlunos.alunos",
        "mode": "replace"
      }
    ]
  }
}
