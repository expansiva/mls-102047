{
  "organisms": {
    "matriculasList": {
      "reads": [
        "Matricula.codigo",
        "Matricula.alunoId",
        "Aluno.details.identification.name",
        "Matricula.planoId",
        "Plano.nome",
        "Matricula.status",
        "Matricula.details.quantidadeMensalidadesVencidas",
        "Matricula.details.totalEmAberto"
      ],
      "edits": [],
      "selects": "situacaoMatricula",
      "submits": []
    },
    "situacaoMatricula": {
      "reads": [
        "Matricula.codigo",
        "Matricula.status",
        "Matricula.details.bloqueada",
        "Matricula.details.inadimplente",
        "Matricula.details.quantidadeMensalidadesVencidas",
        "Matricula.details.totalEmAberto",
        "Aluno.details.identification.name"
      ],
      "edits": [],
      "selects": "",
      "submits": []
    },
    "novaMatriculaForm": {
      "reads": [
        "Aluno.details.identification.name",
        "Plano.nome",
        "Plano.periodicidade",
        "Plano.details.valor",
        "Plano.details.diaVencimento"
      ],
      "edits": [
        "Matricula.alunoId",
        "Matricula.planoId",
        "Matricula.dataInicio"
      ],
      "selects": "",
      "submits": [
        {
          "intentId": "criarMatricula",
          "write": "Matricula.create"
        }
      ]
    },
    "acoesMatricula": {
      "reads": [
        "Matricula.codigo",
        "Matricula.status"
      ],
      "edits": [
        "Matricula.dataCancelamento",
        "Matricula.details.cancelamento.motivo"
      ],
      "selects": "",
      "submits": [
        {
          "intentId": "cancelarMatricula",
          "write": "Matricula.cancelarMatricula"
        }
      ]
    }
  }
}
