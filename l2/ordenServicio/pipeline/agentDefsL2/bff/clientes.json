{
  "types": [
    {
      "name": "ClienteIdentificacion",
      "description": "Identificación del cliente tal como la anida la ontología (details.identification).",
      "fields": [
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.docType",
          "type": "'SSN' | 'EIN' | 'Passport' | 'DriversLicense' | 'NationalId' | 'CPF' | 'CNPJ' | 'VAT' | 'Other'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.details.identification.docType"
            ]
          }
        },
        {
          "name": "details.identification.docId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.details.identification.docId"
            ]
          }
        },
        {
          "name": "details.identification.countryCode",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.details.identification.countryCode"
            ]
          }
        },
        {
          "name": "details.identification.status",
          "type": "'Active' | 'Inactive' | 'Merged' | 'Blocked'",
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.details.identification.status"
            ]
          }
        }
      ]
    },
    {
      "name": "ClienteResumenDetails",
      "description": "Detalle mínimo del cliente para un resultado de búsqueda.",
      "fields": [
        {
          "name": "identification",
          "type": "ClienteIdentificacion"
        }
      ]
    },
    {
      "name": "ClienteResumen",
      "description": "Resultado de búsqueda de cliente: id, nombre, documento, país y estado.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.id"
            ]
          }
        },
        {
          "name": "details",
          "type": "ClienteResumenDetails"
        }
      ]
    },
    {
      "name": "ClienteBase",
      "description": "Resumen de contactos del cliente.",
      "fields": [
        {
          "name": "details.base.contacts",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.details.base.contacts"
            ]
          }
        }
      ]
    },
    {
      "name": "ClientePersona",
      "description": "Datos de persona del cliente: consentimiento de privacidad.",
      "fields": [
        {
          "name": "details.person.privacyConsent",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.details.person.privacyConsent"
            ]
          }
        }
      ]
    },
    {
      "name": "FichaClienteDetails",
      "description": "Detalle completo de la ficha del cliente.",
      "fields": [
        {
          "name": "identification",
          "type": "ClienteIdentificacion"
        },
        {
          "name": "base",
          "type": "ClienteBase"
        },
        {
          "name": "person",
          "type": "ClientePersona"
        }
      ]
    },
    {
      "name": "FichaCliente",
      "description": "Ficha del cliente con identificación, contactos y consentimiento.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.id"
            ]
          }
        },
        {
          "name": "details",
          "type": "FichaClienteDetails"
        }
      ]
    },
    {
      "name": "AparatoResumen",
      "description": "Aparato de la orden: tipo, marca y modelo.",
      "fields": [
        {
          "name": "details.aparato.tipo",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdenServicio.details.aparato.tipo"
            ]
          }
        },
        {
          "name": "details.aparato.marca",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "OrdenServicio.details.aparato.marca"
            ]
          }
        },
        {
          "name": "details.aparato.modelo",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "OrdenServicio.details.aparato.modelo"
            ]
          }
        }
      ]
    },
    {
      "name": "OrdenClienteDetails",
      "description": "Detalle resumido de la orden para el historial del cliente.",
      "fields": [
        {
          "name": "aparato",
          "type": "AparatoResumen"
        },
        {
          "name": "disponibleParaRetiro",
          "type": "boolean",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "OrdenServicio.details.disponibleParaRetiro",
              "OrdenServicio.status"
            ]
          }
        }
      ]
    },
    {
      "name": "OrdenClienteResumen",
      "description": "Orden de servicio del cliente en su historial de recepción.",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdenServicio.id"
            ]
          }
        },
        {
          "name": "numero",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdenServicio.numero"
            ]
          }
        },
        {
          "name": "clienteId",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdenServicio.clienteId"
            ]
          }
        },
        {
          "name": "status",
          "type": "'abierta' | 'presupuestada' | 'aprobada' | 'rechazada' | 'lista' | 'finalizada'",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdenServicio.status"
            ]
          }
        },
        {
          "name": "fechaApertura",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdenServicio.fechaApertura"
            ]
          }
        },
        {
          "name": "details",
          "type": "OrdenClienteDetails"
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "buscarClientes",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "texto",
          "type": "string",
          "origin": {
            "kind": "aggregate",
            "paths": [
              "Cliente.details.identification.name",
              "Cliente.details.identification.docId"
            ]
          }
        },
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "clientes",
          "type": "ClienteResumen[]",
          "paginated": true
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Busca clientes por parte del nombre o por número de documento para que el recepcionista elija el registro correcto antes de registrar a alguien nuevo.",
        "input": "texto: fragmento del nombre o número de documento escrito por el recepcionista; page y pageSize: página solicitada y tamaño de página.",
        "processing": "Usa locate.byName y locate.byDocument de Cliente dentro de la organización; une los resultados sin duplicados, ordena por nombre y pagina. Proyecta solo id, nombre, tipo y número de documento, país y estado.",
        "output": "Página { items, page, pageSize, hasMore } de clientes resumidos para la lista de resultados."
      }
    },
    {
      "id": "obtenerFichaCliente",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "clienteId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "cliente",
          "type": "FichaCliente"
        },
        {
          "name": "ordenes",
          "type": "OrdenClienteResumen[]"
        }
      ],
      "rules": [
        "disponibleParaRetiroCalculado"
      ],
      "jsdoc": {
        "purpose": "Carga en una sola llamada la ficha del cliente elegido y su historial de órdenes de servicio, para confirmar identidad y continuar a abrir una orden.",
        "input": "clienteId: id del cliente seleccionado en la búsqueda o recién registrado.",
        "processing": "Lee el cliente por id (read.byId) con identificación, contactos y consentimiento de privacidad; lista sus órdenes por clienteId (listByForeignKey) ordenadas por fechaApertura descendente. disponibleParaRetiro es derivado: se calcula como verdadero cuando el estado es lista o rechazada (disponibleParaRetiroCalculado), nunca se almacena. No se exponen anotaciones del técnico ni costo interno de piezas (campos denegados al recepcionista).",
        "output": "cliente con su ficha y ordenes con número, estado, fecha de apertura, aparato y disponibilidad para retiro."
      }
    },
    {
      "id": "registrarCliente",
      "kind": "cmd",
      "when": "registrarCliente",
      "writes": "Cliente.create",
      "input": [
        {
          "name": "details.identification.name",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.details.identification.name"
            ]
          }
        },
        {
          "name": "details.identification.docType",
          "type": "'SSN' | 'EIN' | 'Passport' | 'DriversLicense' | 'NationalId' | 'CPF' | 'CNPJ' | 'VAT' | 'Other'",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.details.identification.docType"
            ]
          }
        },
        {
          "name": "details.identification.docId",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.details.identification.docId"
            ]
          }
        },
        {
          "name": "details.identification.countryCode",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.details.identification.countryCode"
            ]
          }
        },
        {
          "name": "details.person.privacyConsent",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "Cliente.details.person.privacyConsent"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "cliente",
          "type": "FichaCliente"
        },
        {
          "name": "ordenes",
          "type": "OrdenClienteResumen[]"
        }
      ],
      "rules": [],
      "jsdoc": {
        "purpose": "Registra un cliente nuevo (o reutiliza el existente con el mismo documento) y lo deja seleccionado en la ficha para abrir la orden.",
        "input": "name: nombre del cliente; docType y docId: tipo y número de documento; countryCode: país ISO 3166-1 alfa-2; privacyConsent: consentimiento de privacidad del cliente.",
        "processing": "Usa register.createOrAttach de Cliente: valida la forma del documento según el país y exige el consentimiento de privacidad donde el país lo requiere; si ya existe un cliente con ese documento lo reutiliza y le asigna el rol ordenServicio.Cliente. id, versión, estado, subtipo y contactos los calcula la plataforma, el endpoint no los graba.",
        "output": "cliente con la ficha creada o reutilizada y ordenes con su historial (vacío si es nuevo), para redibujar la ficha sin otra llamada."
      }
    }
  ],
  "bindings": {
    "organisms": [
      {
        "organism": "buscarCliente",
        "reads": "buscarClientes.clientes"
      },
      {
        "organism": "fichaCliente",
        "reads": "obtenerFichaCliente.cliente"
      },
      {
        "organism": "fichaCliente",
        "reads": "obtenerFichaCliente.ordenes"
      }
    ],
    "commands": [
      {
        "endpoint": "registrarCliente",
        "refreshes": []
      }
    ],
    "selections": [
      {
        "organism": "buscarCliente",
        "via": {
          "query": "obtenerFichaCliente"
        }
      },
      {
        "organism": "registrarCliente",
        "via": {
          "query": "obtenerFichaCliente"
        }
      }
    ],
    "journeys": [
      {
        "step": "abrirOrdenServicio/buscarCliente",
        "organisms": [
          "buscarCliente",
          "fichaCliente"
        ],
        "endpoints": [
          "buscarClientes",
          "obtenerFichaCliente"
        ]
      },
      {
        "step": "abrirOrdenServicio/registrarCliente",
        "organisms": [
          "registrarCliente",
          "fichaCliente"
        ],
        "endpoints": [
          "registrarCliente"
        ]
      },
      {
        "step": "abrirOrdenServicio/crearOrden",
        "organisms": [
          "fichaCliente"
        ],
        "endpoints": [],
        "continuesIn": "ordenes_servicio"
      }
    ],
    "updates": [
      {
        "endpoint": "buscarClientes",
        "state": "buscarClientes.clientes",
        "mode": "replace"
      },
      {
        "endpoint": "registrarCliente",
        "state": "obtenerFichaCliente.cliente",
        "mode": "replace"
      },
      {
        "endpoint": "registrarCliente",
        "state": "obtenerFichaCliente.ordenes",
        "mode": "replace"
      }
    ]
  }
}
