  "endpoints": [
    {
      "id": "obtenerPendientesMisOrdenes",
      "kind": "qry",
      "when": "onLoad",
      "input": [],
      "output": [
        {
          "name": "presupuestosPendientes",
          "type": "OrdenResumen[]"
        },
        {
          "name": "disponiblesParaRetiro",
          "type": "OrdenResumen[]"
        }
      ],
      "rules": [
        "clienteVeSoloSusOrdenes",
        "clienteNoVeCostoInterno",
        "costoInternoOcultoAlCliente",
        "anotacionesTecnicoOcultasAlCliente",
        "disponibleParaRetiroCalculado"
      ],
      "jsdoc": {
        "purpose": "Carga al abrir la página lo que requiere la atención del cliente: los presupuestos que esperan su respuesta y los aparatos que ya puede retirar.",
        "input": "Sin parámetros: el cliente se resuelve desde la sesión del portal (locate.byLogin).",
        "processing": "Filtra las órdenes por clienteId del cliente conectado (clienteVeSoloSusOrdenes). Presupuestos pendientes: órdenes en estado presupuestada, ordenadas por fecha de emisión. Disponibles para retiro: órdenes cuyo disponibleParaRetiro, calculado en el momento como estado lista o rechazada (disponibleParaRetiroCalculado), es verdadero; nunca se almacena. No devuelve costoInternoPiezas, piezas ni anotacionesTecnico (clienteNoVeCostoInterno, costoInternoOcultoAlCliente, anotacionesTecnicoOcultasAlCliente).",
        "output": "Dos listas cortas de filas de orden con número, estado, aparato, valor y fecha del presupuesto, y la marca de disponible para retiro, listas para la sección de pendientes."
      }
    },
    {
      "id": "listarMisOrdenes",
      "kind": "qry",
      "when": "onLoad",
      "input": [
        {
          "name": "page",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        },
        {
          "name": "pageSize",
          "type": "number",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "ordenes",
          "type": "OrdenResumen[]",
          "paginated": true
        }
      ],
      "rules": [
        "clienteVeSoloSusOrdenes",
        "clienteNoVeCostoInterno",
        "costoInternoOcultoAlCliente",
        "anotacionesTecnicoOcultasAlCliente",
        "disponibleParaRetiroCalculado"
      ],
      "jsdoc": {
        "purpose": "Lista todas las órdenes de servicio del cliente conectado, paginadas, para consultar cualquiera de ellas.",
        "input": "page: número de página pedida; pageSize: cantidad de órdenes por página.",
        "processing": "Lista por clienteId del cliente de la sesión (listByForeignKey, clienteVeSoloSusOrdenes), ordenadas por fecha de apertura descendente. disponibleParaRetiro se calcula como estado lista o rechazada (disponibleParaRetiroCalculado). Excluye costos internos, piezas y anotaciones del técnico.",
        "output": "Página { items, page, pageSize, hasMore } de filas con número, aparato, fecha de apertura y estado; la página siguiente se agrega a la lista."
      }
    },
    {
      "id": "obtenerOrdenCliente",
      "kind": "qry",
      "when": "interaction",
      "input": [
        {
          "name": "ordenId",
          "type": "string",
          "origin": {
            "kind": "context",
            "paths": []
          }
        }
      ],
      "output": [
        {
          "name": "orden",
          "type": "OrdenDetalleCliente"
        }
      ],
      "rules": [
        "clienteVeSoloSusOrdenes",
        "clienteNoVeCostoInterno",
        "costoInternoOcultoAlCliente",
        "anotacionesTecnicoOcultasAlCliente",
        "disponibleParaRetiroCalculado"
      ],
      "jsdoc": {
        "purpose": "Abre la orden que el cliente elige en pendientes, retiro o su lista, con su detalle, presupuesto e historial en una sola llamada.",
        "input": "ordenId: id de la orden seleccionada (o recibido en el enlace de la notificación).",
        "processing": "Lee la orden por id y rechaza si su clienteId no es el del cliente conectado (clienteVeSoloSusOrdenes). Compone el nombre del cliente (read.byId de Cliente). Calcula disponibleParaRetiro como estado lista o rechazada (disponibleParaRetiroCalculado). Omite costoInternoPiezas, piezas y anotacionesTecnico (clienteNoVeCostoInterno, costoInternoOcultoAlCliente, anotacionesTecnicoOcultasAlCliente).",
        "output": "La orden con versión, estado, aparato, defecto, diagnóstico, presupuesto, fechas de respuesta, reparación y entrega: alimenta el detalle, la decisión y el historial."
      }
    },
    {
      "id": "aprobarPresupuesto",
      "kind": "cmd",
      "when": "aprobarPresupuesto",
      "writes": "OrdenServicio.aprobarPresupuesto",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdenServicio.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdenServicio.version"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "orden",
          "type": "OrdenDetalleCliente"
        }
      ],
      "rules": [
        "clienteSoloRespondeSusOrdenes",
        "clienteNoVeCostoInterno",
        "anotacionesTecnicoOcultasAlCliente"
      ],
      "jsdoc": {
        "purpose": "Aprueba el presupuesto de la orden para que el técnico la repare.",
        "input": "ordenId: orden a aprobar; version: versión leída, para control de concurrencia.",
        "processing": "Rechaza si la orden no pertenece al cliente conectado o no está presupuestada (clienteSoloRespondeSusOrdenes). Ejecuta la transición aprobarPresupuesto (presupuestada → aprobada) y registra la fecha de respuesta. Devuelve la orden sin costos internos ni anotaciones.",
        "output": "La orden actualizada en estado aprobada para redibujar detalle, decisión e historial sin otra llamada."
      }
    },
    {
      "id": "rechazarPresupuesto",
      "kind": "cmd",
      "when": "rechazarPresupuesto",
      "writes": "OrdenServicio.rechazarPresupuesto",
      "input": [
        {
          "name": "id",
          "type": "string",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdenServicio.id"
            ]
          }
        },
        {
          "name": "version",
          "type": "number",
          "origin": {
            "kind": "field",
            "paths": [
              "OrdenServicio.version"
            ]
          }
        },
        {
          "name": "details.presupuesto.motivoRechazo",
          "type": "string",
          "optional": true,
          "origin": {
            "kind": "field",
            "paths": [
              "OrdenServicio.details.presupuesto.motivoRechazo"
            ]
          }
        }
      ],
      "output": [
        {
          "name": "orden",
          "type": "OrdenDetalleCliente"
        }
      ],
      "rules": [
        "clienteSoloRespondeSusOrdenes",
        "rechazoCierraOrden",
        "disponibleParaRetiroCalculado",
        "clienteNoVeCostoInterno",
        "anotacionesTecnicoOcultasAlCliente"
      ],
      "jsdoc": {
        "purpose": "Rechaza el presupuesto de la orden, que se cierra y deja el aparato disponible para retiro.",
        "input": "ordenId: orden a rechazar; version: versión leída; motivoRechazo: comentario opcional del cliente.",
        "processing": "Rechaza si la orden no pertenece al cliente conectado o no está presupuestada (clienteSoloRespondeSusOrdenes). Ejecuta la transición rechazarPresupuesto (presupuestada → rechazada) con el motivo y la fecha de respuesta; la orden queda cerrada sin reparación (rechazoCierraOrden). disponibleParaRetiro se calcula al leer (disponibleParaRetiroCalculado), no se graba.",
        "output": "La orden actualizada en estado rechazada, con disponible para retiro verdadero, para redibujar detalle, decisión e historial."
      }
    }
  ],
  "bindings": {
