          "listarMisOrdenes"
        ]
      },
      {
        "endpoint": "rechazarPresupuesto",
        "refreshes": [
          "obtenerPendientesMisOrdenes",
          "listarMisOrdenes"
        ]
      }
    ],
    "selections": [
