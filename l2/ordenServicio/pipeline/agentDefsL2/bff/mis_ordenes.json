        "endpoint": "listarMisOrdenes",
        "state": "listarMisOrdenes.ordenes",
        "mode": "append"
      },
      {
        "endpoint": "obtenerOrdenCliente",
        "state": "obtenerOrdenCliente.orden",
        "mode": "replace"
      },
      {
        "endpoint": "aprobarPresupuesto",
        "state": "obtenerOrdenCliente.orden",
        "mode": "replace"
      },
      {
        "endpoint": "rechazarPresupuesto",
        "state": "obtenerOrdenCliente.orden",
        "mode": "replace"
      }
    ]
  }
