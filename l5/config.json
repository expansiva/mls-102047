          "navigation": [
            {
              "id": "inicio_membro",
              "label": "Início",
              "href": "/tarefas/inicio_membro",
              "description": "Ponto de partida do dia do membro da equipe: mostra quantas tarefas estão abertas, quantas vencem hoje e quantas estão atrasadas, destaca o aviso diário das 8h e reúne o que espera por ele — tarefas para iniciar, entregas para revisar e devoluções para ajustar — para agir sem procurar.",
              "actors": [
                "membroEquipe"
              ],
              "landing": true
            },
            {
              "id": "minhas_tarefas",
              "label": "Minhas tarefas",
              "href": "/tarefas/minhas_tarefas",
              "description": "Concentrar em um só lugar as tarefas que criei ou pelas quais sou responsável, para que eu acompanhe prazo, situação e checklist, execute, revise e mantenha cada tarefa sem sair da página.",
              "actors": [
                "membroEquipe"
              ]
            },
            {
              "id": "meus_avisos",
              "label": "Meus avisos de vencimento",
              "href": "/tarefas/meus_avisos",
              "description": "Permitir que eu consulte meus avisos diários das 8h, escolha um dia e veja quais tarefas abertas venciam naquele dia ou já estavam atrasadas, além de saber quando cada aviso foi gerado e finalizado.",
              "actors": [
                "membroEquipe",
                "gestor"
              ]
            },
            {
              "id": "inicio_gestor",
              "label": "Painel da equipe",
              "href": "/tarefas/inicio_gestor",
              "description": "Dar ao gestor uma visão rápida do andamento de todas as tarefas da equipe: quantas estão abertas em cada lista, quantas vencem hoje, quantas estão atrasadas e como estão as checklists.",
              "actors": [
                "gestor"
              ],
              "landing": true
            },
            {
              "id": "tarefas_equipe",
              "label": "Tarefas da equipe",
              "href": "/tarefas/tarefas_equipe",
              "description": "Dar ao gestor a visão do andamento de todas as tarefas da equipe, permitindo filtrar por lista, responsável, prioridade, prazo e situação, abrir uma tarefa para ver detalhe e histórico e, quando necessário, trocar o responsável ou cancelar a tarefa.",
              "actors": [
                "gestor"
              ]
            },
            {
              "id": "listas",
              "label": "Listas",
              "href": "/tarefas/listas",
